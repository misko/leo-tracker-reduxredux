# Copy to /etc/leo/leo.env, set ownership root:leo and mode 0640.
# This file contains configuration only. Do not put database passwords here;
# use local peer authentication or a separately managed PostgreSQL credential.

LEO_BULK_ROOT=/srv/bulk/leo
LEO_PROFILE_ROOT=/opt/leo-tracker/current/profiles
LEO_WEB_DIST=/opt/leo-tracker/current/web/dist
LEO_CORPUS_ROOT=/srv/bulk/leo/test-corpus
LEO_DATABASE_URL=postgresql+psycopg:///leo_tracker
LEO_QUALIFICATION_ROOT=/srv/bulk/leo/qualification
LEO_CAPTURE_EVIDENCE_ROOT=/srv/bulk/leo/qualification/capture
LEO_LEGACY_EVIDENCE_ROOT=/srv/bulk/leo/qualification/legacy
LEO_STATION_AUTHORITY_ROOT=/etc/leo/station-authority
LEO_STATION_TOPOLOGY_RELATIVE_PATH=gauss-four-path-postreboot-20260816-v1.json
LEO_STATION_TOPOLOGY_FILE_DIGEST=sha256:5ec14f15bfe2a6abc52024f41db29b4ab6123209e6c4779a47644b1e70c477ae
LEO_FIXTURE_PATH_AUTHORITIES_JSON=[]

# A separate database is mandatory for protected-corpus and browser qualification.
# The lane creates and drops unique schemas here and refuses the production name.
LEO_QUALIFICATION_DATABASE_URL=postgresql+psycopg:///leo_qualification
LEO_QUALIFICATION_CORPUS_ROOT=/srv/bulk/leo/test-corpus
LEO_RELEASE_QUALIFICATION_ROOT=/srv/bulk/leo/qualification/release
PLAYWRIGHT_BROWSERS_PATH=/var/lib/leo/.cache/ms-playwright

LEO_RADIO_BACKEND=pluto
# Frozen station identities used by the WP11 capture/calibration contracts.
LEO_RADIOS_JSON='[{"radio_id":"radio_pluto_5d4d","serial":"1040005e0b100007100010000bf33a5d4d","host":"192.168.1.20","receiver_count":2},{"radio_id":"radio_pluto_19f2","serial":"10400056f695001322002d0010ad1719f2","host":"192.168.1.21","receiver_count":2}]'
LEO_CAPTURE_PROFILE=starlink-ch4-lower-2p5m-60s
# The profile captures for 60 seconds, then acquisition idles for 120 seconds:
# one ordinary dwell approximately every 300 seconds without a long campaign.
LEO_CAPTURE_INTERVAL_SECONDS=180
LEO_ACQUISITION_RESERVE_BYTES=8589934592

# The acquisition supervisor schedules the scanner on radio .20. Its shared
# capture authority prevents scanner and ordinary captures from overlapping.
LEO_SCANNER_ENABLED=true
LEO_SCANNER_RADIO_ID=radio_pluto_5d4d
LEO_SCANNER_INTERVAL_SECONDS=180
LEO_SCANNER_MAXIMUM_LATENESS_SECONDS=180
LEO_SCANNER_DWELL_MS=120
LEO_SCANNER_GAIN_DB=40.0
LEO_SCANNER_MARGIN_GATE=0.025
LEO_SCANNER_REPORT_ROOT=/srv/bulk/leo/scanner-reports

# Replace with a new immutable ID tied to the staged revision. Never reuse an
# existing catalog release ID after its graph/source/configuration changes.
LEO_PIPELINE_RELEASE_ID=REPLACE-PIPELINE-RELEASE-ID
LEO_WORKER_POLL_SECONDS=15.0

# leo-api intentionally binds open HTTP on all LAN interfaces.
LEO_API_PORT=8090

# Qualification is disabled by default by /etc/leo/qualification-enabled.
LEO_QUALIFICATION_PROFILE=starlink-ch4-lower-2p5m-60s-rx1-centered-v1
LEO_QUALIFICATION_TRIALS=100
LEO_QUALIFICATION_RECEIPT=/srv/bulk/leo/qualification/acquisition/nightly.json

# The 24-hour soak is separately and manually gated by /etc/leo/soak-enabled.
# Change the ID for each new qualification; retain it only when resuming that run.
LEO_SOAK_PROFILE=starlink-ch4-lower-2p5m-60s
LEO_SOAK_DURATION_SECONDS=86400
LEO_SOAK_CADENCE_SECONDS=0
LEO_SOAK_ID=production-24h-REPLACE-DATE
LEO_SOAK_OUTPUT_ROOT=/srv/bulk/leo/qualification/soak
