# Optional acquisition-only overrides. Installed after the common leo.env.
# Use the exact selected acquisition commit; do not change worker release identity.
LEO_PROFILE_ROOT=/opt/leo-tracker/current-acquisition/profiles
LEO_ACQUISITION_RELEASE_ID=REPLACE_WITH_SELECTED_ACQUISITION_SHA
# The qualified scanner rollout enables the scheduler only for acquisition.
# Keep the common environment's fail-safe default disabled so other components
# cannot acquire scanner authority accidentally.
LEO_SCANNER_ENABLED=true
# Production runs bounded scanner-only invocations; systemd restarts them to
# wait for the next durable 20-minute slot. Ordinary dwell jobs stay unclaimed.
LEO_SCANNER_RADIO_ID=radio_pluto_19f2
LEO_RADIOS_JSON=[{"radio_id":"radio_pluto_19f2","serial":"10400056f695001322002d0010ad1719f2","host":"192.168.1.21","receiver_count":2}]
# This must name the sealed ARM binary inside that exact immutable release.
# It is uploaded only to volatile radio storage by the acquisition-owned lifecycle.
LEO_SCANNER_PERSISTENT_IIOD_BINARY_PATH=/opt/leo-tracker/releases/REPLACE_WITH_SELECTED_ACQUISITION_SHA/runtime/scanner-iiod/iiod
# Qualified adaptive rollout: select runtime/scanner-glrt/iiod and bundle.json,
# configure the exact GLRT algorithm/configuration identities, then set
# LEO_SCANNER_GLRT_MODE=positive-only-v1
# LEO_SCANNER_HOP_POLICY=adaptive
# LEO_SCANNER_ADAPTIVE_SAMPLE_RATES_HZ=2500000
# This preserves the 50/50 rate cadence; 5 MS/s continues fixed-order hopping.
# Install the adaptive IQ, classification and analysis namespaces before RF;
# see docs/operations/production-deployment.md. Never make the bulk root writable
# merely to let a service create its own namespace.
LEO_DDR_RING_MAX_RATE_HZ=0
