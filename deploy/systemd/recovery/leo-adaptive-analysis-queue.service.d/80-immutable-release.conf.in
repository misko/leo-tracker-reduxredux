[Service]
WorkingDirectory=/opt/leo-tracker/releases/@RELEASE@
ExecStart=
ExecStart=/usr/bin/env PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 /opt/leo-tracker/releases/@RELEASE@/.venv/bin/python -m leo.cli.adaptive_processing_queue --bulk-root /srv/bulk/leo enqueue
