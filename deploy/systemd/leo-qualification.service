[Unit]
Description=LEO Tracker scheduled real-radio acquisition qualification
After=network-online.target local-fs.target postgresql.service
ConditionPathExists=/etc/leo/qualification-enabled
Conflicts=leo-acquisition.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=oneshot
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker
EnvironmentFile=/etc/leo/leo.env
Environment=PATH=/opt/leo-tracker/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/env leo acquire qualify --profile ${LEO_QUALIFICATION_PROFILE} --trials ${LEO_QUALIFICATION_TRIALS} --receipt ${LEO_QUALIFICATION_RECEIPT} --resume --json
TimeoutStartSec=24h
Nice=0
CPUWeight=500
IOWeight=500
IOSchedulingClass=best-effort
IOSchedulingPriority=2
OOMScoreAdjust=0
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/bulk/leo
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
