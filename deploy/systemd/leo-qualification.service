[Unit]
Description=LEO Tracker scheduled real-radio acquisition qualification
After=network-online.target local-fs.target postgresql.service
ConditionPathExists=/etc/leo/qualification-enabled
Conflicts=leo-acquisition.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=oneshot
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker/current
EnvironmentFile=/etc/leo/leo.env
ExecStart=/usr/bin/env PYTHONDONTWRITEBYTECODE=1 /opt/leo-tracker/current/.venv/bin/leo acquire qualify --profile ${LEO_QUALIFICATION_PROFILE} --trials ${LEO_QUALIFICATION_TRIALS} --receipt ${LEO_QUALIFICATION_RECEIPT} --resume --json
TimeoutStartSec=24h
Nice=0
CPUWeight=500
IOWeight=500
IOSchedulingClass=best-effort
IOSchedulingPriority=2
OOMScoreAdjust=400
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/bulk/leo
InaccessiblePaths=/mnt/qnap01
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
