[Unit]
Description=LEO adaptive scanner analysis queue worker %i
After=network-online.target local-fs.target postgresql.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=simple
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker/current-worker
EnvironmentFile=/etc/leo/leo.env
Environment=MPLCONFIGDIR=/srv/bulk/leo/presentation-cache/matplotlib
ExecStartPre=+/usr/bin/install -d -o leo -g leo -m 0750 /srv/bulk/leo/scanner-shared-tracking-v4
ExecStart=/usr/bin/env PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 /opt/leo-tracker/current-worker/.venv/bin/python -m leo.cli.adaptive_processing_queue --bulk-root /srv/bulk/leo worker --worker-id adaptive-worker-%i
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
Nice=10
CPUWeight=100
IOWeight=100
IOSchedulingClass=idle
OOMScoreAdjust=500
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/bulk/leo
InaccessiblePaths=/mnt/qnap01
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
