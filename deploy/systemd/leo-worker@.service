[Unit]
Description=LEO Tracker processing worker %i
Wants=network-online.target
After=network-online.target local-fs.target postgresql.service leo-reconcile.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=simple
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker
EnvironmentFile=/etc/leo/leo.env
Environment=PATH=/opt/leo-tracker/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/env leo process worker --worker-id worker-%i --poll-seconds ${LEO_WORKER_POLL_SECONDS}
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=60s
Nice=10
CPUWeight=100
IOWeight=100
IOSchedulingClass=idle
OOMScoreAdjust=250
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/bulk/leo
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
