[Unit]
Description=LEO Tracker Pluto+ acquisition and scanner supervisor
Wants=network-online.target
After=network-online.target local-fs.target postgresql.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=simple
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker/current-acquisition
EnvironmentFile=/etc/leo/leo.env
LoadCredential=scanner-iiod-ssh-known-hosts:/etc/leo/credentials/scanner-iiod-ssh-known-hosts
LoadCredential=scanner-iiod-ssh-password:/etc/leo/credentials/scanner-iiod-ssh-password
ExecStart=/usr/bin/env PYTHONDONTWRITEBYTECODE=1 /opt/leo-tracker/current-acquisition/.venv/bin/leo acquire run --profile ${LEO_CAPTURE_PROFILE} --radio ${LEO_SCANNER_RADIO_ID} --interval-seconds ${LEO_SCANNER_INTERVAL_SECONDS} --scanner-only --max-scanner-runs 1
# Durable cadence de-duplication prevents recapture after a successful restart.
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=90s
SuccessExitStatus=130
Nice=-5
CPUWeight=1000
IOWeight=1000
IOSchedulingClass=best-effort
IOSchedulingPriority=0
OOMScoreAdjust=200
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/bulk/leo
InaccessiblePaths=/mnt/qnap01
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
