[Unit]
Description=LEO Tracker Pluto+ acquisition and scanner supervisor
Wants=network-online.target
After=network-online.target local-fs.target postgresql.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=simple
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker/current
EnvironmentFile=/etc/leo/leo.env
ExecStart=/usr/bin/env /opt/leo-tracker/current/.venv/bin/leo acquire run --profile ${LEO_CAPTURE_PROFILE} --interval-seconds ${LEO_CAPTURE_INTERVAL_SECONDS}
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=90s
SuccessExitStatus=130
Nice=-5
CPUWeight=1000
IOWeight=1000
IOSchedulingClass=best-effort
IOSchedulingPriority=0
OOMScoreAdjust=200
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/bulk/leo
InaccessiblePaths=/mnt/qnap01
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
