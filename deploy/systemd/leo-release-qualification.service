[Unit]
Description=LEO Tracker isolated protected-corpus and Chromium qualification
After=network-online.target local-fs.target postgresql.service
ConditionPathExists=/etc/leo/release-qualification-enabled
RequiresMountsFor=/srv/bulk/leo/test-corpus /srv/bulk/leo/qualification/release

[Service]
Type=oneshot
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker/current
EnvironmentFile=/etc/leo/leo.env
Environment=PATH=/opt/leo-tracker/current/.release-tools:/opt/leo-tracker/current/.venv/bin:/opt/leo-tracker/current/web/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/leo/.cache/ms-playwright
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=/opt/leo-tracker/current
ExecStartPre=/usr/bin/env /opt/leo-tracker/current/deploy/scripts/validate-current-release /opt/leo-tracker/current
ExecStart=/usr/bin/env PYTHONDONTWRITEBYTECODE=1 /opt/leo-tracker/current/.venv/bin/leo-release-qualify --project-root /opt/leo-tracker/current
TimeoutStartSec=8h
Nice=15
CPUWeight=50
IOWeight=50
IOSchedulingClass=idle
OOMScoreAdjust=500
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/bulk/leo/test-corpus
ReadWritePaths=/srv/bulk/leo/qualification/release
InaccessiblePaths=/mnt/qnap01
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
