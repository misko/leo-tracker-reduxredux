[Unit]
Description=LEO Tracker hold-aware retention pass
After=local-fs.target postgresql.service
ConditionPathExists=/etc/leo/retention-enabled
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=oneshot
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker/current
EnvironmentFile=/etc/leo/leo.env
ExecStart=/usr/bin/env /opt/leo-tracker/current/.venv/bin/leo process retention-run --execute --automatic --json
TimeoutStartSec=30min
Nice=15
CPUWeight=25
IOWeight=25
IOSchedulingClass=idle
OOMScoreAdjust=500
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/bulk/leo
InaccessiblePaths=/mnt/qnap01
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
