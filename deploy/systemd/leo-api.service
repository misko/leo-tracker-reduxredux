[Unit]
Description=LEO Tracker read-only LAN API and web UI
Wants=network-online.target
After=network-online.target local-fs.target postgresql.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=simple
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker/current
EnvironmentFile=/etc/leo/leo.env
Environment=MPLCONFIGDIR=/srv/bulk/leo/presentation-cache/matplotlib
ExecStart=/usr/bin/env /opt/leo-tracker/current/.venv/bin/leo-api
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
Nice=5
CPUWeight=200
IOWeight=200
OOMScoreAdjust=400
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/bulk/leo
ReadWritePaths=/srv/bulk/leo/presentation-cache
InaccessiblePaths=/mnt/qnap01
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
