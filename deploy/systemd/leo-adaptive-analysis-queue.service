[Unit]
Description=Enqueue published adaptive scanner analyses in shared processing queue
After=local-fs.target postgresql.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=oneshot
User=leo
Group=leo
WorkingDirectory=/opt/leo-tracker/current-worker
EnvironmentFile=/etc/leo/leo.env
ExecStart=/usr/bin/env PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 /opt/leo-tracker/current-worker/.venv/bin/python -m leo.cli.adaptive_processing_queue --bulk-root /srv/bulk/leo enqueue
Nice=15
CPUWeight=25
IOWeight=25
IOSchedulingClass=idle
OOMScoreAdjust=500
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/bulk/leo
InaccessiblePaths=/mnt/qnap01
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
