#!/usr/bin/env bash
# Build one immutable production release. This script never touches the data
# plane, systemd, PostgreSQL, or the active-release symlink.
set -euo pipefail

usage() {
  echo "usage: sudo $0 --source ABSOLUTE_GIT_DIR --revision FULL_40_HEX_SHA --python-bin ABSOLUTE_VERSIONED_SYSTEM_PYTHON [--uv-bin ABSOLUTE_UV] [--execute]" >&2
  exit 64
}

source_dir=
revision=
execute=false
uv_bin=
python_bin=
while (($#)); do
  case "$1" in
    --source) source_dir=${2-}; shift 2 ;;
    --revision) revision=${2-}; shift 2 ;;
    --uv-bin) uv_bin=${2-}; shift 2 ;;
    --python-bin) python_bin=${2-}; shift 2 ;;
    --execute) execute=true; shift ;;
    *) usage ;;
  esac
done

[[ -n "$source_dir" && -n "$revision" && -n "$python_bin" ]] || usage
[[ "$source_dir" = /* ]] || { echo "--source must be absolute" >&2; exit 64; }
[[ "$python_bin" = /* ]] || { echo "--python-bin must be absolute" >&2; exit 64; }
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || { echo "revision must be a full lowercase commit SHA" >&2; exit 64; }
if [[ -z "$uv_bin" ]]; then
  uv_bin=$(command -v uv || true)
fi
[[ "$uv_bin" = /* ]] || {
  echo "uv was not found; pass its absolute executable path with --uv-bin" >&2
  exit 69
}
case "$source_dir/" in
  /mnt/qnap01/*) echo "QNAP cannot be a deployment source" >&2; exit 65 ;;
esac
case "$uv_bin/" in
  /mnt/qnap01/*) echo "QNAP cannot supply deployment tooling" >&2; exit 65 ;;
esac
case "$python_bin/" in
  /mnt/qnap01/*) echo "QNAP cannot supply the system Python" >&2; exit 65 ;;
esac

reject_symlink_components() {
  inspected=$1
  while [[ "$inspected" != / ]]; do
    [[ ! -L "$inspected" ]] || {
      echo "deployment input contains a symlink component: $inspected" >&2
      exit 65
    }
    inspected=$(dirname -- "$inspected")
  done
}
reject_symlink_components "$source_dir"
reject_symlink_components "$uv_bin"
reject_symlink_components "$python_bin"

source_real=$(realpath -m -- "$source_dir")
case "$source_real/" in
  /mnt/qnap01/*) echo "QNAP cannot be a deployment source" >&2; exit 65 ;;
esac
[[ -d "$source_real" ]] || { echo "deployment source does not exist" >&2; exit 66; }
uv_bin_real=$(realpath -e -- "$uv_bin")
case "$uv_bin_real/" in
  /mnt/qnap01/*) echo "QNAP cannot supply deployment tooling" >&2; exit 65 ;;
esac
[[ -f "$uv_bin_real" && -x "$uv_bin_real" && ! -L "$uv_bin_real" ]] || {
  echo "resolved uv tooling must be a regular executable" >&2
  exit 69
}
uv_bin=$uv_bin_real
python_bin_real=$(realpath -e -- "$python_bin")
[[ "$python_bin_real" = "$python_bin" \
  && "$python_bin_real" =~ ^/usr/bin/python3\.(12|13|14)$ \
  && -f "$python_bin_real" && -x "$python_bin_real" && ! -L "$python_bin_real" \
  && $(stat -c %u -- "$python_bin_real") = 0 \
  && $((8#$(stat -c %a -- "$python_bin_real") & 0022)) = 0 ]] || {
  echo "--python-bin must be a versioned, root-owned immutable /usr/bin interpreter" >&2
  exit 69
}
if ! python_version=$("$python_bin_real" -I -S -c \
  'import sys; assert sys.version_info >= (3, 12); print(f"{sys.version_info.major}.{sys.version_info.minor}")'); then
  echo "--python-bin must execute successfully as Python >=3.12" >&2
  exit 69
fi
[[ "$python_bin_real" = "/usr/bin/python$python_version" ]] || {
  echo "--python-bin name and observed major.minor version disagree" >&2
  exit 69
}
python_bin=$python_bin_real
if ! resolved=$(git -C "$source_real" rev-parse --verify "$revision^{commit}"); then
  echo "revision cannot be resolved in deployment source" >&2
  exit 65
fi
[[ "$resolved" = "$revision" ]] || { echo "revision does not resolve exactly" >&2; exit 65; }

release_root=/opt/leo-tracker/releases
release_dir=$release_root/$revision
staging_dir=$release_root/.staging-$revision
metadata=/opt/leo-tracker/release-metadata/$revision.txt
metadata_temp=
current_link=/opt/leo-tracker/current
script_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
release_uv=$release_dir/.release-tools/uv
metadata_abi=1
metadata_runtime_receipt=$release_dir/.venv/share/pluto-plus-utils/metadata-runtime.json

if ! $execute; then
  printf 'Validated immutable source revision %s\n' "$revision"
  printf 'Would stage %s at %s without changing services, data, or PostgreSQL.\n' \
    "$source_real" "$release_dir"
  printf 'Would seal uv from %s inside the immutable release.\n' "$uv_bin"
  printf 'Would build with reviewed system Python %s (%s).\n' \
    "$python_bin" "$python_version"
  printf 'Re-run with --execute as root to perform the stage.\n'
  exit 0
fi

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "--execute requires root" >&2; exit 77; }
assert_root_directory() {
  directory=$1
  [[ -d "$directory" && ! -L "$directory" ]] || {
    echo "deployment parent must be a real directory: $directory" >&2
    exit 65
  }
  [[ $(stat -c %u -- "$directory") = 0 ]] || {
    echo "deployment parent must be root-owned: $directory" >&2
    exit 65
  }
  directory_mode=$(stat -c %a -- "$directory")
  (( (8#$directory_mode & 0022) == 0 )) || {
    echo "deployment parent must not be group/other writable: $directory" >&2
    exit 65
  }
}

assert_root_directory /opt
install -d -o root -g root -m 0755 /opt/leo-tracker
assert_root_directory /opt/leo-tracker
lock_path=/opt/leo-tracker/.stage-production-release.lock
if [[ ! -e "$lock_path" && ! -L "$lock_path" ]]; then
  install -o root -g root -m 0600 /dev/null "$lock_path"
fi
[[ -f "$lock_path" && ! -L "$lock_path" \
  && $(stat -c %u:%g:%a -- "$lock_path") = 0:0:600 ]] || {
  echo "publication lock is not a root-owned 0600 regular file" >&2
  exit 65
}
exec 9<>"$lock_path"
if ! flock -n 9; then
  echo "another production release stage holds the publication lock" >&2
  exit 75
fi
[[ ! -L "$staging_dir" && ! -e "$staging_dir" ]] || {
  echo "staging path already exists: $staging_dir" >&2
  exit 73
}
if ! getent passwd leo >/dev/null; then
  useradd --system --home-dir /var/lib/leo --create-home --shell /usr/sbin/nologin leo
fi
leo_home=$(getent passwd leo | cut -d: -f6)
leo_shell=$(getent passwd leo | cut -d: -f7)
[[ "$leo_home" = /var/lib/leo && "$leo_shell" = /usr/sbin/nologin ]] || {
  echo "existing leo account has unexpected home or shell" >&2
  exit 65
}
if [[ -L "$release_dir" ]]; then
  echo "existing release path must not be a symlink" >&2
  exit 73
fi
if [[ -e "$release_dir" ]]; then
  [[ ! -e "$release_dir/.leo-release-incomplete" ]] || {
    echo "existing release is an orphaned incomplete build" >&2
    exit 73
  }
  [[ ! -L "$metadata" && -f "$metadata" ]] \
    && grep -Fxq "revision=$revision" "$metadata" || {
    echo "existing release lacks matching immutable metadata" >&2
    exit 73
  }
  checker=$release_dir/deploy/scripts/check-staged-release
  validator=$release_dir/deploy/scripts/validate-published-release
  [[ -x "$checker" && -x "$validator" ]] || {
    echo "existing release predates final-path runtime validation" >&2
    exit 73
  }
  "$checker" "$release_dir" "$revision"
  "$release_dir/deploy/scripts/validate-release-metadata" \
    "$release_dir" "$metadata" "$revision"
  runuser -u leo -- "$release_dir/.venv/bin/python" "$validator" \
    "$release_dir" "$staging_dir"
  echo "release already staged and verified: $release_dir"
  exit 0
fi
[[ ! -L "$metadata" && ! -e "$metadata" ]] || {
  echo "orphan release metadata exists without its release" >&2
  exit 73
}
install -d -o root -g leo -m 0755 /opt/leo-tracker "$release_root"
install -d -o root -g leo -m 0755 /opt/leo-tracker/release-metadata
assert_root_directory /opt/leo-tracker
assert_root_directory "$release_root"
assert_root_directory /opt/leo-tracker/release-metadata
"$script_root/prepare-leo-cache"

materialized=false
staging_owned=false
cleanup() {
  exit_code=$?
  trap - EXIT
  if $staging_owned && [[ -d "$staging_dir" ]]; then
    rm -rf --one-file-system -- "$staging_dir"
  fi
  if $materialized; then
    if [[ ! -e "$metadata" && -d "$release_dir" \
      && ! -e "$release_dir/.leo-release-incomplete" ]]; then
      install -o root -g leo -m 0440 /dev/null \
        "$release_dir/.leo-release-incomplete"
    fi
    if ! "$script_root/remove-unpublished-release" \
      "$release_dir" "$metadata" "$current_link" "$revision"; then
      echo "unpublished release cleanup was refused; preserve it for operator review" >&2
    fi
    if [[ -e "$metadata" && -d "$release_dir" ]]; then
      install -o root -g leo -m 0440 /dev/null \
        "$release_dir/.leo-release-validation-failed"
    fi
  fi
  if [[ -n "$metadata_temp" && -f "$metadata_temp" && ! -L "$metadata_temp" ]]; then
    rm -f -- "$metadata_temp"
  fi
  exit "$exit_code"
}
trap cleanup EXIT

staging_owned=true
git clone --no-local --no-hardlinks --quiet "$source_real" "$staging_dir"
git -C "$staging_dir" checkout --quiet --detach "$revision"
"$staging_dir/deploy/scripts/check-staged-release" "$staging_dir" "$revision"
chown -R leo:leo "$staging_dir"
chmod -R o-rwx "$staging_dir"
install -o root -g leo -m 0440 /dev/null "$staging_dir/.leo-release-incomplete"
mv -- "$staging_dir" "$release_dir"
staging_owned=false
materialized=true
install -d -o root -g leo -m 0750 "$release_dir/.release-tools"
install -o root -g leo -m 0550 "$uv_bin" "$release_uv"

runuser -u leo -- env HOME=/var/lib/leo UV_CACHE_DIR=/var/lib/leo/.cache/uv \
  "$release_uv" --directory "$release_dir" sync --frozen \
    --python "$python_bin" --extra hardware --no-editable
runuser -u leo -- env HOME=/var/lib/leo UV_CACHE_DIR=/var/lib/leo/.cache/uv \
  "$release_dir/.venv/bin/pluto-install-metadata-runtime" \
    --uv-bin "$release_uv" \
    --metadata-abi "$metadata_abi" \
    --python "$release_dir/.venv/bin/python" \
    --prefix "$release_dir/.venv"
runuser -u leo -- env HOME=/var/lib/leo \
  npm --prefix "$release_dir/web" ci
runuser -u leo -- env HOME=/var/lib/leo \
  PLAYWRIGHT_BROWSERS_PATH=/var/lib/leo/.cache/ms-playwright \
  "$release_dir/web/node_modules/.bin/playwright" install chromium
runuser -u leo -- env HOME=/var/lib/leo \
  npm --prefix "$release_dir/web" run build
test -f "$release_dir/web/dist/index.html"

# Seal a complete checked-hash bytecode inventory after the final Python
# installer has finished. Ordinary read-only release probes can then reuse
# these files instead of creating new executable entries in the immutable tree.
runuser -u leo -- "$release_dir/.venv/bin/python" -m compileall \
  -q -f --invalidation-mode checked-hash \
  "$release_dir/.venv/lib/python$python_version/site-packages"

runuser -u leo -- "$release_dir/deploy/scripts/check-staged-release" \
  "$release_dir" "$revision"
chown -R root:leo "$release_dir"
chmod -R go-w "$release_dir"
runuser -u leo -- "$release_dir/.venv/bin/python" \
  "$release_dir/deploy/scripts/validate-published-release" \
  "$release_dir" "$staging_dir"

umask 0027
metadata_temp=$(mktemp \
  --tmpdir=/opt/leo-tracker/release-metadata ".$revision.XXXXXXXX.tmp")
if ! metadata_runtime_path_text=$(PYTHONDONTWRITEBYTECODE=1 \
  "$release_dir/.venv/bin/python" - "$release_dir" "$metadata_runtime_receipt" <<'PY'
import json
import sys
from pathlib import Path

release = Path(sys.argv[1]).resolve(strict=True)
venv = (release / ".venv").resolve(strict=True)
receipt = Path(sys.argv[2]).resolve(strict=True)
if receipt != venv / "share/pluto-plus-utils/metadata-runtime.json":
    raise SystemExit("metadata runtime receipt is not at its canonical release path")
document = json.loads(receipt.read_text(encoding="utf-8"))
paths = [receipt]
for key in ("native_libiio_path", "pylibiio_path"):
    value = document.get(key)
    if not isinstance(value, str):
        raise SystemExit(f"metadata runtime receipt lacks {key}")
    path = Path(value).resolve(strict=True)
    if not path.is_file() or not path.is_relative_to(venv):
        raise SystemExit(f"metadata runtime {key} is not release-local")
    paths.append(path)
print(*(str(path) for path in paths), sep="\n")
PY
); then
  echo "metadata runtime inventory could not be resolved" >&2
  exit 65
fi
mapfile -t metadata_runtime_paths <<<"$metadata_runtime_path_text"
[[ ${#metadata_runtime_paths[@]} -eq 3 ]] || {
  echo "metadata runtime inventory has unexpected cardinality" >&2
  exit 65
}
{
  printf 'revision=%s\n' "$revision"
  printf 'python=%s\n' "$python_bin"
  printf 'python_version=%s\n' "$python_version"
  sha256sum "$python_bin" "$release_uv" "$release_dir/uv.lock" \
    "$release_dir/web/package-lock.json" "${metadata_runtime_paths[@]}"
} >"$metadata_temp"
chown root:leo "$metadata_temp"
chmod 0440 "$metadata_temp"
"$release_dir/deploy/scripts/validate-release-metadata" \
  "$release_dir" "$metadata_temp" "$revision" --allow-incomplete
rm -f -- "$release_dir/.leo-release-incomplete"
PYTHONDONTWRITEBYTECODE=1 "$release_dir/.venv/bin/python" - "$release_dir" <<'PY'
import os
import sys

descriptor = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY
mv -- "$metadata_temp" "$metadata"
metadata_temp=
PYTHONDONTWRITEBYTECODE=1 "$release_dir/.venv/bin/python" - /opt/leo-tracker/release-metadata <<'PY'
import os
import sys

descriptor = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY
materialized=false
trap - EXIT
echo "staged immutable release: $release_dir"
