#!/usr/bin/env python3
"""Deployment inventory for the pinned native host detector; no RF or native load."""

import argparse
import grp
import hashlib
import json
import os
import stat
from pathlib import Path

MANIFEST_SHA256 = "09bd961a759bad59d773243a25841a4250f345c6a9c66eb7c0c4afc3e68e1fcf"
NAMES = ("manifest.json", "decision.so", "build.json", "qualification-seal.json")


def inventory(release, *, staged=False, expected_uid=0, expected_gid=None):
    root = release / "runtime/scanner-host-decision"
    if not root.exists() and not root.is_symlink():
        return ()
    gid = grp.getgrnam("leo").gr_gid if expected_gid is None else expected_gid
    if root.is_symlink() or not root.is_dir() or set(p.name for p in root.iterdir()) != set(NAMES):
        raise ValueError("host detector bundle inventory differs")
    payloads = {}
    for name in NAMES:
        path = root / name
        with path.open("rb") as stream:
            info = os.fstat(stream.fileno())
            if (
                path.is_symlink()
                or not stat.S_ISREG(info.st_mode)
                or info.st_nlink != 1
                or info.st_uid != expected_uid
                or info.st_gid != gid
                or stat.S_IMODE(info.st_mode) & 0o022
                or (not staged and stat.S_IMODE(info.st_mode) != 0o440)
                or not 0 < info.st_size <= 16 * 1024 * 1024
            ):
                raise ValueError("host detector file ownership, size or mode differs")
            payloads[name] = stream.read(16 * 1024 * 1024 + 1)
    if hashlib.sha256(payloads["manifest.json"]).hexdigest() != MANIFEST_SHA256:
        raise ValueError("host detector manifest differs from the pinned artifact")
    manifest = json.loads(payloads["manifest.json"])
    for name in NAMES[1:]:
        if "sha256:" + hashlib.sha256(payloads[name]).hexdigest() != manifest["files"][name]:
            raise ValueError("host detector payload digest differs")
    return tuple(root / name for name in NAMES)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("release", type=Path)
    parser.add_argument("--staged", action="store_true")
    args = parser.parse_args()
    print(*(str(path) for path in inventory(args.release, staged=args.staged)), sep="\n")
