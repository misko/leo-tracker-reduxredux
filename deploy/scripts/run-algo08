#!/bin/sh
set -eu
release=$(dirname "$(readlink -f "$0")")
export PYTHONPATH="$release/src:$release"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
cd "$release"
if [ -n "${ALGO08_EVALUATION_LATITUDE:-}${ALGO08_EVALUATION_LONGITUDE:-}" ]; then
    set -- --evaluation-reference "${ALGO08_EVALUATION_LATITUDE:?}" "${ALGO08_EVALUATION_LONGITUDE:?}" "$@"
fi
exec "$release/venv/bin/python" -Bs -m tools.algo08_scan --assets "$release/assets" \
    --archive /var/lib/leo/tle "$@"
