#!/usr/bin/env bash
# Verify the exact, Git-free source identity emitted by stage-production-release.
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 ABSOLUTE_RELEASE_DIR FULL_40_HEX_SHA" >&2
  exit 64
fi

release_dir=$1
revision=$2
[[ "$release_dir" = /* ]] || { echo "release directory must be absolute" >&2; exit 64; }
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || {
  echo "revision must be a full lowercase commit SHA" >&2
  exit 64
}
case "$release_dir/" in
  /mnt/qnap01/*) echo "QNAP cannot contain a staged release" >&2; exit 65 ;;
esac

release_real=$(realpath -m -- "$release_dir")
case "$release_real/" in
  /mnt/qnap01/*) echo "QNAP cannot contain a staged release" >&2; exit 65 ;;
esac
[[ -d "$release_real" ]] || { echo "release directory does not exist" >&2; exit 66; }

source_identity=$release_real/.leo-release-source.json
[[ -f "$source_identity" && ! -L "$source_identity" ]] || {
  echo "staged release source identity is absent or not a regular file" >&2
  exit 65
}
if [[ -e "$release_real/.git" || -L "$release_real/.git" ]]; then
  echo "staged release unexpectedly contains Git metadata" >&2
  exit 65
fi
if [[ -e "$release_real/reports" || -L "$release_real/reports" ]]; then
  echo "staged release unexpectedly contains historical reports" >&2
  exit 65
fi

if ! source_document=$(<"$source_identity"); then
  echo "cannot read staged release source identity" >&2
  exit 65
fi
source_pattern='^\{"schema":"org\.leo\.release-source/v1","revision":"([0-9a-f]{40})","tree":"([0-9a-f]{40})"\}$'
if [[ ! "$source_document" =~ $source_pattern ]]; then
  echo "staged release source identity is not canonical V1 JSON" >&2
  exit 65
fi
observed_revision=${BASH_REMATCH[1]}
observed_tree=${BASH_REMATCH[2]}
[[ "$observed_revision" = "$revision" ]] || {
  echo "staged release source identity does not match requested revision" >&2
  exit 65
}

printf 'verified staged release source revision=%s tree=%s at %s\n' \
  "$revision" "$observed_tree" "$release_real"
