#!/usr/bin/env python3
"""Read-only fail-closed verifier for the initial system-service cutover."""

from __future__ import annotations

import argparse
import grp
import hashlib
import json
import os
import pwd
import re
import stat
import subprocess
import sys
from pathlib import Path
from typing import Any

QNAP = Path("/mnt/qnap01")
RELEASE_ROOT = Path("/opt/leo-tracker/releases")
ENVIRONMENT = Path("/etc/leo/leo.env")
UNIT_SOURCE = Path("/opt/leo-tracker/current/deploy/systemd")
ALLOWED_LEGACY_ACTIVE_UNITS = frozenset({"leo-forward-v2-postgresql.service"})
STATION_AUTHORITY_ROOT = Path("/etc/leo/station-authority")
RUNTIME_DATA_ROOT = Path("/srv/bulk/leo")
REQUIRED_SCANNER_DIRECTORIES = ("scanner-recordings", "scanner-reports")
STATION_TOPOLOGY_RELATIVE_PATH = "gauss-four-path-postreboot-20260816-v1.json"
STATION_TOPOLOGY_FILE_SHA256 = "5ec14f15bfe2a6abc52024f41db29b4ab6123209e6c4779a47644b1e70c477ae"
STANDARD_REGRESSION_RECEIPT_RELATIVE_PATH = Path(
    "corpus/goldens/trial-132-standard-v2-full-review-receipt.json"
)
STANDARD_REGRESSION_RECEIPT_SHA256 = (
    "c7e354b9edd4989673cdc860d9ea61610f4d96bccdb6163e35ac5977150d1105"
)
STANDARD_REGRESSION_SUMMARY_RELATIVE_PATH = Path(
    "corpus/goldens/trial-132-standard-v2-summary.json"
)
STANDARD_REGRESSION_SUMMARY_SHA256 = (
    "0b13a4c0b09cda17fc971e66396b5673c6b89eb8cef9fcef3ddcf8bc87309daa"
)
STANDARD_REGRESSION_OUTPUT_SHA256 = (
    "cae4c4e44f72749211ccd65a3f0af776adfb82031eb0250cdedaf15fb93a9886"
)


def reject_qnap(path: Path, label: str) -> Path:
    absolute = path.absolute()
    if absolute == QNAP or QNAP in absolute.parents:
        raise ValueError(f"{label} must not resolve beneath /mnt/qnap01")
    resolved = absolute.resolve(strict=False)
    if resolved == QNAP or QNAP in resolved.parents:
        raise ValueError(f"{label} must not resolve beneath /mnt/qnap01")
    return resolved


def load_json(path: Path, label: str) -> dict[str, Any]:
    if path.absolute().is_symlink():
        raise ValueError(f"{label} must not be a symlink: {path}")
    safe = reject_qnap(path, label)
    if not safe.is_file():
        raise ValueError(f"{label} must be a regular non-symlink file: {safe}")
    mode = safe.stat().st_mode & 0o777
    if mode & 0o222:
        raise ValueError(f"{label} is not sealed read-only: {mode:o}")
    payload = json.loads(safe.read_text(encoding="utf-8"))
    if not isinstance(payload, dict):
        raise ValueError(f"{label} must contain a JSON object")
    return payload


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_release_evidence(
    receipt_path: Path,
    receipt: dict[str, Any],
    *,
    release: Path,
    revision: str,
) -> None:
    root = reject_qnap(receipt_path, "release qualification receipt").parent
    definition = root / str(receipt.get("definition_relative_path", ""))
    expected_definition = receipt.get("definition_sha256")
    if not definition.is_file() or sha256(definition) != expected_definition:
        raise ValueError("release qualification definition digest does not verify")
    definition_payload = json.loads(definition.read_text(encoding="utf-8"))
    source = definition_payload.get("source") if isinstance(definition_payload, dict) else None
    if not isinstance(source, dict) or source.get("git_revision") != revision:
        raise ValueError("release qualification definition does not identify staged revision")
    if source.get("uv_lock_sha256") != sha256(release / "uv.lock"):
        raise ValueError("qualified uv.lock does not match staged release")
    if source.get("package_lock_sha256") != sha256(release / "web/package-lock.json"):
        raise ValueError("qualified package-lock.json does not match staged release")
    evidence = receipt.get("evidence")
    if not isinstance(evidence, list) or not evidence:
        raise ValueError("release qualification receipt has no evidence inventory")
    for item in evidence:
        if not isinstance(item, dict):
            raise ValueError("release qualification evidence entry is malformed")
        relative = Path(str(item.get("relative_path", "")))
        if relative.is_absolute() or ".." in relative.parts:
            raise ValueError("release qualification evidence path escapes its run")
        path = reject_qnap(root / relative, "release qualification evidence")
        if path.parent != root and root not in path.parents:
            raise ValueError("release qualification evidence path escapes its run")
        if not path.is_file() or path.stat().st_size != item.get("bytes"):
            raise ValueError(f"release qualification evidence is missing or resized: {relative}")
        if sha256(path) != item.get("sha256"):
            raise ValueError(f"release qualification evidence digest mismatch: {relative}")


def command(*argv: str) -> str:
    result = subprocess.run(argv, text=True, capture_output=True, check=False)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise ValueError(f"{' '.join(argv)}: {detail}")
    return result.stdout.strip()


def user_systemctl(user: str, *arguments: str) -> subprocess.CompletedProcess[str]:
    uid = pwd.getpwnam(user).pw_uid
    return subprocess.run(
        (
            "runuser",
            "-u",
            user,
            "--",
            "env",
            f"XDG_RUNTIME_DIR=/run/user/{uid}",
            "systemctl",
            "--user",
            *arguments,
        ),
        text=True,
        capture_output=True,
        check=False,
    )


def unexpected_legacy_active_units(output: str) -> tuple[str, ...]:
    """Return active legacy LEO units other than the isolated PostgreSQL host."""

    unexpected = []
    for line in output.splitlines():
        fields = line.split()
        if fields and fields[0] not in ALLOWED_LEGACY_ACTIVE_UNITS:
            unexpected.append(line)
    return tuple(unexpected)


def verify_environment_text(env_text: str, revision: str) -> dict[str, str]:
    for placeholder in (
        "REPLACE-A",
        "REPLACE-B",
        "192.0.2.10",
        "192.0.2.11",
        "REPLACE-PIPELINE-RELEASE-ID",
    ):
        if placeholder in env_text:
            raise ValueError(f"production environment still contains placeholder {placeholder}")
    environment: dict[str, str] = {}
    for raw_line in env_text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise ValueError("production environment contains a malformed line")
        key, value = line.split("=", 1)
        environment[key] = value.strip("'")
    if environment.get("LEO_BULK_ROOT") != "/srv/bulk/leo":
        raise ValueError("LEO_BULK_ROOT is not the canonical local data plane")
    expected_roots = {
        "LEO_QUALIFICATION_ROOT": "/srv/bulk/leo/qualification",
        "LEO_CAPTURE_EVIDENCE_ROOT": "/srv/bulk/leo/qualification/capture",
        "LEO_LEGACY_EVIDENCE_ROOT": "/srv/bulk/leo/qualification/legacy",
    }
    if any(environment.get(key) != value for key, value in expected_roots.items()):
        raise ValueError("production qualification roots are not canonical local paths")
    expected_station_authority = {
        "LEO_STATION_AUTHORITY_ROOT": str(STATION_AUTHORITY_ROOT),
        "LEO_STATION_TOPOLOGY_RELATIVE_PATH": STATION_TOPOLOGY_RELATIVE_PATH,
        "LEO_STATION_TOPOLOGY_FILE_DIGEST": f"sha256:{STATION_TOPOLOGY_FILE_SHA256}",
        "LEO_FIXTURE_PATH_AUTHORITIES_JSON": "[]",
    }
    if any(environment.get(key) != value for key, value in expected_station_authority.items()):
        raise ValueError(
            "production station authority must use the exact reviewed root, topology, "
            "file digest, and empty fixture inventory"
        )
    if environment.get("LEO_PIPELINE_RELEASE_ID") != revision:
        raise ValueError("pipeline release ID must equal the exact staged revision")
    if environment.get("LEO_CAPTURE_PROFILE") != "starlink-ch4-lower-2p5m-60s-continuity-v2":
        raise ValueError(
            "production capture profile must be the counter-authoritative dual-RX 60-second profile"
        )
    if environment.get("LEO_CAPTURE_INTERVAL_SECONDS") != "180":
        raise ValueError("production capture interval must be a 180-second start period")
    expected_capture_modes = {
        "LEO_QUALIFICATION_PROFILE": ("starlink-ch4-lower-2p5m-60s-rx1-centered-continuity-v2"),
        "LEO_SOAK_PROFILE": "starlink-ch4-lower-2p5m-60s-continuity-v2",
    }
    if any(environment.get(key) != value for key, value in expected_capture_modes.items()):
        raise ValueError("qualification and soak profiles must be counter-authoritative V2")
    expected_scanner = {
        "LEO_SCANNER_ENABLED": "true",
        "LEO_SCANNER_RADIO_ID": "radio_pluto_5d4d",
        "LEO_SCANNER_INTERVAL_SECONDS": "180",
        "LEO_SCANNER_MAXIMUM_LATENESS_SECONDS": "180",
        "LEO_SCANNER_DWELL_MS": "120",
        "LEO_SCANNER_GAIN_DB": "40.0",
        "LEO_SCANNER_MARGIN_GATE": "0.025",
        "LEO_SCANNER_REPORT_ROOT": "/srv/bulk/leo/scanner-reports",
    }
    if any(environment.get(key) != value for key, value in expected_scanner.items()):
        raise ValueError("production scanner configuration is not the reviewed V2 deployment")
    try:
        radios = json.loads(environment.get("LEO_RADIOS_JSON", ""))
    except json.JSONDecodeError as error:
        raise ValueError("production radio configuration is invalid JSON") from error
    if not isinstance(radios, list):
        raise ValueError("production radio configuration must contain a list")
    expected_radios = {
        (
            "radio_pluto_5d4d",
            "1040005e0b100007100010000bf33a5d4d",
            "192.168.1.20",
            2,
        ),
        (
            "radio_pluto_19f2",
            "10400056f695001322002d0010ad1719f2",
            "192.168.1.21",
            2,
        ),
    }
    observed_radios = {
        (item.get("radio_id"), item.get("serial"), item.get("host"), item.get("receiver_count"))
        for item in radios
        if isinstance(item, dict)
    }
    if observed_radios != expected_radios or len(radios) != 2:
        raise ValueError("production radio identities do not match the frozen station topology")
    return environment


def verify_station_authority_install(
    path: Path,
    *,
    expected_uid: int = 0,
    expected_gid: int,
) -> None:
    """Verify the exact installed topology inode used by the runtime loader."""

    safe = reject_qnap(path, "station topology authority")
    if path.absolute().is_symlink() or safe != path.absolute():
        raise ValueError("station topology authority must not use a symlink")
    root = safe.parent
    for candidate, expected_mode, label in (
        (root.parent, 0o750, "station authority parent"),
        (root, 0o750, "station authority root"),
    ):
        metadata = candidate.stat()
        if not stat.S_ISDIR(metadata.st_mode) or candidate.is_symlink():
            raise ValueError(f"{label} must be a regular non-symlink directory")
        if (
            metadata.st_uid != expected_uid
            or metadata.st_gid != expected_gid
            or stat.S_IMODE(metadata.st_mode) != expected_mode
        ):
            raise ValueError(f"{label} ownership or permissions are not exact")
    metadata = safe.stat()
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != expected_uid
        or metadata.st_gid != expected_gid
        or metadata.st_nlink != 1
        or stat.S_IMODE(metadata.st_mode) != 0o440
    ):
        raise ValueError("station topology authority inode is not sealed root-owned 0440")
    if sha256(safe) != STATION_TOPOLOGY_FILE_SHA256:
        raise ValueError("station topology authority file digest mismatch")


def verify_scanner_data_directories(
    root: Path = RUNTIME_DATA_ROOT,
    *,
    expected_uid: int = 0,
    expected_gid: int,
) -> None:
    """Verify scanner evidence destinations before acquisition can start."""

    safe_root = reject_qnap(root, "runtime data root")
    for relative in REQUIRED_SCANNER_DIRECTORIES:
        literal = root / relative
        path = reject_qnap(literal, f"scanner data directory {relative}")
        if literal.absolute().is_symlink() or path != literal.absolute():
            raise ValueError(f"scanner data directory {relative} must not use a symlink")
        try:
            metadata = path.stat()
        except FileNotFoundError as error:
            raise ValueError(f"scanner data directory {relative} is missing") from error
        if (
            safe_root not in path.parents
            or not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != expected_uid
            or metadata.st_gid != expected_gid
            or stat.S_IMODE(metadata.st_mode) != 0o2770
        ):
            raise ValueError(
                f"scanner data directory {relative} ownership or permissions are not exact"
            )


def verify_standard_regression_receipt(
    receipt_path: Path,
    receipt: dict[str, Any],
    *,
    release: Path,
) -> None:
    """Verify the frozen four-path scientific authority for lean cutover."""

    committed_receipt = release / STANDARD_REGRESSION_RECEIPT_RELATIVE_PATH
    committed_summary = release / STANDARD_REGRESSION_SUMMARY_RELATIVE_PATH
    if sha256(receipt_path) != STANDARD_REGRESSION_RECEIPT_SHA256:
        raise ValueError("Standard regression receipt digest is not the reviewed authority")
    if (
        not committed_receipt.is_file()
        or sha256(committed_receipt) != STANDARD_REGRESSION_RECEIPT_SHA256
    ):
        raise ValueError("staged release does not contain the reviewed Standard receipt")
    if (
        not committed_summary.is_file()
        or sha256(committed_summary) != STANDARD_REGRESSION_SUMMARY_SHA256
    ):
        raise ValueError("staged release does not contain the reviewed Standard golden")
    post_freeze = receipt.get("post_freeze_verification")
    invariants = receipt.get("verified_invariants")
    if (
        receipt.get("schema") != "org.leo.standard-real-corpus-review-receipt/v1"
        or receipt.get("fixture_id") != "trial-132-four-path-v1"
        or receipt.get("review_status") != "reviewed_corrected_full_run"
        or receipt.get("golden_summary_sha256") != STANDARD_REGRESSION_SUMMARY_SHA256
        or receipt.get("path_inventory")
        != [["stream-0", 0], ["stream-0", 1], ["stream-1", 0], ["stream-1", 1]]
        or not isinstance(post_freeze, dict)
        or post_freeze.get("result") != "1 passed"
        or post_freeze.get("run_a_sha256") != STANDARD_REGRESSION_OUTPUT_SHA256
        or post_freeze.get("run_b_sha256") != STANDARD_REGRESSION_OUTPUT_SHA256
        or not isinstance(invariants, dict)
        or invariants.get("all_numbers_finite") is not True
        or invariants.get("polynomial_degrees_per_path") != [1, 2, 3]
        or invariants.get("trajectory_ids_unique") is not True
        or invariants.get("selected_trajectories_equal_replayed_representatives") is not True
        or invariants.get("glrt64_feedback_recomputed_exactly") is not True
        or invariants.get("candidate_only") is not True
        or invariants.get("specificity_claimed") is not False
        or invariants.get("payload_decoded") is not False
        or invariants.get("phase_coherent") is not False
    ):
        raise ValueError("Standard regression receipt contents are not the reviewed authority")


def verify_soak_receipt(receipt: dict[str, Any]) -> None:
    """Verify the optional legacy qualification-soak cutover authority."""

    if receipt.get("accepted") is not True:
        raise ValueError("terminal soak acceptance receipt is not accepted")
    if receipt.get("kind") != "soak_acceptance_audit" or receipt.get("schema_version") != 1:
        raise ValueError("terminal soak acceptance receipt has an unsupported contract")
    checks = receipt.get("checks")
    if (
        not isinstance(checks, list)
        or not checks
        or any(not isinstance(item, dict) or item.get("passed") is not True for item in checks)
    ):
        raise ValueError("terminal soak receipt does not contain an all-pass check inventory")


def verify(args: argparse.Namespace) -> list[str]:
    revision = args.revision
    if re.fullmatch(r"[0-9a-f]{40}", revision) is None:
        raise ValueError("revision must be a full lowercase 40-character SHA")
    release_literal = RELEASE_ROOT / revision
    release = reject_qnap(release_literal, "release")
    if release_literal.is_symlink() or not release.is_dir():
        raise ValueError(f"staged release is missing or unsafe: {release}")
    git = ("env", "GIT_OPTIONAL_LOCKS=0", "git", "-C", str(release))
    if command(*git, "rev-parse", "HEAD") != revision:
        raise ValueError("staged release HEAD does not match requested revision")
    if command(*git, "status", "--porcelain"):
        raise ValueError("staged release is dirty")
    release_mode = release.stat().st_mode & 0o777
    if release_mode & 0o022:
        raise ValueError(f"staged release root is group/other writable: {release_mode:o}")
    required_outputs = (
        release / ".venv/bin/leo",
        release / ".venv/bin/leo-api",
        release / "web/dist/index.html",
    )
    for required in required_outputs:
        if not required.is_file():
            raise ValueError(f"staged release output is missing: {required}")

    release_receipt = load_json(args.release_receipt, "release qualification receipt")
    if release_receipt.get("passed") is not True or release_receipt.get("status") != "passed":
        raise ValueError("release qualification receipt is not a pass")
    if release_receipt.get("git_revision") != revision:
        raise ValueError("release qualification receipt does not match staged revision")
    verify_release_evidence(
        args.release_receipt,
        release_receipt,
        release=release,
        revision=revision,
    )

    if args.standard_regression_receipt is not None:
        standard_receipt = load_json(
            args.standard_regression_receipt,
            "Standard four-path regression receipt",
        )
        verify_standard_regression_receipt(
            args.standard_regression_receipt,
            standard_receipt,
            release=release,
        )
        cutover_evidence = "reviewed four-path Standard regression is sealed and passed"
    else:
        assert args.soak_receipt is not None
        verify_soak_receipt(load_json(args.soak_receipt, "terminal soak audit receipt"))
        cutover_evidence = "optional terminal qualification soak is sealed and accepted"

    env_path = reject_qnap(ENVIRONMENT, "production environment")
    if ENVIRONMENT.is_symlink() or not env_path.is_file():
        raise ValueError("production environment must be a regular non-symlink file")
    mode = env_path.stat().st_mode & 0o777
    if mode & 0o007 or mode & 0o020:
        raise ValueError(f"production environment permissions are too broad: {mode:o}")
    env_text = env_path.read_text(encoding="utf-8")
    environment = verify_environment_text(env_text, revision)
    authority_path = (
        Path(environment["LEO_STATION_AUTHORITY_ROOT"])
        / environment["LEO_STATION_TOPOLOGY_RELATIVE_PATH"]
    )
    verify_station_authority_install(
        authority_path,
        expected_gid=grp.getgrnam("leo").gr_gid,
    )
    verify_scanner_data_directories(expected_gid=grp.getgrnam("leo").gr_gid)

    if os.geteuid() != 0:
        raise ValueError("run as root so both system and legacy user managers can be inspected")
    legacy = user_systemctl(
        args.legacy_user,
        "list-units",
        "leo-*",
        "--state=active,activating,reloading",
        "--no-legend",
        "--plain",
    )
    if legacy.returncode not in (0,):
        raise ValueError(f"cannot inspect legacy user manager: {legacy.stderr.strip()}")
    unexpected_legacy = unexpected_legacy_active_units(legacy.stdout)
    if unexpected_legacy:
        raise ValueError("legacy user LEO units are still active:\n" + "\n".join(unexpected_legacy))

    system_active = command(
        "systemctl",
        "list-units",
        "leo-*",
        "--state=active,activating,reloading",
        "--no-legend",
        "--plain",
    )
    if system_active:
        raise ValueError("system-scope LEO units are already active:\n" + system_active)

    metadata = Path("/opt/leo-tracker/release-metadata") / f"{revision}.txt"
    metadata_validator = release / "deploy/scripts/validate-release-metadata"
    runtime_validator = release / "deploy/scripts/validate-published-release"
    command(
        str(metadata_validator),
        str(release),
        str(metadata),
        revision,
    )
    command(
        "runuser",
        "-u",
        "leo",
        "--",
        str(release / ".venv/bin/python"),
        str(runtime_validator),
        str(release),
        str(RELEASE_ROOT / f".staging-{revision}"),
    )

    unit_paths = tuple(sorted(UNIT_SOURCE.glob("leo-*.service")))
    if not unit_paths:
        raise ValueError(f"no unit templates found beneath {UNIT_SOURCE}")
    timer_paths = tuple(sorted(UNIT_SOURCE.glob("leo-*.timer")))
    command(
        "systemd-analyze",
        "verify",
        *(str(path) for path in unit_paths),
        *(str(path) for path in timer_paths),
    )
    for path in unit_paths:
        text = path.read_text(encoding="utf-8")
        if "InaccessiblePaths=/mnt/qnap01" not in text:
            raise ValueError(f"unit does not deny QNAP: {path.name}")

    return [
        f"release {revision} is immutable and built",
        "exact-revision release qualification is sealed and passed",
        cutover_evidence,
        "installed station topology authority is exact and sealed",
        "scanner raw-IQ and report directories are installed and permissioned",
        "production environment is permissioned and contains no radio placeholders",
        "legacy user scope and canonical system scope have no active LEO units",
        "all canonical unit templates validate and deny QNAP",
        "external release metadata and final-path runtime validate",
    ]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--revision", required=True)
    parser.add_argument("--release-receipt", required=True, type=Path)
    authority = parser.add_mutually_exclusive_group(required=True)
    authority.add_argument("--standard-regression-receipt", type=Path)
    authority.add_argument("--soak-receipt", type=Path)
    parser.add_argument("--legacy-user", required=True)
    args = parser.parse_args()
    try:
        results = verify(args)
    except (KeyError, OSError, ValueError, json.JSONDecodeError) as error:
        print(f"CUTOVER BLOCKED: {error}", file=sys.stderr)
        return 1
    print("CUTOVER PREFLIGHT PASSED")
    for result in results:
        print(f"- {result}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
