LIVE_STATION_PROBE_PROGRAM = """
import json

from leo.radio import PlutoIioRadioSource

targets = (
    ("radio_pluto_5d4d", "192.168.1.20", "1040005e0b100007100010000bf33a5d4d"),
    ("radio_pluto_19f2", "192.168.1.21", "10400056f695001322002d0010ad1719f2"),
)
radios = []
for radio_id, host, serial in targets:
    source = PlutoIioRadioSource(host, expected_serial=serial, radio_id=radio_id)
    try:
        identity = source.open()
        capabilities = source.capabilities
        facts = source.diagnostic_facts()
        radios.append(
            {
                "schema_version": 1,
                "radio_id": identity.radio_id,
                "serial": identity.serial,
                "uri": identity.uri,
                "transport": identity.transport.value,
                "firmware_version": identity.firmware_version,
                "metadata_abi_version": facts.get("buffer_metadata_abi"),
                "buffer_direct_async": facts.get("buffer_direct_async"),
                "buffer_direct_async_exact_kernel_queue": facts.get(
                    "buffer_direct_async_exact_kernel_queue"
                ),
                "buffer_direct_async_ring": facts.get("buffer_direct_async_ring"),
                "buffer_direct_async_overrun_policies": facts.get(
                    "buffer_direct_async_overrun_policies"
                ),
                "buffer_direct_async_default_overrun_policy": facts.get(
                    "buffer_direct_async_default_overrun_policy"
                ),
                "buffer_ddr_ring_max_iq_bytes": facts.get("buffer_ddr_ring_max_iq_bytes"),
                "supports_device_sample_counter": capabilities.supports_device_sample_counter,
                "supports_continuity_sequence": capabilities.supports_continuity_sequence,
            }
        )
    finally:
        source.close()
print(json.dumps({"schema_version": 1, "radios": radios}, sort_keys=True, separators=(",", ":")))
""".strip()
NATIVE_BANDWIDTH_RECEIPT_PROGRAM = """
import json
import sys
from pathlib import Path

from leo.qualification.native_bandwidth import NativeBandwidthQualificationReceiptV1

receipt = NativeBandwidthQualificationReceiptV1.model_validate_json(
    Path(sys.argv[1]).read_text(encoding="utf-8")
)
print(json.dumps({
    "target_revision": receipt.target_revision,
    "host": receipt.host.model_dump(mode="json"),
    "radios": [item.model_dump(mode="json") for item in receipt.radios],
    "pluto_plus_utils_revision": receipt.pluto_plus_utils_revision,
    "created_utc_ns": receipt.created_utc_ns,
    "modes": [item.mode.value for item in receipt.captures],
}, sort_keys=True, separators=(",", ":")))
""".strip()
NATIVE_BANDWIDTH_RECEIPT_V2_PROGRAM = """
import json
import sys
from pathlib import Path

from leo.qualification.native_bandwidth import NativeBandwidthQualificationReceiptV2

receipt = NativeBandwidthQualificationReceiptV2.model_validate_json(
    Path(sys.argv[1]).read_text(encoding="utf-8")
)
print(json.dumps({
    "target_revision": receipt.target_revision,
    "host": receipt.host.model_dump(mode="json"),
    "radios": [item.model_dump(mode="json") for item in receipt.radios],
    "pluto_plus_utils_revision": receipt.pluto_plus_utils_revision,
    "created_utc_ns": receipt.created_utc_ns,
    "modes": [item.mode.value for item in receipt.captures],
    "metadata_rate_inventory": [
        [ladder.sample_rate_hz for ladder in item.ladders]
        for item in receipt.transport_evidence
    ],
    "largest_passing_refill_inventory": [
        [ladder.largest_passing_samples_per_channel for ladder in item.ladders]
        for item in receipt.transport_evidence
    ],
    "exact_rf_readback_inventory": [
        [
            ladder.readback_verified
            and ladder.rf_bandwidth_hz == ladder.sample_rate_hz
            for ladder in item.ladders
        ]
        for item in receipt.transport_evidence
    ],
}, sort_keys=True, separators=(",", ":")))
""".strip()
