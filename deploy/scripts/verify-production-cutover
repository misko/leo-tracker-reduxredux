STANDARD_REGRESSION_SUMMARY_SHA256 = (
    "0b13a4c0b09cda17fc971e66396b5673c6b89eb8cef9fcef3ddcf8bc87309daa"
)
STANDARD_REGRESSION_OUTPUT_SHA256 = (
    "cae4c4e44f72749211ccd65a3f0af776adfb82031eb0250cdedaf15fb93a9886"
)


def reject_qnap(path: Path, label: str) -> Path:
    absolute = path.absolute()
    if absolute == QNAP or QNAP in absolute.parents:
        raise ValueError(f"{label} must not resolve beneath /mnt/qnap01")
    resolved = absolute.resolve(strict=False)
    if resolved == QNAP or QNAP in resolved.parents:
        raise ValueError(f"{label} must not resolve beneath /mnt/qnap01")
    return resolved


def load_json(path: Path, label: str) -> dict[str, Any]:
    if path.absolute().is_symlink():
        raise ValueError(f"{label} must not be a symlink: {path}")
    safe = reject_qnap(path, label)
    if not safe.is_file():
        raise ValueError(f"{label} must be a regular non-symlink file: {safe}")
    mode = safe.stat().st_mode & 0o777
    if mode & 0o222:
        raise ValueError(f"{label} is not sealed read-only: {mode:o}")
    payload = json.loads(safe.read_text(encoding="utf-8"))
    if not isinstance(payload, dict):
        raise ValueError(f"{label} must contain a JSON object")
    return payload


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def canonical_json_sha256(value: Any) -> str:
    """Digest one JSON-compatible value with the persisted contract encoding."""

    payload = json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return f"sha256:{hashlib.sha256(payload).hexdigest()}"


def verify_staged_capture_profiles(release: Path) -> None:
    """Verify the exact reviewed profile bytes shipped in the staged release."""

    release_root = release.absolute()
    for relative, expected_digest in REVIEWED_CAPTURE_PROFILE_SHA256.items():
        literal = release_root / relative
        resolved = literal.resolve(strict=False)
        if literal.is_symlink() or resolved != literal:
            raise ValueError(f"staged capture profile must not use a symlink: {relative}")
        if not literal.is_file():
            raise ValueError(f"staged capture profile is missing: {relative}")
        if sha256(literal) != expected_digest:
            raise ValueError(f"staged capture profile digest mismatch: {relative}")


def verify_staged_acquisition_service(release: Path) -> None:
    """Bind the staged service to the exact reviewed profile and radio pool."""

    release_root = release.absolute()
    literal = release_root / ACQUISITION_SERVICE_RELATIVE_PATH
    resolved = literal.resolve(strict=False)
    if literal.is_symlink() or resolved != literal:
        raise ValueError("staged acquisition service must not use a symlink")
    if not literal.is_file():
        raise ValueError("staged acquisition service is missing")
    exec_starts = tuple(
        line.removeprefix("ExecStart=")
        for line in literal.read_text(encoding="utf-8").splitlines()
        if line.startswith("ExecStart=")
    )
    if exec_starts != (EXPECTED_ACQUISITION_EXEC_START,):
        raise ValueError(
            "staged acquisition service does not use the exact ordered profile and radio pool"
        )


def _staged_release_source_identity(release: Path, revision: str) -> dict[str, str]:
    """Read the Git-free identity that is separately sealed by release metadata."""

    if (release / ".git").exists() or (release / ".git").is_symlink():
        raise ValueError("staged release unexpectedly contains Git metadata")
    if (release / "reports").exists() or (release / "reports").is_symlink():
        raise ValueError("staged release unexpectedly contains historical reports")
    document = _load_qualification_json(
        release / RELEASE_SOURCE_MARKER,
        "staged release source identity",
        require_sealed=True,
    )
    if set(document) != {"schema", "revision", "tree"}:
        raise ValueError("staged release source identity schema is not closed")
    if (
        document.get("schema") != RELEASE_SOURCE_SCHEMA
        or document.get("revision") != revision
        or not isinstance(document.get("tree"), str)
        or re.fullmatch(r"[0-9a-f]{40}", document["tree"]) is None
    ):
        raise ValueError("staged release source identity is malformed or mismatched")
    return {"revision": revision, "tree": document["tree"]}


def verify_release_evidence(
    receipt_path: Path,
    receipt: dict[str, Any],
    *,
    release: Path,
    revision: str,
) -> None:
    root = _qualification_run_root(receipt_path)
    persisted_receipt = _load_qualification_json(
        receipt_path,
        "release qualification receipt",
        require_sealed=True,
    )
    if persisted_receipt != receipt:
        raise ValueError("release qualification receipt argument differs from persisted bytes")
    receipt = persisted_receipt
    expected_receipt_keys = {
        "schema",
        "run_id",
        "status",
        "passed",
        "started_utc",
        "finished_utc",
        "duration_seconds",
        "git_revision",
        "git_tree",
        "source_identity_kind",
        "maximum_resource_units",
        "include_historical",
        "reused_lanes",
        "definition_relative_path",
        "definition_sha256",
        "commands",
        "evidence",
    }
    if set(receipt) != expected_receipt_keys:
        raise ValueError("release qualification receipt schema is not closed")
    if (
        receipt.get("schema") != RELEASE_QUALIFICATION_SCHEMA
        or receipt.get("status") != "passed"
        or receipt.get("passed") is not True
        or receipt.get("git_revision") != revision
        or receipt.get("source_identity_kind") != "sealed-release-marker"
        or type(receipt.get("maximum_resource_units")) is not int
        or not 2 <= receipt["maximum_resource_units"] <= 4
        or receipt.get("include_historical") is not False
    ):
        raise ValueError("release qualification receipt is not the required blocking V3 schema")
    source_identity = _staged_release_source_identity(release, revision)
    if receipt.get("git_tree") != source_identity["tree"]:
        raise ValueError("release qualification receipt does not match the staged source tree")
    run_id = receipt.get("run_id")
    if not _safe_run_id(run_id) or root.name != run_id:
        raise ValueError("release qualification run ID does not bind its evidence directory")
    if receipt.get("definition_relative_path") != "definition.json":
        raise ValueError("release qualification definition path is not canonical")
    definition = root / "definition.json"
    expected_definition = receipt.get("definition_sha256")
    definition_payload = _load_qualification_json(
        definition,
        "release qualification definition",
        require_sealed=True,
    )
    if not _is_sha256(expected_definition) or sha256(definition) != expected_definition:
        raise ValueError("release qualification definition digest does not verify")
    contract = _load_release_qualification_contract(release)
    if definition_payload.get("schema") != RELEASE_QUALIFICATION_SCHEMA:
        raise ValueError("release qualification definition is not the required V3 schema")
    source = definition_payload.get("source")
    if not isinstance(source, dict):
        raise ValueError("release qualification definition source is malformed")
    python_version = source.get("python")
    platform_identity = source.get("platform")
    if not isinstance(python_version, str) or not python_version:
        raise ValueError("release qualification Python identity is malformed")
    if not isinstance(platform_identity, str) or not platform_identity:
        raise ValueError("release qualification platform identity is malformed")
    execution = definition_payload.get("execution")
    if (
        not isinstance(execution, dict)
        or execution.get("maximum_resource_units") != receipt["maximum_resource_units"]
        or execution.get("include_historical") is not False
    ):
        raise ValueError("release qualification execution is not the blocking V3 policy")
    definition_commands = definition_payload.get("commands")
    if not isinstance(definition_commands, list):
        raise ValueError("release qualification command inventory is malformed")
    lane_input_digests: dict[str, dict[str, str]] = {}
    for command_document in definition_commands:
        if not isinstance(command_document, dict):
            raise ValueError("release qualification command document is malformed")
        name = command_document.get("name")
        lane_metadata = command_document.get("lane_metadata")
        input_digests = (
            lane_metadata.get("input_digests") if isinstance(lane_metadata, dict) else None
        )
        if (
            not isinstance(name, str)
            or name in lane_input_digests
            or not isinstance(input_digests, dict)
            or any(
                not isinstance(key, str) or not _is_sha256(value)
                for key, value in input_digests.items()
            )
        ):
            raise ValueError("release qualification lane input identity is malformed")
        lane_input_digests[name] = input_digests
    command_documents = contract.release_qualification_v3_command_documents(
        include_historical=False
    )
    measured_lane_input_digests = _release_qualification_v3_lane_input_digests(
        release,
        contract=contract,
        commands=command_documents,
        python_version=python_version,
        platform_identity=platform_identity,
    )
    if lane_input_digests != measured_lane_input_digests:
        raise ValueError("release qualification lane inputs do not match staged release content")
    staged_uv_digest = _staged_file_sha256(release / "uv.lock", "staged uv.lock")
    staged_package_digest = _staged_file_sha256(
        release / "web/package-lock.json",
        "staged package-lock.json",
    )
    staged_corpus_digest = _staged_file_sha256(
        release / "corpus/manifest.json",
        "staged corpus manifest",
    )
    expected_definition_payload = contract.release_qualification_v3_definition(
        run_id=run_id,
        started_utc=receipt.get("started_utc"),
        git_revision=revision,
        git_tree=source_identity["tree"],
        source_identity_kind="sealed-release-marker",
        python_version=python_version,
        platform_identity=platform_identity,
        uv_lock_sha256=staged_uv_digest,
        package_lock_sha256=staged_package_digest,
        corpus_manifest_sha256=staged_corpus_digest,
        database_identity=RELEASE_QUALIFICATION_DATABASE,
        protected_corpus_root=RELEASE_QUALIFICATION_PROTECTED_CORPUS,
        native_rate_corpus_root=RELEASE_QUALIFICATION_PROTECTED_CORPUS,
        maximum_resource_units=receipt["maximum_resource_units"],
        include_historical=False,
        lane_input_digests=lane_input_digests,
    )
    if definition_payload != expected_definition_payload:
        raise ValueError(
            "release qualification definition differs from the canonical staged V3 contract"
        )
    _verify_release_qualification_commands(
        definition_payload,
        release=release,
        contract=contract,
    )

    started = _qualification_timestamp(receipt.get("started_utc"), "receipt started_utc")
    finished = _qualification_timestamp(receipt.get("finished_utc"), "receipt finished_utc")
    _require_duration(
        receipt.get("duration_seconds"),
        (finished - started).total_seconds(),
        "receipt duration_seconds",
    )
    if finished < started:
        raise ValueError("release qualification receipt time interval is reversed")

    actual_inventory = _qualification_tree_inventory(
        root,
        "release qualification evidence",
        require_sealed=True,
        excluded_relative_paths=frozenset({"receipt.json"}),
    )
    evidence = receipt.get("evidence")
    if not isinstance(evidence, list) or evidence != actual_inventory:
        raise ValueError("release qualification evidence inventory is not exact and complete")
    evidence_paths = {item["relative_path"] for item in actual_inventory}
    required_paths = {
        "definition.json",
        *(
            contract.RELEASE_QUALIFICATION_V3_LOG_PATHS[name]
            for name in RELEASE_QUALIFICATION_COMMANDS
        ),
        *(
            contract.RELEASE_QUALIFICATION_V3_JUNIT_PATHS[name]
            for name in RELEASE_QUALIFICATION_COMMANDS
            if name in contract.RELEASE_QUALIFICATION_V3_JUNIT_PATHS
        ),
        *(
            contract.RELEASE_QUALIFICATION_V3_RESULT_PATHS[name]
            for name in RELEASE_QUALIFICATION_COMMANDS
        ),
    }
    missing = required_paths - evidence_paths
    unexpected = {
        path
        for path in evidence_paths - required_paths
        if not path.startswith("results/playwright/")
    }
    if missing or unexpected:
        raise ValueError(
            "release qualification evidence file set is not closed: "
            f"missing={sorted(missing)!r} unexpected={sorted(unexpected)!r}"
        )

    _verify_release_qualification_outcomes(
        receipt,
        root=root,
        started=started,
        finished=finished,
        contract=contract,
    )
    _verify_release_qualification_reuse(receipt)
    _verify_release_qualification_results(root, release=release, contract=contract)


def _verify_release_qualification_commands(
    definition: dict[str, Any],
    *,
    release: Path,
    contract: ModuleType | None = None,
) -> None:
    authority = contract or _load_release_qualification_contract(release)
    expected = list(authority.release_qualification_v3_command_documents(include_historical=False))
    actual = definition.get("commands")
    if not isinstance(actual, list) or len(actual) != len(expected):
        raise ValueError("release qualification command inventory is not exact")
    without_metadata = [
        {key: value for key, value in command.items() if key != "lane_metadata"}
        if isinstance(command, dict)
        else command
        for command in actual
    ]
    if without_metadata != expected:
        raise ValueError("release qualification command inventory is not exact")


def _qualification_run_root(receipt_path: Path) -> Path:
    literal = receipt_path.absolute()
    if literal.name != "receipt.json":
        raise ValueError("release qualification receipt path is not canonical")
    _qualification_regular_file(
        literal,
        "release qualification receipt",
        require_sealed=True,
    )
    root = literal.parent
    try:
        metadata = root.lstat()
    except OSError as error:
        raise ValueError("release qualification run root is unavailable") from error
    if not stat.S_ISDIR(metadata.st_mode) or root.resolve(strict=True) != root:
        raise ValueError("release qualification run root must be a non-symlink directory")
    if stat.S_IMODE(metadata.st_mode) & 0o222:
        raise ValueError("release qualification run root is not sealed read-only")
    return reject_qnap(root, "release qualification run root")


def _qualification_regular_file(
    path: Path,
    label: str,
    *,
    require_sealed: bool,
) -> Path:
    literal = path.absolute()
    try:
        metadata = literal.lstat()
        resolved = literal.resolve(strict=True)
    except OSError as error:
        raise ValueError(f"{label} is unavailable: {literal}") from error
    if not stat.S_ISREG(metadata.st_mode) or resolved != literal:
        raise ValueError(f"{label} must be a regular non-symlink file: {literal}")
    if require_sealed and stat.S_IMODE(metadata.st_mode) & 0o222:
        raise ValueError(f"{label} is not sealed read-only")
    return reject_qnap(literal, label)


def _load_qualification_json(
    path: Path,
    label: str,
    *,
    require_sealed: bool,
) -> dict[str, Any]:
    safe = _qualification_regular_file(path, label, require_sealed=require_sealed)
    if safe.stat().st_size > RELEASE_QUALIFICATION_MAXIMUM_JSON_BYTES:
        raise ValueError(f"{label} exceeds the 16 MiB boundary")
    payload = safe.read_bytes()
    if not payload or len(payload) > RELEASE_QUALIFICATION_MAXIMUM_JSON_BYTES:
        raise ValueError(f"{label} is empty or exceeds the 16 MiB boundary")

    def closed_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ValueError(f"{label} contains a duplicate JSON key: {key}")
            result[key] = value
        return result

    def invalid_constant(value: str) -> None:
        raise ValueError(f"{label} contains a non-finite JSON value: {value}")

    try:
        document = json.loads(
            payload.decode("utf-8"),
            object_pairs_hook=closed_object,
            parse_constant=invalid_constant,
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(f"{label} is not strict UTF-8 JSON") from error
    if not isinstance(document, dict):
        raise ValueError(f"{label} must contain a JSON object")
    return document


def _load_release_qualification_contract(release: Path) -> ModuleType:
    source = _qualification_regular_file(
        release / RELEASE_QUALIFICATION_CONTRACT,
        "staged release qualification contract",
        require_sealed=False,
    )
    spec = importlib.util.spec_from_file_location("_leo_staged_release_contract", source)
    if spec is None or spec.loader is None:
        raise ValueError("staged release qualification contract cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    previous_dont_write_bytecode = sys.dont_write_bytecode
    try:
        sys.dont_write_bytecode = True
        try:
            spec.loader.exec_module(module)
        finally:
            sys.dont_write_bytecode = previous_dont_write_bytecode
    except Exception as error:
        raise ValueError("staged release qualification contract cannot be evaluated") from error
    required = (
        "MAXIMUM_JUNIT_BYTES",
        "RELEASE_QUALIFICATION_V3_COMMAND_NAMES",
        "RELEASE_QUALIFICATION_V3_JUNIT_PATHS",
        "RELEASE_QUALIFICATION_V3_LOG_PATHS",
        "RELEASE_QUALIFICATION_V3_RESULT_PATHS",
        "release_qualification_v3_command_documents",
        "release_qualification_v3_definition",
        "release_qualification_v3_inventory_digest",
        "release_qualification_v3_lane_input_digests",
        "release_qualification_v3_runtime_digest",
        "validate_reusable_release_qualification_v3_lane",
        "validate_pytest_junit_summary_v1",
    )
    if any(not hasattr(module, name) for name in required):
        raise ValueError("staged release qualification contract is incomplete")
    return module


def _staged_file_sha256(path: Path, label: str) -> str:
    safe = _qualification_regular_file(path, label, require_sealed=False)
    return sha256(safe)


def _release_qualification_v3_input_inventory(
    root: Path,
    *,
    excluded_directories: frozenset[str] = frozenset(),
) -> list[dict[str, Any]]:
    ignored_directories = excluded_directories | frozenset(
        {"__pycache__", ".mypy_cache", ".pytest_cache", ".ruff_cache"}
    )
    literal = root.absolute()
    try:
        metadata = literal.lstat()
    except OSError as error:
        raise ValueError(f"release qualification input tree is unavailable: {literal}") from error
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or literal.is_symlink()
        or literal.resolve(strict=True) != literal
    ):
        raise ValueError(f"release qualification input tree is unsafe: {literal}")
    inventory: list[dict[str, Any]] = []
    for directory, directory_names, file_names in os.walk(literal, followlinks=False):
        directory_names[:] = sorted(
            name for name in directory_names if name not in ignored_directories
        )
        base = Path(directory)
        for name in directory_names:
            path = base / name
            if path.is_symlink():
                raise ValueError(f"release qualification input contains a symlink: {path}")
        for name in sorted(file_names):
            path = base / name
            item = path.lstat()
            if not stat.S_ISREG(item.st_mode):
                raise ValueError(f"release qualification input contains a non-regular file: {path}")
            inventory.append(
                {
                    "relative_path": path.relative_to(literal).as_posix(),
                    "bytes": item.st_size,
                    "sha256": sha256(path),
                }
            )
    return inventory


def _release_qualification_v3_lane_input_digests(
    release: Path,
    *,
    contract: ModuleType,
    commands: tuple[dict[str, Any], ...],
    python_version: str,
    platform_identity: str,
) -> dict[str, dict[str, str]]:
    def inventory_digest(
        relative: str,
        *,
        excluded_directories: frozenset[str] = frozenset(),
    ) -> str:
        inventory = _release_qualification_v3_input_inventory(
            release / relative,
            excluded_directories=excluded_directories,
        )
        return contract.release_qualification_v3_inventory_digest(inventory)

    lane_paths = getattr(contract, "RELEASE_QUALIFICATION_V3_LANE_INPUT_PATHS", None)
    if not isinstance(lane_paths, dict):
        raise ValueError("staged V3 qualification input-path contract is malformed")
    command_names = tuple(command.get("name") for command in commands)
    if any(not isinstance(name, str) or name not in lane_paths for name in command_names):
        raise ValueError("staged V3 qualification lane path mapping is incomplete")
    bounded_paths: set[str] = set()
    for name in command_names:
        inputs = lane_paths[name]
        if not isinstance(inputs, tuple) or any(
            not isinstance(relative, str) for relative in inputs
        ):
            raise ValueError("staged V3 qualification lane path mapping is malformed")
        bounded_paths.update(inputs)

    path_digests: dict[str, str] = {}
    for relative in sorted(bounded_paths):
        relative_path = Path(relative)
        if (
            relative_path.is_absolute()
            or relative_path.as_posix() != relative
            or not relative_path.parts
            or any(part in {"", ".", ".."} for part in relative_path.parts)
        ):
            raise ValueError("staged V3 qualification input path is unsafe")
        path = release / relative_path
        try:
            metadata = path.lstat()
        except OSError as error:
            raise ValueError(f"staged V3 qualification input is unavailable: {relative}") from error
        if path.is_symlink():
            raise ValueError(f"staged V3 qualification input is a symlink: {relative}")
        if stat.S_ISREG(metadata.st_mode):
            path_digests[relative] = sha256(path)
        elif stat.S_ISDIR(metadata.st_mode):
            path_digests[relative] = inventory_digest(
                relative,
                excluded_directories=(
                    frozenset({"node_modules", "dist", "test-results", "playwright-report"})
                    if relative == "web"
                    else frozenset()
                ),
            )
        else:
            raise ValueError(
                f"staged V3 qualification input is not a regular file or directory: {relative}"
            )
    runtime = contract.release_qualification_v3_runtime_digest(
        python_version=python_version,
        platform_identity=platform_identity,
    )
    return contract.release_qualification_v3_lane_input_digests(
        commands,
        path_digests=path_digests,
        python_runtime_sha256=runtime,
    )


def _qualification_tree_inventory(
    root: Path,
    label: str,
    *,
    require_sealed: bool,
    excluded_relative_paths: frozenset[str] = frozenset(),
) -> list[dict[str, Any]]:
    literal_root = root.absolute()
    try:
        root_metadata = literal_root.lstat()
        resolved_root = literal_root.resolve(strict=True)
    except OSError as error:
        raise ValueError(f"{label} root is unavailable") from error
    if not stat.S_ISDIR(root_metadata.st_mode) or resolved_root != literal_root:
        raise ValueError(f"{label} root must be a non-symlink directory")
    if require_sealed and stat.S_IMODE(root_metadata.st_mode) & 0o222:
        raise ValueError(f"{label} root is not sealed read-only")
    inventory: list[dict[str, Any]] = []
    for path in sorted(literal_root.rglob("*")):
        relative = path.relative_to(literal_root).as_posix()
        metadata = path.lstat()
        if stat.S_ISLNK(metadata.st_mode):
            raise ValueError(f"{label} contains a symlink: {relative}")
        if stat.S_ISDIR(metadata.st_mode):
            if require_sealed and stat.S_IMODE(metadata.st_mode) & 0o222:
                raise ValueError(f"{label} directory is not sealed read-only: {relative}")
            continue
        if not stat.S_ISREG(metadata.st_mode):
            raise ValueError(f"{label} contains a non-regular entry: {relative}")
        if require_sealed and stat.S_IMODE(metadata.st_mode) & 0o222:
            raise ValueError(f"{label} file is not sealed read-only: {relative}")
        if relative in excluded_relative_paths:
            continue
        inventory.append(
            {
                "relative_path": relative,
                "bytes": metadata.st_size,
                "sha256": sha256(path),
            }
        )
    return inventory


def _verify_release_qualification_outcomes(
    receipt: dict[str, Any],
    *,
    root: Path,
    started: datetime,
    finished: datetime,
    contract: ModuleType,
) -> None:
    commands = receipt.get("commands")
    if not isinstance(commands, list) or len(commands) != len(RELEASE_QUALIFICATION_COMMANDS):
        raise ValueError("release qualification outcome inventory is not exact")
    definition = _load_qualification_json(
        root / "definition.json",
        "release qualification definition",
        require_sealed=True,
    )
    expected_commands = definition.get("commands")
    if not isinstance(expected_commands, list) or len(expected_commands) != len(commands):
        raise ValueError("release qualification definition command inventory is not exact")
    for expected_name, expected_command, outcome in zip(
        RELEASE_QUALIFICATION_COMMANDS,
        expected_commands,
        commands,
        strict=True,
    ):
        if not isinstance(expected_command, dict) or not isinstance(outcome, dict):
            raise ValueError("release qualification outcome schema is not closed")
        try:
            contract.validate_reusable_release_qualification_v3_lane(
                outcome,
                expected_command,
            )
        except ValueError as error:
            raise ValueError(
                f"release qualification outcome did not pass exactly: {expected_name}: {error}"
            ) from error
        if outcome.get("name") != expected_name or outcome.get("release_blocking") is not True:
            raise ValueError(f"release qualification outcome did not pass exactly: {expected_name}")
        expected_log = contract.RELEASE_QUALIFICATION_V3_LOG_PATHS[expected_name]
        expected_result = contract.RELEASE_QUALIFICATION_V3_RESULT_PATHS[expected_name]
        command_started = _qualification_timestamp(
            outcome.get("started_utc"),
            f"{expected_name} started_utc",
        )
        command_finished = _qualification_timestamp(
            outcome.get("finished_utc"),
            f"{expected_name} finished_utc",
        )
        if (
            command_started < started
            or command_finished < command_started
            or command_finished > finished
        ):
            raise ValueError(
                f"release qualification outcome times are inconsistent: {expected_name}"
            )
        _require_duration(
            outcome.get("duration_seconds"),
            (command_finished - command_started).total_seconds(),
            f"{expected_name} duration_seconds",
        )
        log_path = _qualification_regular_file(
            root / expected_log,
            f"{expected_name} log",
            require_sealed=True,
        )
        result_path = _qualification_regular_file(
            root / expected_result,
            f"{expected_name} result",
            require_sealed=True,
        )
        if (
            not _is_sha256(outcome.get("log_sha256"))
            or outcome["log_sha256"] != sha256(log_path)
            or not _is_sha256(outcome.get("result_sha256"))
            or outcome["result_sha256"] != sha256(result_path)
        ):
            raise ValueError(f"release qualification outcome digest mismatch: {expected_name}")


def _verify_release_qualification_reuse(receipt: dict[str, Any]) -> None:
    reused_lanes = receipt.get("reused_lanes")
    outcomes = receipt.get("commands")
    if not isinstance(reused_lanes, list) or not isinstance(outcomes, list):
        raise ValueError("release qualification lane reuse provenance is malformed")
    outcomes_by_name = {
        outcome.get("name"): outcome for outcome in outcomes if isinstance(outcome, dict)
    }
    expected_keys = {
        "name",
        "reuse_key_sha256",
        "source_run_id",
        "source_git_revision",
        "source_receipt_sha256",
    }
    observed: set[str] = set()
    for provenance in reused_lanes:
        if not isinstance(provenance, dict) or set(provenance) != expected_keys:
            raise ValueError("release qualification lane reuse provenance is not closed")
        name = provenance.get("name")
        outcome = outcomes_by_name.get(name)
        if (
            not isinstance(name, str)
            or name in observed
            or name not in RELEASE_QUALIFICATION_COMMANDS
            or not isinstance(outcome, dict)
            or provenance.get("reuse_key_sha256") != outcome.get("reuse_key_sha256")
            or not _safe_run_id(provenance.get("source_run_id"))
            or not isinstance(provenance.get("source_git_revision"), str)
            or re.fullmatch(r"[0-9a-f]{40}", provenance["source_git_revision"]) is None
            or not _is_sha256(provenance.get("source_receipt_sha256"))
        ):
            raise ValueError("release qualification lane reuse provenance is invalid")
        observed.add(name)


def _verify_release_qualification_results(
    root: Path,
    *,
    release: Path,
    contract: ModuleType,
) -> None:
    for command_name in RELEASE_QUALIFICATION_COMMANDS:
        junit_relative = contract.RELEASE_QUALIFICATION_V3_JUNIT_PATHS.get(command_name)
        if junit_relative is None:
            continue
        junit_path = _qualification_regular_file(
            root / junit_relative,
            f"{command_name} JUnit receipt",
            require_sealed=True,
        )
        if junit_path.stat().st_size > contract.MAXIMUM_JUNIT_BYTES:
            raise ValueError(f"{command_name} JUnit receipt exceeds its byte boundary")
        summary = _load_qualification_json(
            root / contract.RELEASE_QUALIFICATION_V3_RESULT_PATHS[command_name],
            f"{command_name} JUnit summary",
            require_sealed=True,
        )
        try:
            contract.validate_pytest_junit_summary_v1(
                summary,
                junit_path.read_bytes(),
                command_name=command_name,
                junit_relative_path=junit_relative,
            )
        except ValueError as error:
            raise ValueError(f"{command_name} JUnit result is invalid: {error}") from error

    staged_web_inventory = _qualification_tree_inventory(
        release / "web/dist",
        "staged compiled web output",
        require_sealed=False,
    )
    web_result = _load_qualification_json(
        root / contract.RELEASE_QUALIFICATION_V3_RESULT_PATHS["production-web-build"],
        "compiled web result",
        require_sealed=True,
    )
    expected_web_result = {
        "schema": RELEASE_QUALIFICATION_SCHEMA,
        "kind": "compiled-web-inventory",
        "files": staged_web_inventory,
    }
    if web_result != expected_web_result:
        raise ValueError("qualified compiled web output differs from the staged release")

    browser_root = root / "results/playwright"
    try:
        browser_root.lstat()
    except FileNotFoundError:
        browser_inventory: list[dict[str, Any]] = []
    else:
        browser_inventory = _qualification_tree_inventory(
            browser_root,
            "Playwright output",
            require_sealed=True,
        )
    browser_result = _load_qualification_json(
        root / contract.RELEASE_QUALIFICATION_V3_RESULT_PATHS["production-chromium-e2e"],
        "production Chromium result",
        require_sealed=True,
    )
    expected_browser_result = {
        "schema": RELEASE_QUALIFICATION_SCHEMA,
        "kind": "production-chromium-e2e-result",
        "project": "production-chromium",
        "passed": True,
        "files": browser_inventory,
    }
    if browser_result != expected_browser_result:
        raise ValueError("production Chromium result inventory is not exact")


def _qualification_timestamp(value: object, label: str) -> datetime:
    if not isinstance(value, str) or not value.endswith("Z"):
        raise ValueError(f"release qualification {label} is not canonical UTC")
    try:
        parsed = datetime.fromisoformat(value.removesuffix("Z") + "+00:00")
    except ValueError as error:
        raise ValueError(f"release qualification {label} is malformed") from error
    canonical = parsed.astimezone(UTC).isoformat(timespec="microseconds").replace("+00:00", "Z")
    if parsed.utcoffset() != UTC.utcoffset(parsed) or canonical != value:
        raise ValueError(f"release qualification {label} is not canonical UTC")
    return parsed


def _require_duration(value: object, expected: float, label: str) -> None:
    if (
        type(value) not in {int, float}
        or not math.isfinite(value)
        or value < 0
        or abs(value - expected) > 0.000001
    ):
        raise ValueError(f"release qualification {label} is inconsistent")


def _safe_run_id(value: object) -> bool:
    return (
        isinstance(value, str)
        and 1 <= len(value) <= 96
        and all(
            character.isascii() and (character.isalnum() or character in "._-")
            for character in value
        )
    )


def _is_sha256(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def command(*argv: str, timeout_seconds: float | None = None) -> str:
    try:
        result = subprocess.run(
            argv,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired as error:
        raise ValueError(f"command timed out after {timeout_seconds} seconds: {argv[0]}") from error
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise ValueError(f"{' '.join(argv)}: {detail}")
    return result.stdout.strip()


def verify_processing_resource_capacity_rows(output: str) -> None:
    """Require the exact post-migration production worker-capacity authority."""

    observed = tuple(output.splitlines())
    if observed != EXPECTED_PROCESSING_RESOURCE_CAPACITY_ROWS:
        raise ValueError(
            "processing resource capacity inventory is not exactly "
            "streaming=16,cpu=8,memory=4,heavy=2"
        )


def probe_processing_resource_capacity() -> None:
    """Read the production catalog through the service account while workers are stopped."""

    output = command(
        "runuser",
        "-u",
        "leo",
        "--",
        "/usr/bin/psql",
        "--no-psqlrc",
        "--set=ON_ERROR_STOP=1",
        "--tuples-only",
        "--no-align",
        "--host=/var/run/postgresql",
        "--port=5432",
        "--username=leo",
        "--no-password",
        "--dbname=leo_tracker",
        "--command",
        PROCESSING_RESOURCE_CAPACITY_QUERY,
        timeout_seconds=15.0,
    )
    verify_processing_resource_capacity_rows(output)


def probe_live_station_radios(
    release: Path,
) -> dict[str, Any]:
    """Read exact live identities through the staged Leo Pluto adapter."""

    output = command(
        "runuser",
        "-u",
        "leo",
        "--",
        str(release / ".venv/bin/python"),
        "-I",
        "-c",
        LIVE_STATION_PROBE_PROGRAM,
        timeout_seconds=30.0,
    )
    try:
        payload = json.loads(output)
    except (TypeError, json.JSONDecodeError) as error:
        raise ValueError("live station radio probe did not return JSON") from error
    if (
        not isinstance(payload, dict)
        or set(payload) != {"schema_version", "radios"}
        or type(payload.get("schema_version")) is not int
        or payload.get("schema_version") != 1
        or not isinstance(payload.get("radios"), list)
        or len(payload["radios"]) != 2
    ):
        raise ValueError("live station radio probe returned a malformed inventory")

    radio_keys = {
        "schema_version",
        "radio_id",
        "serial",
        "uri",
        "transport",
        "firmware_version",
        "metadata_abi_version",
        "buffer_direct_async",
        "buffer_direct_async_exact_kernel_queue",
        "buffer_direct_async_ring",
        "buffer_direct_async_overrun_policies",
        "buffer_direct_async_default_overrun_policy",
        "buffer_ddr_ring_max_iq_bytes",
        "supports_device_sample_counter",
        "supports_continuity_sequence",
    }
    frozen = (
        (
            "radio_pluto_5d4d",
            "1040005e0b100007100010000bf33a5d4d",
            "ip:192.168.1.20",
            "iio_ip",
        ),
        (
            "radio_pluto_19f2",
            "10400056f695001322002d0010ad1719f2",
            "ip:192.168.1.21",
            "iio_ip",
        ),
    )
    for observed, identity in zip(payload["radios"], frozen, strict=True):
        if not isinstance(observed, dict) or set(observed) != radio_keys:
            raise ValueError("live station radio probe returned a malformed radio")
        if (
            type(observed.get("schema_version")) is not int
            or observed.get("schema_version") != 1
            or (
                observed.get("radio_id"),
                observed.get("serial"),
                observed.get("uri"),
                observed.get("transport"),
            )
            != identity
        ):
            raise ValueError("live station radio identity differs from the frozen station pair")
        firmware = observed.get("firmware_version")
        if firmware != "v0.49-plutoplus-spf-iq-direct-async-v4":
            raise ValueError("live station radio firmware is not the exact qualified v0.49")
        if (
            type(observed.get("metadata_abi_version")) is not int
            or observed.get("metadata_abi_version") != 3
        ):
            raise ValueError("live station radio metadata ABI is not exactly 3")
        if (
            observed.get("supports_device_sample_counter") is not True
            or observed.get("supports_continuity_sequence") is not True
        ):
            raise ValueError("live station radio lacks counter-authoritative capabilities")
        if (
            observed.get("buffer_direct_async") is not True
            or observed.get("buffer_direct_async_exact_kernel_queue") is not True
            or observed.get("buffer_direct_async_ring") is not True
            or observed.get("buffer_direct_async_overrun_policies")
            != ["drop-backlog", "preserve-backlog"]
            or observed.get("buffer_direct_async_default_overrun_policy") != "drop-backlog"
            or observed.get("buffer_ddr_ring_max_iq_bytes") != 200_000_000
        ):
            raise ValueError("live station radio does not attest exact-DMA/drop direct-async")
    return payload


def user_systemctl(user: str, *arguments: str) -> subprocess.CompletedProcess[str]:
    uid = pwd.getpwnam(user).pw_uid
    return subprocess.run(
        (
            "runuser",
            "-u",
            user,
            "--",
            "env",
            f"XDG_RUNTIME_DIR=/run/user/{uid}",
            "systemctl",
            "--user",
            *arguments,
        ),
        text=True,
        capture_output=True,
        check=False,
    )


def unexpected_legacy_active_units(output: str) -> tuple[str, ...]:
    """Return active legacy LEO units other than the isolated PostgreSQL host."""

    unexpected = []
    for line in output.splitlines():
        fields = line.split()
        if fields and fields[0] not in ALLOWED_LEGACY_ACTIVE_UNITS:
            unexpected.append(line)
    return tuple(unexpected)


def verify_environment_text(env_text: str, revision: str) -> dict[str, str]:
    for placeholder in (
        "REPLACE-A",
        "REPLACE-B",
        "192.0.2.10",
        "192.0.2.11",
        "REPLACE-PIPELINE-RELEASE-ID",
    ):
        if placeholder in env_text:
            raise ValueError(f"production environment still contains placeholder {placeholder}")
    environment: dict[str, str] = {}
    for raw_line in env_text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise ValueError("production environment contains a malformed line")
        key, value = line.split("=", 1)
        environment[key] = value.strip("'")
    if environment.get("LEO_BULK_ROOT") != "/srv/bulk/leo":
        raise ValueError("LEO_BULK_ROOT is not the canonical local data plane")
    expected_roots = {
        "LEO_QUALIFICATION_ROOT": "/srv/bulk/leo/qualification",
        "LEO_CAPTURE_EVIDENCE_ROOT": "/srv/bulk/leo/qualification/capture",
        "LEO_LEGACY_EVIDENCE_ROOT": "/srv/bulk/leo/qualification/legacy",
    }
    if any(environment.get(key) != value for key, value in expected_roots.items()):
        raise ValueError("production qualification roots are not canonical local paths")
    expected_station_authority = {
        "LEO_STATION_AUTHORITY_ROOT": str(STATION_AUTHORITY_ROOT),
        "LEO_STATION_TOPOLOGY_RELATIVE_PATH": STATION_TOPOLOGY_RELATIVE_PATH,
        "LEO_STATION_TOPOLOGY_FILE_DIGEST": f"sha256:{STATION_TOPOLOGY_FILE_SHA256}",
        "LEO_FIXTURE_PATH_AUTHORITIES_JSON": "[]",
    }
    if any(environment.get(key) != value for key, value in expected_station_authority.items()):
        raise ValueError(
            "production station authority must use the exact reviewed root, topology, "
            "file digest, and empty fixture inventory"
        )
    if environment.get("LEO_PIPELINE_RELEASE_ID") != revision:
        raise ValueError("pipeline release ID must equal the exact staged revision")
    if environment.get("LEO_CAPTURE_PROFILE") != "starlink-ch4-lower-2p5m-60s-native-bandwidth-v4":
        raise ValueError(
            "production capture profile must be the counter-authoritative dual-RX 60-second profile"
        )
    expected_rate_profiles = {
        "LEO_CAPTURE_PROFILE_5M": "starlink-ch4-lower-5m-60s-native-bandwidth-v4",
    }
    if any(environment.get(key) != value for key, value in expected_rate_profiles.items()):
        raise ValueError("production sample-rate profile pool is not the exact reviewed set")
    if environment.get("LEO_CAPTURE_INTERVAL_SECONDS") != "180":
        raise ValueError("production capture interval must be a 180-second start period")
    if environment.get("LEO_MIXED_RATE_POLICY") != (
        "production-direct-async-2p5-10-15-25-hold-exact-lo-6-v2"
    ):
        raise ValueError(
            "production rate policy must be the exact reviewed same-channel "
            "2.5 x 10/15/25 direct-async exact-LO tandem-HOLD rollout policy"
        )
    if environment.get("LEO_DIRECT_ASYNC_ENABLED") != "true":
        raise ValueError("production direct-async feature gate must be enabled")
    expected_capture_modes = {
        "LEO_QUALIFICATION_PROFILE": ("starlink-ch4-lower-2p5m-60s-rx1-centered-continuity-v2"),
        "LEO_SOAK_PROFILE": "starlink-ch4-lower-2p5m-60s-continuity-v2",
    }
    if any(environment.get(key) != value for key, value in expected_capture_modes.items()):
        raise ValueError("qualification and soak profiles must be counter-authoritative V2")
    expected_scanner = {
        "LEO_SCANNER_ENABLED": "false",
        "LEO_SCANNER_RADIO_ID": "radio_pluto_5d4d",
        "LEO_SCANNER_INTERVAL_SECONDS": "1200",
        "LEO_SCANNER_MAXIMUM_LATENESS_SECONDS": "300",
        "LEO_SCANNER_RUN_SECONDS": "300",
        "LEO_SCANNER_DWELL_MS": "120",
        "LEO_SCANNER_GAIN_DB": "40.0",
        "LEO_SCANNER_MARGIN_GATE": "0.025",
        "LEO_SCANNER_REPORT_ROOT": "/srv/bulk/leo/scanner-reports",
    }
    if any(environment.get(key) != value for key, value in expected_scanner.items()):
        raise ValueError("production scanner configuration is not the reviewed V3 deployment")
    try:
        radios = json.loads(environment.get("LEO_RADIOS_JSON", ""))
    except json.JSONDecodeError as error:
        raise ValueError("production radio configuration is invalid JSON") from error
    if not isinstance(radios, list):
        raise ValueError("production radio configuration must contain a list")
    expected_radios = (
        (
            "radio_pluto_5d4d",
            "1040005e0b100007100010000bf33a5d4d",
            "192.168.1.20",
            2,
        ),
        (
            "radio_pluto_19f2",
            "10400056f695001322002d0010ad1719f2",
            "192.168.1.21",
            2,
        ),
    )
    observed_radios = tuple(
        (item.get("radio_id"), item.get("serial"), item.get("host"), item.get("receiver_count"))
        for item in radios
        if isinstance(item, dict)
    )
    if observed_radios != expected_radios or len(radios) != 2:
        raise ValueError("production radio identities do not match the frozen station topology")
    return environment


def _component_environment_revision(component: str, revision: str) -> Path:
    if component == "worker":
        path = WORKER_ENVIRONMENT
        key = "LEO_PIPELINE_RELEASE_ID"
    elif component == "acquisition":
        path = ACQUISITION_ENVIRONMENT
        key = "LEO_ACQUISITION_RELEASE_ID"
    else:
        raise ValueError(f"unsupported narrow component: {component}")
    safe = reject_qnap(path, f"{component} environment")
    if path.is_symlink() or not safe.is_file():
        raise ValueError(f"{component} environment must be a regular non-symlink file")
    mode = safe.stat().st_mode & 0o777
    if mode & 0o007 or mode & 0o020:
        raise ValueError(f"{component} environment permissions are too broad: {mode:o}")
    bindings: list[str] = []
    for raw_line in safe.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise ValueError(f"{component} environment contains a malformed line")
        name, value = line.split("=", 1)
        if name.strip() == key:
            bindings.append(value.strip().strip("'\""))
    if bindings != [revision]:
        raise ValueError(f"{component} environment does not bind the exact target release")
    return safe


def _installed_pipeline_revision(env_text: str) -> str:
    bindings: list[str] = []
    for raw_line in env_text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        if name.strip() == "LEO_PIPELINE_RELEASE_ID":
            bindings.append(value.strip().strip("'\""))
    if len(bindings) != 1 or re.fullmatch(r"[0-9a-f]{40}", bindings[0]) is None:
        raise ValueError("production environment has no unique exact pipeline revision")
    return bindings[0]


def verify_station_authority_install(
    path: Path,
    *,
    expected_uid: int = 0,
    expected_gid: int,
) -> None:
    """Verify the exact installed topology inode used by the runtime loader."""

    safe = reject_qnap(path, "station topology authority")
    if path.absolute().is_symlink() or safe != path.absolute():
        raise ValueError("station topology authority must not use a symlink")
    root = safe.parent
    for candidate, expected_mode, label in (
        (root.parent, 0o750, "station authority parent"),
        (root, 0o750, "station authority root"),
    ):
        metadata = candidate.stat()
        if not stat.S_ISDIR(metadata.st_mode) or candidate.is_symlink():
            raise ValueError(f"{label} must be a regular non-symlink directory")
        if (
            metadata.st_uid != expected_uid
            or metadata.st_gid != expected_gid
            or stat.S_IMODE(metadata.st_mode) != expected_mode
        ):
            raise ValueError(f"{label} ownership or permissions are not exact")
    metadata = safe.stat()
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != expected_uid
        or metadata.st_gid != expected_gid
        or metadata.st_nlink != 1
        or stat.S_IMODE(metadata.st_mode) != 0o440
    ):
        raise ValueError("station topology authority inode is not sealed root-owned 0440")
    if sha256(safe) != STATION_TOPOLOGY_FILE_SHA256:
        raise ValueError("station topology authority file digest mismatch")


def verify_scanner_data_directories(
    root: Path = RUNTIME_DATA_ROOT,
    *,
    expected_uid: int = 0,
    expected_gid: int,
) -> None:
    """Verify scanner evidence destinations before acquisition can start."""

    safe_root = reject_qnap(root, "runtime data root")
    for relative in REQUIRED_SCANNER_DIRECTORIES:
        literal = root / relative
        path = reject_qnap(literal, f"scanner data directory {relative}")
        if literal.absolute().is_symlink() or path != literal.absolute():
            raise ValueError(f"scanner data directory {relative} must not use a symlink")
        try:
            metadata = path.stat()
        except FileNotFoundError as error:
            raise ValueError(f"scanner data directory {relative} is missing") from error
        if (
            safe_root not in path.parents
            or not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != expected_uid
            or metadata.st_gid != expected_gid
            or stat.S_IMODE(metadata.st_mode) != 0o2770
        ):
            raise ValueError(
                f"scanner data directory {relative} ownership or permissions are not exact"
            )


def verify_standard_regression_receipt(
    receipt_path: Path,
    receipt: dict[str, Any],
    *,
    release: Path,
) -> None:
    """Verify the frozen four-path scientific authority for lean cutover."""

    committed_receipt = release / STANDARD_REGRESSION_RECEIPT_RELATIVE_PATH
    committed_summary = release / STANDARD_REGRESSION_SUMMARY_RELATIVE_PATH
    if sha256(receipt_path) != STANDARD_REGRESSION_RECEIPT_SHA256:
        raise ValueError("Standard regression receipt digest is not the reviewed authority")
    if (
        not committed_receipt.is_file()
        or sha256(committed_receipt) != STANDARD_REGRESSION_RECEIPT_SHA256
    ):
        raise ValueError("staged release does not contain the reviewed Standard receipt")
    if (
        not committed_summary.is_file()
        or sha256(committed_summary) != STANDARD_REGRESSION_SUMMARY_SHA256
    ):
        raise ValueError("staged release does not contain the reviewed Standard golden")
    post_freeze = receipt.get("post_freeze_verification")
    invariants = receipt.get("verified_invariants")
    if (
        receipt.get("schema") != "org.leo.standard-real-corpus-review-receipt/v1"
        or receipt.get("fixture_id") != "trial-132-four-path-v1"
        or receipt.get("review_status") != "reviewed_corrected_full_run"
        or receipt.get("golden_summary_sha256") != STANDARD_REGRESSION_SUMMARY_SHA256
        or receipt.get("path_inventory")
        != [["stream-0", 0], ["stream-0", 1], ["stream-1", 0], ["stream-1", 1]]
        or not isinstance(post_freeze, dict)
        or post_freeze.get("result") != "1 passed"
        or post_freeze.get("run_a_sha256") != STANDARD_REGRESSION_OUTPUT_SHA256
        or post_freeze.get("run_b_sha256") != STANDARD_REGRESSION_OUTPUT_SHA256
        or not isinstance(invariants, dict)
        or invariants.get("all_numbers_finite") is not True
        or invariants.get("polynomial_degrees_per_path") != [1, 2, 3]
        or invariants.get("trajectory_ids_unique") is not True
        or invariants.get("selected_trajectories_equal_replayed_representatives") is not True
        or invariants.get("glrt64_feedback_recomputed_exactly") is not True
        or invariants.get("candidate_only") is not True
        or invariants.get("specificity_claimed") is not False
        or invariants.get("payload_decoded") is not False
        or invariants.get("phase_coherent") is not False
    ):
        raise ValueError("Standard regression receipt contents are not the reviewed authority")


def verify_soak_receipt(receipt: dict[str, Any]) -> None:
    """Verify the optional legacy qualification-soak cutover authority."""

    if receipt.get("accepted") is not True:
        raise ValueError("terminal soak acceptance receipt is not accepted")
    if receipt.get("kind") != "soak_acceptance_audit" or receipt.get("schema_version") != 1:
        raise ValueError("terminal soak acceptance receipt has an unsupported contract")
    checks = receipt.get("checks")
    if (
        not isinstance(checks, list)
        or not checks
        or any(not isinstance(item, dict) or item.get("passed") is not True for item in checks)
    ):
        raise ValueError("terminal soak receipt does not contain an all-pass check inventory")


def _is_sha256_digest(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"sha256:[0-9a-f]{64}", value) is not None


_QUALIFICATION_HOST_HEALTH_CHECK_ORDER = (
    "same_host",
    "same_boot",
    "same_disk_path",
    "raid_identity",
    "raid_healthy_before",
    "raid_healthy_after",
    "raid_idle_before",
    "raid_idle_after",
    "kernel_log_complete_before",
    "kernel_log_complete_after",
    "no_kernel_io_errors_before",
    "no_kernel_io_errors_after",
    "no_oom_before",
    "no_oom_after",
    "no_swap_in",
    "no_swap_out",
    "memory_headroom_before",
    "memory_headroom_after",
    "disk_headroom_before",
    "disk_headroom_after",
)
_QUALIFICATION_HOST_HEALTH_CHECK_ORDER_V2 = (
    "same_host",
    "same_boot",
    "same_disk_path",
    "same_disk_mount_source",
    "raid_identity",
    "raid_healthy_before",
    "raid_healthy_after",
    "raid_idle_before",
    "raid_idle_after",
    "kernel_log_complete_before",
    "kernel_log_complete_after",
    "block_device_inventory_unchanged",
    "kernel_io_error_inventory_unchanged",
    "no_relevant_kernel_io_errors_before",
    "no_relevant_kernel_io_errors_after",
    "no_oom_before",
    "no_oom_after",
    "no_swap_in",
    "no_swap_out",
    "memory_headroom_before",
    "memory_headroom_after",
    "disk_headroom_before",
    "disk_headroom_after",
)
_EMPTY_SHA256_DIGEST = "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"


def verify_qualification_host_health_v1(
    evidence: object,
    *,
    expected_host_name: str,
    receipt_created_utc_ns: int,
) -> None:
    """Verify the exact read-only pre/post host-health gate bound by V4."""

    evidence_keys = {
        "schema_version",
        "algorithm_version",
        "policy",
        "before",
        "after",
        "checks",
        "passed",
        "evidence_digest",
    }
    if (
        not isinstance(evidence, dict)
        or set(evidence) != evidence_keys
        or type(evidence.get("schema_version")) is not int
        or evidence.get("schema_version") != 1
        or evidence.get("algorithm_version") != "qualification-host-health-pre-post-v1"
        or evidence.get("passed") is not True
        or not _is_sha256_digest(evidence.get("evidence_digest"))
    ):
        raise ValueError("V4 host-health prerequisite is not an exact passing V1 gate")

    expected_policy = {
        "schema_version": 1,
        "raid_array_name": "md127",
        "disk_path": "/srv/bulk",
        "minimum_available_memory_bytes": 32 * 1024**3,
        "minimum_free_disk_bytes": 1024**4,
    }
    policy = evidence.get("policy")
    if (
        not isinstance(policy, dict)
        or set(policy) != set(expected_policy)
        or any(
            type(policy.get(key)) is not type(value) or policy.get(key) != value
            for key, value in expected_policy.items()
        )
    ):
        raise ValueError("V4 host-health prerequisite does not use the reviewed host policy")

    snapshot_keys = {
        "schema_version",
        "algorithm_version",
        "host_name",
        "boot_id",
        "observed_utc_ns",
        "observed_monotonic_ns",
        "raid",
        "kernel_log_complete",
        "kernel_io_error_count",
        "kernel_io_error_log_digest",
        "oom_kill_count",
        "swap_in_pages",
        "swap_out_pages",
        "available_memory_bytes",
        "disk_path",
        "free_disk_bytes",
        "mdstat_digest",
        "meminfo_digest",
        "vmstat_digest",
        "snapshot_digest",
    }
    raid_keys = {
        "schema_version",
        "array_name",
        "raid_level",
        "active",
        "expected_member_count",
        "active_member_count",
        "member_status",
        "active_operation",
        "healthy",
    }
    digest_fields = (
        "kernel_io_error_log_digest",
        "mdstat_digest",
        "meminfo_digest",
        "vmstat_digest",
        "snapshot_digest",
    )

    def exact_snapshot(value: object) -> bool:
        if not isinstance(value, dict) or set(value) != snapshot_keys:
            return False
        raid = value.get("raid")
        if not isinstance(raid, dict) or set(raid) != raid_keys:
            return False
        expected_members = raid.get("expected_member_count")
        snapshot_without_digest = {
            key: item for key, item in value.items() if key != "snapshot_digest"
        }
        return (
            type(value.get("schema_version")) is int
            and value.get("schema_version") == 1
            and value.get("algorithm_version") == "qualification-host-health-snapshot-v1"
            and value.get("host_name") == expected_host_name
            and isinstance(value.get("boot_id"), str)
            and re.fullmatch(
                r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
                value["boot_id"],
            )
            is not None
            and type(value.get("observed_utc_ns")) is int
            and value["observed_utc_ns"] > 0
            and type(value.get("observed_monotonic_ns")) is int
            and value["observed_monotonic_ns"] > 0
            and value.get("kernel_log_complete") is True
            and type(value.get("kernel_io_error_count")) is int
            and value.get("kernel_io_error_count") == 0
            and value.get("kernel_io_error_log_digest") == _EMPTY_SHA256_DIGEST
            and type(value.get("oom_kill_count")) is int
            and value.get("oom_kill_count") == 0
            and type(value.get("swap_in_pages")) is int
            and value["swap_in_pages"] >= 0
            and type(value.get("swap_out_pages")) is int
            and value["swap_out_pages"] >= 0
            and type(value.get("available_memory_bytes")) is int
            and value["available_memory_bytes"] >= 32 * 1024**3
            and value.get("disk_path") == "/srv/bulk"
            and type(value.get("free_disk_bytes")) is int
            and value["free_disk_bytes"] >= 1024**4
            and all(_is_sha256_digest(value.get(key)) for key in digest_fields)
            and value.get("snapshot_digest") == canonical_json_sha256(snapshot_without_digest)
            and type(raid.get("schema_version")) is int
            and raid.get("schema_version") == 1
            and raid.get("array_name") == "md127"
            and isinstance(raid.get("raid_level"), str)
            and bool(raid["raid_level"])
            and raid.get("active") is True
            and type(expected_members) is int
            and 1 <= expected_members <= 256
            and type(raid.get("active_member_count")) is int
            and raid.get("active_member_count") == expected_members
            and raid.get("member_status") == "U" * expected_members
            and raid.get("active_operation") == "none"
            and raid.get("healthy") is True
        )

    before = evidence.get("before")
    after = evidence.get("after")
    if not exact_snapshot(before) or not exact_snapshot(after):
        raise ValueError("V4 host-health prerequisite contains a malformed or failing snapshot")
    if not isinstance(before, dict) or not isinstance(after, dict):
        raise ValueError("V4 host-health prerequisite contains a malformed or failing snapshot")
    before_raid = before["raid"]
    after_raid = after["raid"]
    if not isinstance(before_raid, dict) or not isinstance(after_raid, dict):
        raise ValueError("V4 host-health prerequisite contains a malformed or failing snapshot")
    if (
        after["observed_utc_ns"] < before["observed_utc_ns"]
        or after["observed_utc_ns"] > receipt_created_utc_ns
        or after["observed_monotonic_ns"] < before["observed_monotonic_ns"]
        or after["boot_id"] != before["boot_id"]
        or after["disk_path"] != before["disk_path"]
        or after["swap_in_pages"] != before["swap_in_pages"]
        or after["swap_out_pages"] != before["swap_out_pages"]
        or (
            after_raid["array_name"],
            after_raid["raid_level"],
            after_raid["expected_member_count"],
        )
        != (
            before_raid["array_name"],
            before_raid["raid_level"],
            before_raid["expected_member_count"],
        )
    ):
        raise ValueError("V4 host-health prerequisite does not close one host run")

    checks = evidence.get("checks")
    check_keys = {"schema_version", "name", "passed"}
    if (
        not isinstance(checks, list)
        or len(checks) != len(_QUALIFICATION_HOST_HEALTH_CHECK_ORDER)
        or any(
            not isinstance(check, dict)
            or set(check) != check_keys
            or type(check.get("schema_version")) is not int
            or check.get("schema_version") != 1
            or check.get("name") != name
            or check.get("passed") is not True
            for check, name in zip(
                checks,
                _QUALIFICATION_HOST_HEALTH_CHECK_ORDER,
                strict=True,
            )
        )
    ):
        raise ValueError("V4 host-health prerequisite check inventory is not exact and all-pass")

    evidence_without_digest = {
        key: value for key, value in evidence.items() if key != "evidence_digest"
    }
    if evidence.get("evidence_digest") != canonical_json_sha256(evidence_without_digest):
        raise ValueError("V4 host-health prerequisite digest does not bind its evidence")


def verify_qualification_host_health_v2(
    evidence: object,
    *,
    expected_host_name: str,
    receipt_created_utc_ns: int,
) -> dict[str, Any]:
    """Verify scoped V2 host evidence without excusing new removable-device errors."""

    evidence_keys = {
        "schema_version",
        "algorithm_version",
        "policy",
        "before",
        "after",
        "checks",
        "passed",
        "evidence_digest",
    }
    if (
        not isinstance(evidence, dict)
        or set(evidence) != evidence_keys
        or type(evidence.get("schema_version")) is not int
        or evidence.get("schema_version") != 2
        or evidence.get("algorithm_version") != "qualification-host-health-pre-post-v2"
        or evidence.get("passed") is not True
        or not _is_sha256_digest(evidence.get("evidence_digest"))
    ):
        raise ValueError("V5 host-health prerequisite is not an exact passing V2 gate")
    expected_policy = {
        "schema_version": 2,
        "raid_array_name": "md127",
        "disk_path": "/srv/bulk",
        "required_disk_mount_source": "/dev/mapper/vg_bulk-bulk",
        "minimum_available_memory_bytes": 32 * 1024**3,
        "minimum_free_disk_bytes": 1024**4,
    }
    policy = evidence.get("policy")
    if (
        not isinstance(policy, dict)
        or set(policy) != set(expected_policy)
        or any(
            type(policy.get(key)) is not type(value) or policy.get(key) != value
            for key, value in expected_policy.items()
        )
    ):
        raise ValueError("V5 host-health prerequisite does not use the reviewed scoped policy")

    snapshot_keys = {
        "schema_version",
        "algorithm_version",
        "base",
        "disk_mount_source",
        "block_devices",
        "kernel_io_errors",
        "relevant_kernel_io_error_count",
        "ignored_removable_kernel_io_error_count",
        "snapshot_digest",
    }
    base_snapshot_keys = {
        "schema_version",
        "algorithm_version",
        "host_name",
        "boot_id",
        "observed_utc_ns",
        "observed_monotonic_ns",
        "raid",
        "kernel_log_complete",
        "kernel_io_error_count",
        "kernel_io_error_log_digest",
        "oom_kill_count",
        "swap_in_pages",
        "swap_out_pages",
        "available_memory_bytes",
        "disk_path",
        "free_disk_bytes",
        "mdstat_digest",
        "meminfo_digest",
        "vmstat_digest",
        "snapshot_digest",
    }
    device_keys = {"schema_version", "name", "major_minor", "removable", "protected"}
    error_keys = {"schema_version", "line", "line_sha256", "block_devices", "disposition"}

    def exact_snapshot(value: object) -> bool:
        if not isinstance(value, dict) or set(value) != snapshot_keys:
            return False
        base = value.get("base")
        devices = value.get("block_devices")
        errors = value.get("kernel_io_errors")
        if (
            not isinstance(base, dict)
            or set(base) != base_snapshot_keys
            or not isinstance(devices, list)
            or not devices
            or not isinstance(errors, list)
        ):
            return False
        names: list[str] = []
        by_name: dict[str, dict[str, object]] = {}
        for device in devices:
            if (
                not isinstance(device, dict)
                or set(device) != device_keys
                or type(device.get("schema_version")) is not int
                or device.get("schema_version") != 1
                or not isinstance(device.get("name"), str)
                or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,127}", device["name"]) is None
                or not isinstance(device.get("major_minor"), str)
                or re.fullmatch(r"[0-9]+:[0-9]+", device["major_minor"]) is None
                or type(device.get("removable")) is not bool
                or type(device.get("protected")) is not bool
                or (device["protected"] and device["removable"])
            ):
                return False
            name = device["name"]
            names.append(name)
            by_name[name] = device
        if names != sorted(set(names)) or not any(device["protected"] for device in devices):
            return False

        normalized_lines: list[str] = []
        relevant = 0
        ignored = 0
        for error in errors:
            if (
                not isinstance(error, dict)
                or set(error) != error_keys
                or type(error.get("schema_version")) is not int
                or error.get("schema_version") != 1
                or not isinstance(error.get("line"), str)
                or not 1 <= len(error["line"]) <= 4096
                or error.get("line_sha256")
                != "sha256:" + hashlib.sha256(error["line"].encode("utf-8")).hexdigest()
                or not isinstance(error.get("block_devices"), list)
                or any(not isinstance(name, str) for name in error["block_devices"])
                or error["block_devices"] != sorted(set(error["block_devices"]))
            ):
                return False
            referenced = tuple(by_name.get(name) for name in error["block_devices"])
            safely_ignored = bool(referenced) and all(
                item is not None and item["removable"] and not item["protected"]
                for item in referenced
            )
            expected_disposition = "ignored_preexisting_removable" if safely_ignored else "relevant"
            if error.get("disposition") != expected_disposition:
                return False
            relevant += expected_disposition == "relevant"
            ignored += expected_disposition == "ignored_preexisting_removable"
            normalized_lines.append(error["line"])
        normalized = "\n".join(normalized_lines).encode("utf-8")
        snapshot_without_digest = {
            key: item for key, item in value.items() if key != "snapshot_digest"
        }
        base_without_digest = {key: item for key, item in base.items() if key != "snapshot_digest"}
        return (
            type(value.get("schema_version")) is int
            and value.get("schema_version") == 2
            and value.get("algorithm_version") == "qualification-host-health-snapshot-v2"
            and value.get("disk_mount_source") == "/dev/mapper/vg_bulk-bulk"
            and type(value.get("relevant_kernel_io_error_count")) is int
            and value.get("relevant_kernel_io_error_count") == relevant
            and relevant == 0
            and type(value.get("ignored_removable_kernel_io_error_count")) is int
            and value.get("ignored_removable_kernel_io_error_count") == ignored
            and type(base.get("kernel_io_error_count")) is int
            and base.get("kernel_io_error_count") == len(errors)
            and base.get("kernel_io_error_log_digest")
            == "sha256:" + hashlib.sha256(normalized).hexdigest()
            and base.get("snapshot_digest") == canonical_json_sha256(base_without_digest)
            and value.get("snapshot_digest") == canonical_json_sha256(snapshot_without_digest)
        )

    before = evidence.get("before")
    after = evidence.get("after")
    if not exact_snapshot(before) or not exact_snapshot(after):
        raise ValueError("V5 host-health prerequisite contains malformed scoped evidence")
    if not isinstance(before, dict) or not isinstance(after, dict):
        raise ValueError("V5 host-health prerequisite contains malformed scoped evidence")
    before_base = before["base"]
    after_base = after["base"]
    if not isinstance(before_base, dict) or not isinstance(after_base, dict):
        raise ValueError("V5 host-health prerequisite contains malformed scoped evidence")

    # Reuse the frozen V1 verifier for every non-kernel host fact. The synthetic
    # zero-error view is internal only; V2 error bytes/classification remain bound
    # and are verified independently above and below.
    synthetic_before = dict(before_base)
    synthetic_after = dict(after_base)
    for snapshot in (synthetic_before, synthetic_after):
        snapshot["kernel_io_error_count"] = 0
        snapshot["kernel_io_error_log_digest"] = _EMPTY_SHA256_DIGEST
        snapshot["snapshot_digest"] = canonical_json_sha256(
            {key: item for key, item in snapshot.items() if key != "snapshot_digest"}
        )
    synthetic_checks = [
        {"schema_version": 1, "name": name, "passed": True}
        for name in _QUALIFICATION_HOST_HEALTH_CHECK_ORDER
    ]
    synthetic_v1 = {
        "schema_version": 1,
        "algorithm_version": "qualification-host-health-pre-post-v1",
        "policy": {
            "schema_version": 1,
            "raid_array_name": "md127",
            "disk_path": "/srv/bulk",
            "minimum_available_memory_bytes": 32 * 1024**3,
            "minimum_free_disk_bytes": 1024**4,
        },
        "before": synthetic_before,
        "after": synthetic_after,
        "checks": synthetic_checks,
        "passed": True,
    }
    synthetic_v1["evidence_digest"] = canonical_json_sha256(synthetic_v1)
    verify_qualification_host_health_v1(
        synthetic_v1,
        expected_host_name=expected_host_name,
        receipt_created_utc_ns=receipt_created_utc_ns,
    )

    if (
        before.get("disk_mount_source") != after.get("disk_mount_source")
        or before.get("block_devices") != after.get("block_devices")
        or before.get("kernel_io_errors") != after.get("kernel_io_errors")
    ):
        raise ValueError("V5 host-health prerequisite changed storage or kernel error inventory")

    checks = evidence.get("checks")
    if (
        not isinstance(checks, list)
        or len(checks) != len(_QUALIFICATION_HOST_HEALTH_CHECK_ORDER_V2)
        or any(
            not isinstance(check, dict)
            or set(check) != {"schema_version", "name", "passed"}
            or type(check.get("schema_version")) is not int
            or check.get("schema_version") != 2
            or check.get("name") != name
            or check.get("passed") is not True
            for check, name in zip(
                checks,
                _QUALIFICATION_HOST_HEALTH_CHECK_ORDER_V2,
                strict=True,
            )
        )
    ):
        raise ValueError("V5 host-health prerequisite check inventory is not exact and all-pass")
    evidence_without_digest = {
        key: value for key, value in evidence.items() if key != "evidence_digest"
    }
    if evidence.get("evidence_digest") != canonical_json_sha256(evidence_without_digest):
        raise ValueError("V5 host-health prerequisite digest does not bind its evidence")
    return synthetic_v1


def _matches_lossless_radio_metrics(
    value: object,
    *,
    radio_id: str,
    sample_count: int,
) -> bool:
    if not isinstance(value, dict):
        return False
    expected = {
        "schema_version": 1,
        "radio_id": radio_id,
        "requested_sample_count": sample_count,
        "observed_sample_count": sample_count,
        "device_span_sample_count": sample_count,
        "observed_gap_count": 0,
        "observed_missing_sample_count": 0,
        "observed_overflow_count": 0,
        "enqueue_failure_count": 0,
    }
    integer_fields = set(expected) - {"radio_id"}
    return value == expected and all(type(value.get(key)) is int for key in integer_fields)


def verify_contiguous_rate_3m_prerequisites(
    prerequisites: object,
    *,
    radio_ids: tuple[str, str],
) -> None:
    """Verify the complete ordered safety and capacity gate for 3 MS/s trials."""

    if (
        not isinstance(prerequisites, dict)
        or set(prerequisites)
        != {
            "schema_version",
            "radio_safety",
            "native_ip_canaries",
            "usb_control_arm",
            "writer_benchmark",
        }
        or type(prerequisites.get("schema_version")) is not int
        or prerequisites.get("schema_version") != 2
    ):
        raise ValueError("3 MS/s receipt prerequisites have an unsupported contract")

    safety = prerequisites.get("radio_safety")
    safety_keys = {
        "schema_version",
        "radio_id",
        "pre_safety_evidence_sha256",
        "post_safety_evidence_sha256",
        "pre_tx_safe",
        "post_tx_safe",
        "rx_settings_restored",
        "passed",
    }
    if not isinstance(safety, list) or len(safety) != 2:
        raise ValueError("3 MS/s radio safety prerequisites are not exact ordered passes")
    for item, radio_id in zip(safety, radio_ids, strict=True):
        if (
            not isinstance(item, dict)
            or set(item) != safety_keys
            or type(item.get("schema_version")) is not int
            or item.get("schema_version") != 1
            or item.get("radio_id") != radio_id
            or not _is_sha256_digest(item.get("pre_safety_evidence_sha256"))
            or not _is_sha256_digest(item.get("post_safety_evidence_sha256"))
            or item.get("pre_tx_safe") is not True
            or item.get("post_tx_safe") is not True
            or item.get("rx_settings_restored") is not True
            or item.get("passed") is not True
        ):
            raise ValueError("3 MS/s radio safety prerequisites are not exact ordered passes")

    canaries = prerequisites.get("native_ip_canaries")
    canary_keys = {
        "schema_version",
        "transport",
        "duration_ns",
        "sample_rate_hz",
        "bandwidth_hz",
        "evidence_sha256",
        "metrics",
        "passed",
    }
    if not isinstance(canaries, list) or len(canaries) != 2:
        raise ValueError("3 MS/s native-IP canaries are not exact one-second lossless prefixes")
    for item, radio_id in zip(canaries, radio_ids, strict=True):
        if (
            not isinstance(item, dict)
            or set(item) != canary_keys
            or type(item.get("schema_version")) is not int
            or item.get("schema_version") != 1
            or item.get("transport") != "iio_ip"
            or type(item.get("duration_ns")) is not int
            or item.get("duration_ns") != 1_000_000_000
            or type(item.get("sample_rate_hz")) is not int
            or item.get("sample_rate_hz") != 3_000_000
            or type(item.get("bandwidth_hz")) is not int
            or item.get("bandwidth_hz") != 2_500_000
            or not _is_sha256_digest(item.get("evidence_sha256"))
            or not _matches_lossless_radio_metrics(
                item.get("metrics"),
                radio_id=radio_id,
                sample_count=3_000_000,
            )
            or item.get("passed") is not True
        ):
            raise ValueError("3 MS/s native-IP canaries are not exact one-second lossless prefixes")

    usb = prerequisites.get("usb_control_arm")
    usb_keys = {
        "schema_version",
        "transport",
        "simultaneous",
        "duration_ns",
        "sample_rate_hz",
        "bandwidth_hz",
        "evidence_sha256",
        "minimum_overlap_fraction",
        "radios",
        "capture_intervals",
        "radio_restoration",
        "radio_metrics",
        "passed",
    }
    usb_radios = usb.get("radios") if isinstance(usb, dict) else None
    usb_intervals = usb.get("capture_intervals") if isinstance(usb, dict) else None
    usb_restoration = usb.get("radio_restoration") if isinstance(usb, dict) else None
    usb_metrics = usb.get("radio_metrics") if isinstance(usb, dict) else None
    usb_identity_keys = {
        "schema_version",
        "radio_id",
        "serial",
        "uri",
        "transport",
        "model",
        "firmware_version",
        "hardware_revision",
    }
    usb_identities_valid = isinstance(usb_radios, list) and len(usb_radios) == 2
    if usb_identities_valid:
        for identity, (radio_id, serial) in zip(
            usb_radios,
            CONTIGUOUS_RATE_USB_CONTROL_RADIOS,
            strict=True,
        ):
            usb_identities_valid = usb_identities_valid and (
                isinstance(identity, dict)
                and set(identity) == usb_identity_keys
                and type(identity.get("schema_version")) is int
                and identity.get("schema_version") == 2
                and identity.get("radio_id") == radio_id
                and identity.get("serial") == serial
                and isinstance(identity.get("uri"), str)
                and identity["uri"].startswith("usb:")
                and identity.get("transport") == "iio_usb"
                and isinstance(identity.get("model"), str)
                and bool(identity["model"])
                and isinstance(identity.get("firmware_version"), str)
                and bool(identity["firmware_version"])
                and (
                    identity.get("hardware_revision") is None
                    or isinstance(identity.get("hardware_revision"), str)
                )
            )
    interval_keys = {
        "schema_version",
        "radio_id",
        "started_monotonic_ns",
        "ended_monotonic_ns",
    }
    usb_intervals_valid = isinstance(usb_intervals, list) and len(usb_intervals) == 2
    if usb_intervals_valid:
        for interval, (radio_id, _) in zip(
            usb_intervals,
            CONTIGUOUS_RATE_USB_CONTROL_RADIOS,
            strict=True,
        ):
            started = interval.get("started_monotonic_ns") if isinstance(interval, dict) else None
            ended = interval.get("ended_monotonic_ns") if isinstance(interval, dict) else None
            usb_intervals_valid = usb_intervals_valid and (
                isinstance(interval, dict)
                and set(interval) == interval_keys
                and type(interval.get("schema_version")) is int
                and interval.get("schema_version") == 2
                and interval.get("radio_id") == radio_id
                and type(started) is int
                and type(ended) is int
                and started >= 0
                and ended > started
            )
    overlap_ns = (
        min(item["ended_monotonic_ns"] for item in usb_intervals)
        - max(item["started_monotonic_ns"] for item in usb_intervals)
        if usb_intervals_valid
        else -1
    )
    restoration_keys = {
        "schema_version",
        "radio_id",
        "pre_settings_evidence_sha256",
        "post_settings_evidence_sha256",
        "rx_settings_restored",
        "passed",
    }
    usb_restoration_valid = isinstance(usb_restoration, list) and len(usb_restoration) == 2
    if usb_restoration_valid:
        for restoration, (radio_id, _) in zip(
            usb_restoration,
            CONTIGUOUS_RATE_USB_CONTROL_RADIOS,
            strict=True,
        ):
            usb_restoration_valid = usb_restoration_valid and (
                isinstance(restoration, dict)
                and set(restoration) == restoration_keys
                and type(restoration.get("schema_version")) is int
                and restoration.get("schema_version") == 2
                and restoration.get("radio_id") == radio_id
                and _is_sha256_digest(restoration.get("pre_settings_evidence_sha256"))
                and _is_sha256_digest(restoration.get("post_settings_evidence_sha256"))
                and restoration.get("rx_settings_restored") is True
                and restoration.get("passed") is True
            )
    if (
        not isinstance(usb, dict)
        or set(usb) != usb_keys
        or type(usb.get("schema_version")) is not int
        or usb.get("schema_version") != 2
        or usb.get("transport") != "iio_usb"
        or usb.get("simultaneous") is not True
        or type(usb.get("duration_ns")) is not int
        or usb.get("duration_ns") != 60_000_000_000
        or type(usb.get("sample_rate_hz")) is not int
        or usb.get("sample_rate_hz") != 3_000_000
        or type(usb.get("bandwidth_hz")) is not int
        or usb.get("bandwidth_hz") != 2_500_000
        or not _is_sha256_digest(usb.get("evidence_sha256"))
        or type(usb.get("minimum_overlap_fraction")) is not float
        or usb.get("minimum_overlap_fraction") != 0.99
        or not usb_identities_valid
        or not usb_intervals_valid
        or overlap_ns * 100 < 60_000_000_000 * 99
        or not usb_restoration_valid
        or not isinstance(usb_metrics, list)
        or len(usb_metrics) != 2
        or any(
            not _matches_lossless_radio_metrics(
                metrics,
                radio_id=radio_id,
                sample_count=180_000_000,
            )
            for metrics, (radio_id, _) in zip(
                usb_metrics,
                CONTIGUOUS_RATE_USB_CONTROL_RADIOS,
                strict=True,
            )
        )
        or usb.get("passed") is not True
    ):
        raise ValueError(
            "3 MS/s USB control arm is not an exact simultaneous 60-second lossless prefix"
        )

    writer = prerequisites.get("writer_benchmark")
    writer_keys = {
        "schema_version",
        "payload_kind",
        "evidence_sha256",
        "uncompressed_bytes_written",
        "elapsed_ns",
        "sustained_bytes_per_second",
        "passed",
    }
    written = writer.get("uncompressed_bytes_written") if isinstance(writer, dict) else None
    elapsed = writer.get("elapsed_ns") if isinstance(writer, dict) else None
    sustained = writer.get("sustained_bytes_per_second") if isinstance(writer, dict) else None
    measured = (
        written * 1_000_000_000 // elapsed
        if type(written) is int and type(elapsed) is int and written > 0 and elapsed > 0
        else None
    )
    if (
        not isinstance(writer, dict)
        or set(writer) != writer_keys
        or type(writer.get("schema_version")) is not int
        or writer.get("schema_version") != 1
        or writer.get("payload_kind") != "incompressible"
        or not _is_sha256_digest(writer.get("evidence_sha256"))
        or measured is None
        or type(sustained) is not int
        or sustained != measured
        or sustained < 72_000_000
        or writer.get("passed") is not True
    ):
        raise ValueError(
            "3 MS/s writer prerequisite is not an exact passing incompressible 72 MB/s result"
        )


def verify_contiguous_rate_3m_prerequisites_v3(
    prerequisites: object,
    *,
    radio_ids: tuple[str, str],
) -> None:
    """Verify the V3 host/native-radio safety and capacity gate."""

    if (
        not isinstance(prerequisites, dict)
        or set(prerequisites)
        != {
            "schema_version",
            "radio_safety",
            "native_ip_canaries",
            "writer_benchmark",
        }
        or type(prerequisites.get("schema_version")) is not int
        or prerequisites.get("schema_version") != 3
    ):
        raise ValueError("3 MS/s receipt prerequisites have an unsupported contract")

    safety = prerequisites.get("radio_safety")
    safety_keys = {
        "schema_version",
        "radio_id",
        "pre_safety_evidence_sha256",
        "post_safety_evidence_sha256",
        "pre_tx_safe",
        "post_tx_safe",
        "rx_settings_restored",
        "passed",
    }
    if not isinstance(safety, list) or len(safety) != 2:
        raise ValueError("3 MS/s radio safety prerequisites are not exact ordered passes")
    for item, radio_id in zip(safety, radio_ids, strict=True):
        if (
            not isinstance(item, dict)
            or set(item) != safety_keys
            or type(item.get("schema_version")) is not int
            or item.get("schema_version") != 1
            or item.get("radio_id") != radio_id
            or not _is_sha256_digest(item.get("pre_safety_evidence_sha256"))
            or not _is_sha256_digest(item.get("post_safety_evidence_sha256"))
            or item.get("pre_tx_safe") is not True
            or item.get("post_tx_safe") is not True
            or item.get("rx_settings_restored") is not True
            or item.get("passed") is not True
        ):
            raise ValueError("3 MS/s radio safety prerequisites are not exact ordered passes")

    canaries = prerequisites.get("native_ip_canaries")
    canary_keys = {
        "schema_version",
        "transport",
        "duration_ns",
        "sample_rate_hz",
        "bandwidth_hz",
        "evidence_sha256",
        "metrics",
        "passed",
    }
    if not isinstance(canaries, list) or len(canaries) != 2:
        raise ValueError("3 MS/s native-IP canaries are not exact one-second lossless prefixes")
    for item, radio_id in zip(canaries, radio_ids, strict=True):
        if (
            not isinstance(item, dict)
            or set(item) != canary_keys
            or type(item.get("schema_version")) is not int
            or item.get("schema_version") != 1
            or item.get("transport") != "iio_ip"
            or type(item.get("duration_ns")) is not int
            or item.get("duration_ns") != 1_000_000_000
            or type(item.get("sample_rate_hz")) is not int
            or item.get("sample_rate_hz") != 3_000_000
            or type(item.get("bandwidth_hz")) is not int
            or item.get("bandwidth_hz") != 2_500_000
            or not _is_sha256_digest(item.get("evidence_sha256"))
            or not _matches_lossless_radio_metrics(
                item.get("metrics"),
                radio_id=radio_id,
                sample_count=3_000_000,
            )
            or item.get("passed") is not True
        ):
            raise ValueError("3 MS/s native-IP canaries are not exact one-second lossless prefixes")

    writer = prerequisites.get("writer_benchmark")
    writer_keys = {
        "schema_version",
        "payload_kind",
        "evidence_sha256",
        "uncompressed_bytes_written",
        "elapsed_ns",
        "sustained_bytes_per_second",
        "passed",
    }
    written = writer.get("uncompressed_bytes_written") if isinstance(writer, dict) else None
    elapsed = writer.get("elapsed_ns") if isinstance(writer, dict) else None
    sustained = writer.get("sustained_bytes_per_second") if isinstance(writer, dict) else None
    measured = (
        written * 1_000_000_000 // elapsed
        if type(written) is int and type(elapsed) is int and written > 0 and elapsed > 0
        else None
    )
    if (
        not isinstance(writer, dict)
        or set(writer) != writer_keys
        or type(writer.get("schema_version")) is not int
        or writer.get("schema_version") != 1
        or writer.get("payload_kind") != "incompressible"
        or not _is_sha256_digest(writer.get("evidence_sha256"))
        or measured is None
        or type(sustained) is not int
        or sustained != measured
        or sustained < 72_000_000
        or writer.get("passed") is not True
    ):
        raise ValueError(
            "3 MS/s writer prerequisite is not an exact passing incompressible 72 MB/s result"
        )


def _verify_contiguous_rate_3m_receipt(
    receipt: dict[str, Any],
    *,
    revision: str,
    release: Path,
    schema_version: int,
) -> None:
    """Verify the exact station-bound authority for the 3 MS/s pool member."""

    target = receipt.get("target")
    if (
        receipt.get("kind") != "contiguous_rate_qualification"
        or receipt.get("schema_version") != schema_version
        or receipt.get("complete") is not True
        or receipt.get("passed") is not True
        or not isinstance(target, dict)
    ):
        raise ValueError("3 MS/s continuity receipt is not a complete strict pass")
    created_utc_ns = receipt.get("created_utc_ns")
    if type(created_utc_ns) is not int:
        raise ValueError("3 MS/s receipt created_utc_ns is missing or not an actual integer")
    now_utc_ns = time.time_ns()
    if created_utc_ns > now_utc_ns + RATE_RECEIPT_MAXIMUM_FUTURE_SKEW_NS:
        raise ValueError("3 MS/s receipt creation time is more than five minutes in the future")
    if created_utc_ns < now_utc_ns - RATE_RECEIPT_MAXIMUM_AGE_NS:
        raise ValueError("3 MS/s receipt creation time is older than 24 hours")
    policy = target.get("policy")
    expected_policy = {
        "schema_version": 1,
        "required_trial_count": 10,
        "minimum_overlap_fraction": 0.99,
        "required_kernel_buffers": 8,
        "required_queue_capacity_refills": 32,
        "maximum_queue_high_water_fraction": 0.75,
        "required_metadata_abi_version": 1,
        "maximum_refill_service_interval_ns": 699_050_666,
        "required_tags": ["QUALIFICATION"],
    }
    expected_target_values = {
        "schema_version": schema_version,
        "qualification_id": f"native-ip-3m-{revision[:12]}",
        "profile_revision_digest": CONTIGUOUS_RATE_3M_PROFILE_DIGEST,
        "capture_plan_digest": CONTIGUOUS_RATE_3M_PLAN_DIGEST,
        "sample_rate_hz": 3_000_000,
        "bandwidth_hz": 2_500_000,
        "requested_sample_count": 180_000_000,
        "native_network_interface": "enp132s0",
        "native_source_address": "192.168.1.142",
    }
    if any(target.get(key) != value for key, value in expected_target_values.items()):
        raise ValueError("3 MS/s continuity target differs from the reviewed station canary")
    if policy != expected_policy:
        raise ValueError("3 MS/s continuity policy differs from the strict ten-trial gate")

    with (release / "pyproject.toml").open("rb") as stream:
        project = tomllib.load(stream)
    metadata_runtime_path = release / ".venv/share/pluto-plus-utils/metadata-runtime.json"
    try:
        metadata_runtime = json.loads(metadata_runtime_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ValueError("staged release metadata runtime receipt is unreadable") from error
    if (
        not isinstance(metadata_runtime, dict)
        or metadata_runtime.get("schema_version") != 1
        or metadata_runtime.get("metadata_abi") != 1
    ):
        raise ValueError("staged release metadata runtime is not ABI 1")
    expected_ppu = project["tool"]["uv"]["sources"]["pluto-plus-utils"]["rev"]
    producer = target.get("expected_producer")
    if (
        target.get("pluto_plus_utils_revision") != expected_ppu
        or not isinstance(producer, dict)
        or producer.get("name") != "leo-acquisition"
        or producer.get("version") != project["project"]["version"]
        or producer.get("source_revision") != revision
    ):
        raise ValueError("3 MS/s receipt software identity differs from the staged release")
    expected_runtime = {
        "libiio_version": metadata_runtime.get("libiio_version"),
        "libiio_library_sha256": "sha256:" + str(metadata_runtime.get("native_libiio_sha256")),
        "python_iio_sha256": "sha256:" + str(metadata_runtime.get("pylibiio_sha256")),
    }
    if any(target.get(key) != value for key, value in expected_runtime.items()) or any(
        re.fullmatch(r"sha256:[0-9a-f]{64}", str(expected_runtime[key])) is None
        for key in ("libiio_library_sha256", "python_iio_sha256")
    ):
        raise ValueError("3 MS/s receipt libiio identity differs from the staged runtime")

    expected_radios = (
        (
            "radio_pluto_5d4d",
            "1040005e0b100007100010000bf33a5d4d",
            "ip:192.168.1.20",
            "iio_ip",
        ),
        (
            "radio_pluto_19f2",
            "10400056f695001322002d0010ad1719f2",
            "ip:192.168.1.21",
            "iio_ip",
        ),
    )
    radios = target.get("expected_radios")
    if not isinstance(radios, list) or len(radios) != 2:
        raise ValueError("3 MS/s receipt must bind exactly two radios")
    observed_radios = tuple(
        (item.get("radio_id"), item.get("serial"), item.get("uri"), item.get("transport"))
        for item in radios
        if isinstance(item, dict) and item.get("firmware_version")
    )
    if observed_radios != expected_radios:
        raise ValueError("3 MS/s receipt radio identities differ from the production pair")
    if schema_version == 2:
        verify_contiguous_rate_3m_prerequisites(
            target.get("prerequisites"),
            radio_ids=(expected_radios[0][0], expected_radios[1][0]),
        )
    elif schema_version == 3:
        verify_contiguous_rate_3m_prerequisites_v3(
            target.get("prerequisites"),
            radio_ids=(expected_radios[0][0], expected_radios[1][0]),
        )
    else:
        raise ValueError("3 MS/s continuity receipt has an unsupported contract")

    host = target.get("expected_host")
    machine_id_path = Path("/etc/machine-id")
    if (
        not isinstance(host, dict)
        or not machine_id_path.is_file()
        or host.get("hostname") != socket.gethostname()
        or host.get("machine_id") != machine_id_path.read_text(encoding="utf-8").strip()
        or not host.get("operating_system")
    ):
        raise ValueError("3 MS/s receipt host identity differs from the deployment host")
    if receipt.get("target_digest") != canonical_json_sha256(target):
        raise ValueError("3 MS/s receipt target digest does not bind the full target")

    checks = receipt.get("checks")
    if not isinstance(checks, list) or len(checks) != 10:
        raise ValueError("3 MS/s receipt does not contain exactly ten trial checks")
    trial_ids: set[str] = set()
    session_ids: set[str] = set()
    manifest_digests: set[str] = set()
    for check in checks:
        trial_id = check.get("trial_id") if isinstance(check, dict) else None
        session_id = check.get("session_id") if isinstance(check, dict) else None
        manifest_digest = check.get("manifest_sha256") if isinstance(check, dict) else None
        if (
            not isinstance(check, dict)
            or check.get("passed") is not True
            or check.get("errors") != []
            or not isinstance(trial_id, str)
            or not trial_id.strip()
            or not isinstance(session_id, str)
            or not session_id.strip()
            or re.fullmatch(r"sha256:[0-9a-f]{64}", str(manifest_digest)) is None
        ):
            raise ValueError("3 MS/s receipt contains a failed or malformed trial check")
        trial_ids.add(trial_id)
        session_ids.add(session_id)
        manifest_digests.add(str(manifest_digest))
    if len(trial_ids) != 10:
        raise ValueError("3 MS/s receipt trial IDs are not independently unique")
    if len(session_ids) != 10:
        raise ValueError("3 MS/s receipt session IDs are not independently unique")
    if len(manifest_digests) != 10:
        raise ValueError("3 MS/s receipt manifest digests are not independently unique")


def verify_contiguous_rate_3m_receipt(
    receipt: dict[str, Any],
    *,
    revision: str,
    release: Path,
) -> None:
    """Verify the immutable V2 receipt contract."""

    _verify_contiguous_rate_3m_receipt(
        receipt,
        revision=revision,
        release=release,
        schema_version=2,
    )


def verify_contiguous_rate_3m_receipt_v3(
    receipt: dict[str, Any],
    *,
    revision: str,
    release: Path,
) -> None:
    """Verify the V3 receipt contract without a non-production USB control arm."""

    _verify_contiguous_rate_3m_receipt(
        receipt,
        revision=revision,
        release=release,
        schema_version=3,
    )


def verify_contiguous_rate_3m_receipt_v4(
    receipt: dict[str, Any],
    *,
    revision: str,
    release: Path,
) -> None:
    """Verify the V4 authority for the exact production device-axis profile."""

    receipt_keys = {
        "kind",
        "schema_version",
        "target",
        "target_digest",
        "created_utc_ns",
        "complete",
        "passed",
        "checks",
    }
    target = receipt.get("target")
    if (
        set(receipt) != receipt_keys
        or receipt.get("kind") != "contiguous_rate_qualification"
        or type(receipt.get("schema_version")) is not int
        or receipt.get("schema_version") != 4
        or receipt.get("complete") is not True
        or receipt.get("passed") is not True
        or not isinstance(target, dict)
    ):
        raise ValueError("3 MS/s device-axis receipt is not a complete strict V4 pass")

    created_utc_ns = receipt.get("created_utc_ns")
    if type(created_utc_ns) is not int:
        raise ValueError("3 MS/s V4 receipt created_utc_ns is missing or not an actual integer")
    now_utc_ns = time.time_ns()
    if created_utc_ns > now_utc_ns + RATE_RECEIPT_MAXIMUM_FUTURE_SKEW_NS:
        raise ValueError("3 MS/s V4 receipt creation time is more than five minutes in the future")
    if created_utc_ns < now_utc_ns - RATE_RECEIPT_MAXIMUM_AGE_NS:
        raise ValueError("3 MS/s V4 receipt creation time is older than 24 hours")

    target_keys = {
        "schema_version",
        "qualification_id",
        "profile_revision_digest",
        "capture_plan_digest",
        "sample_rate_hz",
        "bandwidth_hz",
        "requested_sample_count",
        "expected_radios",
        "expected_host",
        "expected_producer",
        "pluto_plus_utils_revision",
        "libiio_version",
        "libiio_library_sha256",
        "python_iio_sha256",
        "native_network_interface",
        "native_source_address",
        "prerequisites",
        "policy",
    }
    expected_target_values = {
        "schema_version": 4,
        "qualification_id": f"native-ip-3m-{revision[:12]}",
        "profile_revision_digest": CONTIGUOUS_RATE_3M_DEVICE_AXIS_PROFILE_DIGEST,
        "capture_plan_digest": CONTIGUOUS_RATE_3M_DEVICE_AXIS_PLAN_DIGEST,
        "sample_rate_hz": 3_000_000,
        "bandwidth_hz": 2_500_000,
        "requested_sample_count": 180_000_000,
        "native_network_interface": "enp132s0",
        "native_source_address": "192.168.1.142",
    }
    if set(target) != target_keys or any(
        type(target.get(key)) is not type(value) or target.get(key) != value
        for key, value in expected_target_values.items()
    ):
        raise ValueError("3 MS/s V4 target differs from the deployed device-axis plan")

    expected_policy = {
        "schema_version": 1,
        "required_trial_count": 10,
        "minimum_overlap_fraction": 0.99,
        "required_kernel_buffers": 8,
        "required_queue_capacity_refills": 32,
        "maximum_queue_high_water_fraction": 0.75,
        "required_metadata_abi_version": 1,
        "maximum_refill_service_interval_ns": 699_050_666,
        "required_tags": list(CONTIGUOUS_RATE_3M_DEVICE_AXIS_REQUIRED_TAGS),
    }
    policy = target.get("policy")
    if (
        not isinstance(policy, dict)
        or set(policy) != set(expected_policy)
        or any(
            type(policy.get(key)) is not type(value) or policy.get(key) != value
            for key, value in expected_policy.items()
        )
    ):
        raise ValueError("3 MS/s V4 policy differs from the deployed device-axis gate")

    prerequisites = target.get("prerequisites")
    v4_prerequisite_keys = {
        "schema_version",
        "radio_safety",
        "native_ip_canaries",
        "writer_benchmark",
        "host_health",
        "five_m_characterization",
    }
    if (
        not isinstance(prerequisites, dict)
        or set(prerequisites) != v4_prerequisite_keys
        or type(prerequisites.get("schema_version")) is not int
        or prerequisites.get("schema_version") != 4
    ):
        raise ValueError("3 MS/s V4 prerequisites are not the exact combined campaign")
    verify_contiguous_rate_3m_prerequisites_v3(
        {
            "schema_version": 3,
            "radio_safety": prerequisites.get("radio_safety"),
            "native_ip_canaries": prerequisites.get("native_ip_canaries"),
            "writer_benchmark": prerequisites.get("writer_benchmark"),
        },
        radio_ids=("radio_pluto_5d4d", "radio_pluto_19f2"),
    )
    v4_writer = prerequisites["writer_benchmark"]
    if v4_writer["sustained_bytes_per_second"] < 100_000_000:
        raise ValueError(
            "V4 writer prerequisite is below the measured incompressible 100 MB/s gate"
        )

    with (release / "pyproject.toml").open("rb") as stream:
        project = tomllib.load(stream)
    metadata_runtime_path = release / ".venv/share/pluto-plus-utils/metadata-runtime.json"
    try:
        metadata_runtime = json.loads(metadata_runtime_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ValueError("staged release metadata runtime receipt is unreadable") from error
    if (
        not isinstance(metadata_runtime, dict)
        or type(metadata_runtime.get("schema_version")) is not int
        or metadata_runtime.get("schema_version") != 1
        or type(metadata_runtime.get("metadata_abi")) is not int
        or metadata_runtime.get("metadata_abi") != 1
        or not isinstance(metadata_runtime.get("libiio_version"), str)
        or not metadata_runtime["libiio_version"]
    ):
        raise ValueError("staged release metadata runtime is not ABI 1")

    producer = target.get("expected_producer")
    expected_ppu = project["tool"]["uv"]["sources"]["pluto-plus-utils"]["rev"]
    if (
        not isinstance(producer, dict)
        or set(producer) != {"schema_version", "name", "version", "source_revision"}
        or type(producer.get("schema_version")) is not int
        or producer.get("schema_version") != 1
        or producer.get("name") != "leo-acquisition"
        or producer.get("version") != project["project"]["version"]
        or producer.get("source_revision") != revision
        or target.get("pluto_plus_utils_revision") != expected_ppu
    ):
        raise ValueError("3 MS/s V4 software identity differs from the staged release")
    expected_runtime = {
        "libiio_version": metadata_runtime.get("libiio_version"),
        "libiio_library_sha256": "sha256:" + str(metadata_runtime.get("native_libiio_sha256")),
        "python_iio_sha256": "sha256:" + str(metadata_runtime.get("pylibiio_sha256")),
    }
    if any(target.get(key) != value for key, value in expected_runtime.items()) or any(
        not _is_sha256_digest(expected_runtime[key])
        for key in ("libiio_library_sha256", "python_iio_sha256")
    ):
        raise ValueError("3 MS/s V4 libiio identity differs from the staged runtime")

    expected_radios = (
        (
            "radio_pluto_5d4d",
            "1040005e0b100007100010000bf33a5d4d",
            "ip:192.168.1.20",
            "iio_ip",
        ),
        (
            "radio_pluto_19f2",
            "10400056f695001322002d0010ad1719f2",
            "ip:192.168.1.21",
            "iio_ip",
        ),
    )
    radio_keys = {
        "schema_version",
        "radio_id",
        "serial",
        "uri",
        "transport",
        "model",
        "firmware_version",
        "hardware_revision",
    }
    radios = target.get("expected_radios")
    if not isinstance(radios, list) or len(radios) != 2:
        raise ValueError("3 MS/s V4 receipt must bind exactly two radios")
    for radio, expected in zip(radios, expected_radios, strict=True):
        if (
            not isinstance(radio, dict)
            or set(radio) != radio_keys
            or type(radio.get("schema_version")) is not int
            or radio.get("schema_version") != 1
            or (
                radio.get("radio_id"),
                radio.get("serial"),
                radio.get("uri"),
                radio.get("transport"),
            )
            != expected
            or not isinstance(radio.get("model"), str)
            or not radio["model"]
            or not isinstance(radio.get("firmware_version"), str)
            or not radio["firmware_version"]
            or (
                radio.get("hardware_revision") is not None
                and (
                    not isinstance(radio.get("hardware_revision"), str)
                    or not radio["hardware_revision"]
                )
            )
        ):
            raise ValueError("3 MS/s V4 radio identities differ from the production pair")

    host = target.get("expected_host")
    machine_id_path = Path("/etc/machine-id")
    if (
        not isinstance(host, dict)
        or set(host) != {"schema_version", "hostname", "machine_id", "operating_system"}
        or type(host.get("schema_version")) is not int
        or host.get("schema_version") != 1
        or not machine_id_path.is_file()
        or host.get("hostname") != socket.gethostname()
        or host.get("machine_id") != machine_id_path.read_text(encoding="utf-8").strip()
        or not host.get("operating_system")
    ):
        raise ValueError("3 MS/s V4 host identity differs from the deployment host")
    verify_qualification_host_health_v1(
        prerequisites.get("host_health"),
        expected_host_name=host["hostname"],
        receipt_created_utc_ns=created_utc_ns,
    )

    five_m = prerequisites.get("five_m_characterization")
    five_m_keys = {
        "schema_version",
        "evidence_sha256",
        "manifest_sha256",
        "session_id",
        "profile_revision_digest",
        "capture_plan_digest",
        "sample_rate_hz",
        "bandwidth_hz",
        "requested_sample_count",
        "radios",
        "host",
        "producer",
        "manifest_state",
        "streams",
        "bundle_verified",
        "physical_zero_verified",
        "validity_verified",
        "gap_map_verified",
        "passed",
        "errors",
    }
    expected_five_m_values = {
        "schema_version": 1,
        "profile_revision_digest": CONTIGUOUS_RATE_5M_DEVICE_AXIS_PROFILE_DIGEST,
        "capture_plan_digest": CONTIGUOUS_RATE_5M_DEVICE_AXIS_PLAN_DIGEST,
        "sample_rate_hz": 5_000_000,
        "bandwidth_hz": 2_500_000,
        "requested_sample_count": 300_000_000,
        "bundle_verified": True,
        "physical_zero_verified": True,
        "validity_verified": True,
        "gap_map_verified": True,
        "passed": True,
        "errors": [],
    }
    if (
        not isinstance(five_m, dict)
        or set(five_m) != five_m_keys
        or any(
            type(five_m.get(key)) is not type(value) or five_m.get(key) != value
            for key, value in expected_five_m_values.items()
        )
        or not _is_sha256_digest(five_m.get("evidence_sha256"))
        or not _is_sha256_digest(five_m.get("manifest_sha256"))
        or not isinstance(five_m.get("session_id"), str)
        or not five_m["session_id"].strip()
        or five_m.get("radios") != radios
        or five_m.get("host") != host
        or five_m.get("producer") != producer
    ):
        raise ValueError("5 MS/s characterization differs from the exact combined V4 campaign")

    five_m_stream_keys = {
        "schema_version",
        "radio_id",
        "logical_sample_count",
        "observed_sample_count",
        "zero_fill_sample_count",
        "continuity_segment_count",
        "gap_count",
        "missing_sample_count",
        "overflow_count",
        "enqueue_failure_count",
        "terminal_rejected_gap_count",
        "terminal_rejected_missing_sample_count",
        "terminal_rejected_overflow_count",
        "queue_capacity_refills",
        "queue_high_water_refills",
        "gap_map_segment_count",
        "gap_map_boundary_count",
        "validity_segment_count",
        "observed_iq_sha256",
        "logical_iq_sha256",
        "timeline_sha256",
        "gap_map_sha256",
        "validity_inventory_sha256",
    }
    five_m_digest_fields = (
        "observed_iq_sha256",
        "logical_iq_sha256",
        "timeline_sha256",
        "gap_map_sha256",
        "validity_inventory_sha256",
    )
    five_m_streams = five_m.get("streams")
    if not isinstance(five_m_streams, list) or len(five_m_streams) != 2:
        raise ValueError("5 MS/s characterization lacks exactly two stream closures")
    any_five_m_loss = False
    for stream, expected_radio in zip(five_m_streams, expected_radios, strict=True):
        if not isinstance(stream, dict) or set(stream) != five_m_stream_keys:
            raise ValueError("5 MS/s stream characterization has an unreviewed wire shape")
        integer_fields = (
            "logical_sample_count",
            "observed_sample_count",
            "zero_fill_sample_count",
            "continuity_segment_count",
            "gap_count",
            "missing_sample_count",
            "overflow_count",
            "enqueue_failure_count",
            "terminal_rejected_gap_count",
            "terminal_rejected_missing_sample_count",
            "terminal_rejected_overflow_count",
            "queue_capacity_refills",
            "queue_high_water_refills",
            "gap_map_segment_count",
            "gap_map_boundary_count",
            "validity_segment_count",
        )
        if any(type(stream.get(key)) is not int for key in integer_fields):
            raise ValueError("5 MS/s stream characterization counters are not exact integers")
        observed = stream["observed_sample_count"]
        zero_fill = stream["zero_fill_sample_count"]
        gap_count = stream["gap_count"]
        validity_segments = stream["validity_segment_count"]
        if (
            type(stream.get("schema_version")) is not int
            or stream.get("schema_version") != 1
            or stream.get("radio_id") != expected_radio[0]
            or stream["logical_sample_count"] != 300_000_000
            or observed <= 0
            or zero_fill < 0
            or observed + zero_fill != 300_000_000
            or stream["missing_sample_count"] != zero_fill
            or stream["overflow_count"] != 0
            or stream["enqueue_failure_count"] != 0
            or stream["terminal_rejected_gap_count"] != 0
            or stream["terminal_rejected_missing_sample_count"] != 0
            or stream["terminal_rejected_overflow_count"] != 0
            or stream["queue_capacity_refills"] != 32
            or not 1 <= stream["queue_high_water_refills"] <= 24
            or gap_count < 0
            or stream["gap_map_boundary_count"] != gap_count
            or stream["gap_map_segment_count"] != gap_count + 1
            or validity_segments != stream["gap_map_segment_count"]
            or not 1 <= stream["continuity_segment_count"] <= validity_segments
            or any(not _is_sha256_digest(stream.get(key)) for key in five_m_digest_fields)
            or (
                zero_fill == 0
                and stream.get("observed_iq_sha256") != stream.get("logical_iq_sha256")
            )
        ):
            raise ValueError("5 MS/s stream characterization does not close its device axis")
        any_five_m_loss = any_five_m_loss or zero_fill > 0
    expected_five_m_state = "degraded" if any_five_m_loss else "committed"
    if five_m.get("manifest_state") != expected_five_m_state:
        raise ValueError("5 MS/s manifest state disagrees with the verified device axis")

    if receipt.get("target_digest") != canonical_json_sha256(target):
        raise ValueError("3 MS/s V4 target digest does not bind the full target")

    checks = receipt.get("checks")
    if not isinstance(checks, list) or len(checks) != 10:
        raise ValueError("3 MS/s V4 receipt does not contain exactly ten trial checks")
    check_keys = {
        "schema_version",
        "trial_id",
        "session_id",
        "manifest_sha256",
        "passed",
        "errors",
        "manifest_schema_version",
        "stream_checks",
    }
    stream_check_keys = {
        "schema_version",
        "radio_id",
        "logical_sample_count",
        "observed_sample_count",
        "zero_fill_sample_count",
        "continuity_segment_count",
        "observed_iq_sha256",
        "logical_iq_sha256",
        "timeline_sha256",
        "gap_map_sha256",
        "validity_inventory_sha256",
    }
    digest_fields = (
        "observed_iq_sha256",
        "logical_iq_sha256",
        "timeline_sha256",
        "gap_map_sha256",
        "validity_inventory_sha256",
    )
    trial_ids: set[str] = set()
    session_ids: set[str] = set()
    manifest_digests: set[str] = set()
    expected_radio_ids = tuple(item[0] for item in expected_radios)
    for check in checks:
        if (
            not isinstance(check, dict)
            or set(check) != check_keys
            or type(check.get("schema_version")) is not int
            or check.get("schema_version") != 2
            or type(check.get("manifest_schema_version")) is not int
            or check.get("manifest_schema_version") != 3
            or check.get("passed") is not True
            or check.get("errors") != []
        ):
            raise ValueError("3 MS/s V4 receipt contains a failed or malformed trial check")
        trial_id = check.get("trial_id")
        session_id = check.get("session_id")
        manifest_digest = check.get("manifest_sha256")
        if (
            not isinstance(trial_id, str)
            or not trial_id.strip()
            or not isinstance(session_id, str)
            or not session_id.strip()
            or not _is_sha256_digest(manifest_digest)
        ):
            raise ValueError("3 MS/s V4 receipt contains a failed or malformed trial check")

        stream_checks = check.get("stream_checks")
        if not isinstance(stream_checks, list) or len(stream_checks) != 2:
            raise ValueError("3 MS/s V4 trial does not retain exactly two stream checks")
        for stream_check, radio_id in zip(stream_checks, expected_radio_ids, strict=True):
            if (
                not isinstance(stream_check, dict)
                or set(stream_check) != stream_check_keys
                or type(stream_check.get("schema_version")) is not int
                or stream_check.get("schema_version") != 1
                or stream_check.get("radio_id") != radio_id
                or type(stream_check.get("logical_sample_count")) is not int
                or stream_check.get("logical_sample_count") != 180_000_000
                or type(stream_check.get("observed_sample_count")) is not int
                or stream_check.get("observed_sample_count") != 180_000_000
                or type(stream_check.get("zero_fill_sample_count")) is not int
                or stream_check.get("zero_fill_sample_count") != 0
                or type(stream_check.get("continuity_segment_count")) is not int
                or stream_check.get("continuity_segment_count") != 1
                or any(not _is_sha256_digest(stream_check.get(key)) for key in digest_fields)
                or stream_check.get("observed_iq_sha256") != stream_check.get("logical_iq_sha256")
            ):
                raise ValueError("3 MS/s V4 stream check is not an exact lossless closure")

        trial_ids.add(trial_id)
        session_ids.add(session_id)
        manifest_digests.add(str(manifest_digest))
    if len(trial_ids) != 10:
        raise ValueError("3 MS/s V4 receipt trial IDs are not independently unique")
    if len(session_ids) != 10:
        raise ValueError("3 MS/s V4 receipt session IDs are not independently unique")
    if len(manifest_digests) != 10:
        raise ValueError("3 MS/s V4 receipt manifest digests are not independently unique")
    if five_m["session_id"] in session_ids or five_m["manifest_sha256"] in manifest_digests:
        raise ValueError("5 MS/s characterization is not independent from the 3 MS/s trials")


def verify_contiguous_rate_3m_receipt_v5(
    receipt: dict[str, Any],
    *,
    revision: str,
    release: Path,
) -> None:
    """Verify V5 and reuse V4's unchanged device-axis/radio/runtime closure."""

    target = receipt.get("target")
    if (
        set(receipt)
        != {
            "kind",
            "schema_version",
            "target",
            "target_digest",
            "created_utc_ns",
            "complete",
            "passed",
            "checks",
        }
        or receipt.get("kind") != "contiguous_rate_qualification"
        or type(receipt.get("schema_version")) is not int
        or receipt.get("schema_version") != 5
        or receipt.get("complete") is not True
        or receipt.get("passed") is not True
        or not isinstance(target, dict)
        or type(target.get("schema_version")) is not int
        or target.get("schema_version") != 5
        or target.get("qualification_id") != f"native-ip-3m-v5-{revision[:12]}"
        or receipt.get("target_digest") != canonical_json_sha256(target)
    ):
        raise ValueError("3 MS/s device-axis receipt is not a complete strict V5 pass")
    prerequisites = target.get("prerequisites")
    if (
        not isinstance(prerequisites, dict)
        or set(prerequisites)
        != {
            "schema_version",
            "radio_safety",
            "native_ip_canaries",
            "writer_benchmark",
            "host_health",
            "five_m_characterization",
        }
        or type(prerequisites.get("schema_version")) is not int
        or prerequisites.get("schema_version") != 5
    ):
        raise ValueError("3 MS/s V5 prerequisites are not the exact combined campaign")
    host = target.get("expected_host")
    created_utc_ns = receipt.get("created_utc_ns")
    if (
        not isinstance(host, dict)
        or not isinstance(host.get("hostname"), str)
        or type(created_utc_ns) is not int
    ):
        raise ValueError("3 MS/s V5 host or receipt time is malformed")
    compatibility_host_health = verify_qualification_host_health_v2(
        prerequisites.get("host_health"),
        expected_host_name=host["hostname"],
        receipt_created_utc_ns=created_utc_ns,
    )

    compatibility = json.loads(json.dumps(receipt))
    compatibility["schema_version"] = 4
    compatibility_target = compatibility["target"]
    compatibility_target["schema_version"] = 4
    compatibility_target["qualification_id"] = f"native-ip-3m-{revision[:12]}"
    compatibility_target["prerequisites"]["schema_version"] = 4
    compatibility_target["prerequisites"]["host_health"] = compatibility_host_health
    compatibility["target_digest"] = canonical_json_sha256(compatibility_target)
    verify_contiguous_rate_3m_receipt_v4(
        compatibility,
        revision=revision,
        release=release,
    )


def verify_contiguous_rate_3m_receipt_v6(
    receipt: dict[str, Any],
    *,
    revision: str,
    release: Path,
) -> None:
    """Verify full native-bandwidth V6, then reuse the frozen V5 closure."""

    target = receipt.get("target")
    receipt_keys = {
        "kind",
        "schema_version",
        "target",
        "target_digest",
        "created_utc_ns",
        "complete",
        "passed",
        "checks",
    }
    if (
        set(receipt) != receipt_keys
        or receipt.get("kind") != "contiguous_rate_qualification"
        or type(receipt.get("schema_version")) is not int
        or receipt.get("schema_version") != 6
        or receipt.get("complete") is not True
        or receipt.get("passed") is not True
        or not isinstance(target, dict)
        or type(target.get("schema_version")) is not int
        or target.get("schema_version") != 6
        or target.get("qualification_id") != f"native-ip-3m-v6-{revision[:12]}"
        or receipt.get("target_digest") != canonical_json_sha256(target)
    ):
        raise ValueError("3 MS/s native-bandwidth receipt is not a complete strict V6 pass")

    expected_target = {
        "profile_revision_digest": CONTIGUOUS_RATE_3M_NATIVE_BANDWIDTH_PROFILE_DIGEST,
        "capture_plan_digest": CONTIGUOUS_RATE_3M_NATIVE_BANDWIDTH_PLAN_DIGEST,
        "sample_rate_hz": 3_000_000,
        "bandwidth_hz": 3_000_000,
        "requested_sample_count": 180_000_000,
        "native_network_interface": "enp132s0",
        "native_source_address": "192.168.1.142",
    }
    if any(
        type(target.get(key)) is not type(value) or target.get(key) != value
        for key, value in expected_target.items()
    ):
        raise ValueError("3 MS/s V6 target does not use the exact native RF bandwidth plan")

    expected_policy = {
        "schema_version": 1,
        "required_trial_count": 10,
        "minimum_overlap_fraction": 0.99,
        "required_kernel_buffers": 4,
        "required_queue_capacity_refills": 32,
        "maximum_queue_high_water_fraction": 0.75,
        "required_metadata_abi_version": 1,
        "maximum_refill_service_interval_ns": 1_398_101_333,
        "required_tags": list(CONTIGUOUS_RATE_3M_NATIVE_BANDWIDTH_REQUIRED_TAGS),
    }
    policy = target.get("policy")
    if not isinstance(policy, dict) or policy != expected_policy:
        raise ValueError("3 MS/s V6 policy is not the four-buffer maximum-refill policy")

    prerequisites = target.get("prerequisites")
    if (
        not isinstance(prerequisites, dict)
        or set(prerequisites)
        != {
            "schema_version",
            "radio_safety",
            "native_ip_canaries",
            "writer_benchmark",
            "host_health",
            "five_m_characterization",
        }
        or type(prerequisites.get("schema_version")) is not int
        or prerequisites.get("schema_version") != 6
    ):
        raise ValueError("3 MS/s V6 prerequisites are not the exact combined campaign")
    canaries = prerequisites.get("native_ip_canaries")
    if (
        not isinstance(canaries, list)
        or len(canaries) != 2
        or any(
            not isinstance(canary, dict)
            or canary.get("sample_rate_hz") != 3_000_000
            or canary.get("bandwidth_hz") != 3_000_000
            or canary.get("passed") is not True
            for canary in canaries
        )
    ):
        raise ValueError("V6 native-IP canaries are not exact full-bandwidth 3 MS/s passes")
    five_m = prerequisites.get("five_m_characterization")
    expected_five_m = {
        "schema_version": 2,
        "profile_revision_digest": CONTIGUOUS_RATE_5M_NATIVE_BANDWIDTH_PROFILE_DIGEST,
        "capture_plan_digest": CONTIGUOUS_RATE_5M_NATIVE_BANDWIDTH_PLAN_DIGEST,
        "sample_rate_hz": 5_000_000,
        "bandwidth_hz": 5_000_000,
        "requested_sample_count": 300_000_000,
        "bundle_verified": True,
        "physical_zero_verified": True,
        "validity_verified": True,
        "gap_map_verified": True,
        "passed": True,
        "errors": [],
    }
    if not isinstance(five_m, dict) or any(
        type(five_m.get(key)) is not type(value) or five_m.get(key) != value
        for key, value in expected_five_m.items()
    ):
        raise ValueError("V6 5 MS/s characterization is not the exact native-bandwidth pass")

    # V1-V5 remain immutable. Normalize only a private deep copy back to the
    # frozen V5 authority so its exhaustive host/radio/runtime/digest and stream
    # closure validation can be reused without weakening either generation.
    compatibility = json.loads(json.dumps(receipt))
    compatibility["schema_version"] = 5
    compatibility_target = compatibility["target"]
    compatibility_target.update(
        {
            "schema_version": 5,
            "qualification_id": f"native-ip-3m-v5-{revision[:12]}",
            "profile_revision_digest": CONTIGUOUS_RATE_3M_DEVICE_AXIS_PROFILE_DIGEST,
            "capture_plan_digest": CONTIGUOUS_RATE_3M_DEVICE_AXIS_PLAN_DIGEST,
            "bandwidth_hz": 2_500_000,
        }
    )
    compatibility_prerequisites = compatibility_target["prerequisites"]
    compatibility_prerequisites["schema_version"] = 5
    for canary in compatibility_prerequisites["native_ip_canaries"]:
        canary["bandwidth_hz"] = 2_500_000
    compatibility_five_m = compatibility_prerequisites["five_m_characterization"]
    compatibility_five_m.update(
        {
            "schema_version": 1,
            "profile_revision_digest": CONTIGUOUS_RATE_5M_DEVICE_AXIS_PROFILE_DIGEST,
            "capture_plan_digest": CONTIGUOUS_RATE_5M_DEVICE_AXIS_PLAN_DIGEST,
            "bandwidth_hz": 2_500_000,
        }
    )
    compatibility_target["policy"] = {
        **expected_policy,
        "required_kernel_buffers": 8,
        "maximum_refill_service_interval_ns": 699_050_666,
        "required_tags": list(CONTIGUOUS_RATE_3M_DEVICE_AXIS_REQUIRED_TAGS),
    }
    compatibility["target_digest"] = canonical_json_sha256(compatibility_target)
    verify_contiguous_rate_3m_receipt_v5(
        compatibility,
        revision=revision,
        release=release,
    )


def verify_native_bandwidth_receipt_v1(
    path: Path,
    *,
    revision: str,
    release: Path,
    rate_target: dict[str, Any],
) -> None:
    """Validate the additive RF/IF receipt with the exact staged contract."""

    expected_path = (
        NATIVE_BANDWIDTH_RECEIPT_ROOT / revision / "native-bandwidth-qualification-receipt-v1.json"
    )
    if path != expected_path:
        raise ValueError("native-bandwidth receipt path is not the revision authority")
    load_json(path, "native-bandwidth qualification receipt")
    output = command(
        "runuser",
        "-u",
        "leo",
        "--",
        str(release / ".venv/bin/python"),
        "-I",
        "-B",
        "-c",
        NATIVE_BANDWIDTH_RECEIPT_PROGRAM,
        str(path),
    )
    summary = json.loads(output)
    expected_summary = {
        "target_revision": revision,
        "host": rate_target.get("expected_host"),
        "radios": rate_target.get("expected_radios"),
        "pluto_plus_utils_revision": rate_target.get("pluto_plus_utils_revision"),
        "created_utc_ns": summary.get("created_utc_ns"),
        "modes": [
            "ordinary_2p5",
            "ordinary_3",
            "ordinary_5",
            "mixed_2p5_5_high_first",
            "mixed_2p5_5_high_second",
        ],
    }
    if summary != expected_summary:
        raise ValueError(
            "native-bandwidth receipt differs from the V5 host, radio, PPU, or mode authority"
        )
    created_utc_ns = summary.get("created_utc_ns")
    now_ns = time.time_ns()
    if type(created_utc_ns) is not int or not (
        now_ns - RATE_RECEIPT_MAXIMUM_AGE_NS
        <= created_utc_ns
        <= now_ns + RATE_RECEIPT_MAXIMUM_FUTURE_SKEW_NS
    ):
        raise ValueError("native-bandwidth receipt is stale or future-dated")


def verify_native_bandwidth_receipt_v2(
    path: Path,
    *,
    revision: str,
    release: Path,
    rate_target: dict[str, Any],
) -> None:
    """Require counter-proven refill selection and exact native RF readback."""

    expected_path = (
        NATIVE_BANDWIDTH_RECEIPT_ROOT / revision / "native-bandwidth-qualification-receipt-v2.json"
    )
    if path != expected_path:
        raise ValueError("native-bandwidth V2 receipt path is not the revision authority")
    load_json(path, "native-bandwidth V2 qualification receipt")
    output = command(
        "runuser",
        "-u",
        "leo",
        "--",
        str(release / ".venv/bin/python"),
        "-I",
        "-B",
        "-c",
        NATIVE_BANDWIDTH_RECEIPT_V2_PROGRAM,
        str(path),
    )
    summary = json.loads(output)
    expected_summary = {
        "target_revision": revision,
        "host": rate_target.get("expected_host"),
        "radios": rate_target.get("expected_radios"),
        "pluto_plus_utils_revision": rate_target.get("pluto_plus_utils_revision"),
        "created_utc_ns": summary.get("created_utc_ns"),
        "modes": [
            "ordinary_2p5",
            "ordinary_3",
            "ordinary_5",
            "mixed_2p5_5_high_first",
            "mixed_2p5_5_high_second",
        ],
        "metadata_rate_inventory": [[2_500_000, 3_000_000, 5_000_000]] * 2,
        "largest_passing_refill_inventory": [[1_048_576] * 3] * 2,
        "exact_rf_readback_inventory": [[True] * 3] * 2,
    }
    if summary != expected_summary:
        raise ValueError(
            "native-bandwidth V2 receipt differs from the counter, RF, or V5 authority"
        )
    created_utc_ns = summary.get("created_utc_ns")
    now_ns = time.time_ns()
    if type(created_utc_ns) is not int or not (
        now_ns - RATE_RECEIPT_MAXIMUM_AGE_NS
        <= created_utc_ns
        <= now_ns + RATE_RECEIPT_MAXIMUM_FUTURE_SKEW_NS
    ):
        raise ValueError("native-bandwidth V2 receipt is stale or future-dated")


def _verify_release_publication(release: Path, revision: str) -> None:
    metadata = Path("/opt/leo-tracker/release-metadata") / f"{revision}.txt"
    metadata_validator = release / "deploy/scripts/validate-release-metadata"
    runtime_validator = release / "deploy/scripts/validate-published-release"
    command(str(metadata_validator), str(release), str(metadata), revision)
    command(
        "runuser",
        "-u",
        "leo",
        "--",
        str(release / ".venv/bin/python"),
        str(runtime_validator),
        str(release),
        str(RELEASE_ROOT / f".staging-{revision}"),
    )


def _verify_component_preflight(component: str, release: Path, revision: str) -> list[str]:
    _component_environment_revision(component, revision)
    if component == "worker":
        unit = release / "deploy/systemd/leo-worker@.service"
        drop_in = release / "deploy/systemd/leo-worker@.service.d/20-component-environment.conf"
        selector = "current-worker"
        expected_environment = "EnvironmentFile=/etc/leo/worker.env"
    elif component == "acquisition":
        unit = release / "deploy/systemd/leo-acquisition.service"
        drop_in = release / "deploy/systemd/leo-acquisition.service.d/20-component-environment.conf"
        selector = "current-acquisition"
        expected_environment = "EnvironmentFile=/etc/leo/acquisition.env"
    else:
        raise ValueError(f"unsupported narrow component: {component}")
    for path, label in ((unit, f"{component} unit"), (drop_in, f"{component} drop-in")):
        if path.is_symlink() or not path.is_file():
            raise ValueError(f"staged {label} is missing or unsafe")
    unit_text = unit.read_text(encoding="utf-8")
    expected_invocation = (
        f"/opt/leo-tracker/{selector}/.venv/bin/leo process worker "
        if component == "worker"
        else f"/opt/leo-tracker/{selector}/.venv/bin/leo acquire run "
    )
    if (
        f"WorkingDirectory=/opt/leo-tracker/{selector}" not in unit_text
        or expected_invocation not in unit_text
        or "InaccessiblePaths=/mnt/qnap01" not in unit_text
    ):
        raise ValueError(f"staged {component} unit does not use its confined component selector")
    if drop_in.read_text(encoding="utf-8").splitlines() != ["[Service]", expected_environment]:
        raise ValueError(f"staged {component} drop-in is not the exact environment authority")
    command("systemd-analyze", "verify", str(unit))
    return [
        f"release {revision} publication metadata and runtime validate",
        "exact-revision V3 release qualification and input closures are sealed and passed",
        f"{component} environment binds the exact target release",
        f"staged {component} unit uses its confined selector and denies QNAP",
        "global service quiescence and live-radio continuity were intentionally not probed",
    ]


def verify(args: argparse.Namespace) -> list[str]:
    revision = args.revision
    if re.fullmatch(r"[0-9a-f]{40}", revision) is None:
        raise ValueError("revision must be a full lowercase 40-character SHA")
    release_literal = RELEASE_ROOT / revision
    release = reject_qnap(release_literal, "release")
    if release_literal.is_symlink() or not release.is_dir():
        raise ValueError(f"staged release is missing or unsafe: {release}")
    _staged_release_source_identity(release, revision)
    release_mode = release.stat().st_mode & 0o777
    if release_mode & 0o022:
        raise ValueError(f"staged release root is group/other writable: {release_mode:o}")
    required_outputs = (
        release / ".venv/bin/leo",
        release / ".venv/bin/leo-api",
        release / "web/dist/index.html",
    )
    for required in required_outputs:
        if not required.is_file():
            raise ValueError(f"staged release output is missing: {required}")
    component = getattr(args, "component", None)
    verify_staged_capture_profiles(release)
    verify_staged_acquisition_service(release)

    release_receipt = _load_qualification_json(
        args.release_receipt,
        "release qualification receipt",
        require_sealed=True,
    )
    if release_receipt.get("passed") is not True or release_receipt.get("status") != "passed":
        raise ValueError("release qualification receipt is not a pass")
    if release_receipt.get("git_revision") != revision:
        raise ValueError("release qualification receipt does not match staged revision")
    verify_release_evidence(
        args.release_receipt,
        release_receipt,
        release=release,
        revision=revision,
    )
    if args.standard_regression_receipt is not None:
        standard_receipt = load_json(
            args.standard_regression_receipt,
            "Standard four-path regression receipt",
        )
        verify_standard_regression_receipt(
            args.standard_regression_receipt,
            standard_receipt,
            release=release,
        )
        cutover_evidence = "reviewed four-path Standard regression is sealed and passed"
    else:
        assert args.soak_receipt is not None
        verify_soak_receipt(load_json(args.soak_receipt, "terminal soak audit receipt"))
        cutover_evidence = "optional terminal qualification soak is sealed and accepted"

    _verify_release_publication(release, revision)
    component_results = (
        _verify_component_preflight(component, release, revision) if component is not None else None
    )

    env_path = reject_qnap(ENVIRONMENT, "production environment")
    if ENVIRONMENT.is_symlink() or not env_path.is_file():
        raise ValueError("production environment must be a regular non-symlink file")
    mode = env_path.stat().st_mode & 0o777
    if mode & 0o007 or mode & 0o020:
        raise ValueError(f"production environment permissions are too broad: {mode:o}")
    env_text = env_path.read_text(encoding="utf-8")
    environment = verify_environment_text(
        env_text,
        revision if component is None else _installed_pipeline_revision(env_text),
    )
    authority_path = (
        Path(environment["LEO_STATION_AUTHORITY_ROOT"])
        / environment["LEO_STATION_TOPOLOGY_RELATIVE_PATH"]
    )
    verify_station_authority_install(
        authority_path,
        expected_gid=grp.getgrnam("leo").gr_gid,
    )
    verify_scanner_data_directories(expected_gid=grp.getgrnam("leo").gr_gid)

    if os.geteuid() != 0:
        raise ValueError("run as root so both system and legacy user managers can be inspected")
    if component is None:
        legacy = user_systemctl(
            args.legacy_user,
            "list-units",
            "leo-*",
            "--state=active,activating,reloading",
            "--no-legend",
            "--plain",
        )
        if legacy.returncode not in (0,):
            raise ValueError(f"cannot inspect legacy user manager: {legacy.stderr.strip()}")
        unexpected_legacy = unexpected_legacy_active_units(legacy.stdout)
        if unexpected_legacy:
            raise ValueError(
                "legacy user LEO units are still active:\n" + "\n".join(unexpected_legacy)
            )

        system_active = command(
            "systemctl",
            "list-units",
            "leo-*",
            "--state=active,activating,reloading",
            "--no-legend",
            "--plain",
        )
        if system_active:
            raise ValueError("system-scope LEO units are already active:\n" + system_active)
    probe_processing_resource_capacity()
    if component is None:
        probe_live_station_radios(release)

    unit_paths = tuple(sorted(UNIT_SOURCE.glob("leo-*.service")))
    if not unit_paths:
        raise ValueError(f"no unit templates found beneath {UNIT_SOURCE}")
    timer_paths = tuple(sorted(UNIT_SOURCE.glob("leo-*.timer")))
    command(
        "systemd-analyze",
        "verify",
        *(str(path) for path in unit_paths),
        *(str(path) for path in timer_paths),
    )
    for path in unit_paths:
        text = path.read_text(encoding="utf-8")
        if "InaccessiblePaths=/mnt/qnap01" not in text:
            raise ValueError(f"unit does not deny QNAP: {path.name}")

    if component_results is not None:
        return [
            *component_results,
            "production environment and station authority remain exact",
            "scanner paths and processing resource capacity remain production-ready",
            cutover_evidence,
            "all canonical unit templates validate and deny QNAP",
        ]

    return [
        f"release {revision} is immutable and built",
        "production and retained qualification profiles match the exact reviewed bytes",
        "staged acquisition service uses the exact ordered profile and radio pool",
        "exact-revision release qualification is sealed and passed",
        "production-direct-async-2p5-10-15-25-hold-exact-lo-6-v2 policy and "
        "exact staged service are sealed",
        cutover_evidence,
        "installed station topology authority is exact and sealed",
        "scanner raw-IQ and report directories are installed and permissioned",
        "production environment is permissioned and contains no radio placeholders",
        "legacy user scope and canonical system scope have no active LEO units",
        "processing resource capacity is exactly streaming=16,cpu=8,memory=4,heavy=2",
        "live station radios expose firmware identity and counter-authoritative ABI 3",
        "all canonical unit templates validate and deny QNAP",
        "external release metadata and final-path runtime validate",
    ]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--revision", required=True)
    parser.add_argument("--release-receipt", required=True, type=Path)
    authority = parser.add_mutually_exclusive_group(required=True)
    authority.add_argument("--standard-regression-receipt", type=Path)
    authority.add_argument("--soak-receipt", type=Path)
    parser.add_argument("--legacy-user", required=True)
    parser.add_argument("--component", choices=("worker", "acquisition"))
    args = parser.parse_args()
    try:
        results = verify(args)
    except (KeyError, OSError, ValueError, json.JSONDecodeError) as error:
        print(f"CUTOVER BLOCKED: {error}", file=sys.stderr)
        return 1
    print("CUTOVER PREFLIGHT PASSED")
    for result in results:
        print(f"- {result}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
