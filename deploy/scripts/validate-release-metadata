#!/usr/bin/env python3
"""Validate the external publication marker and immutable release tree."""

from __future__ import annotations

import argparse
import grp
import hashlib
import os
import posixpath
import re
import stat
import sys
from pathlib import Path

QNAP = Path("/mnt/qnap01")


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def validate(
    release: Path,
    metadata: Path,
    revision: str,
    *,
    allow_incomplete: bool = False,
    expected_uid: int = 0,
    expected_gid: int | None = None,
) -> None:
    if re.fullmatch(r"[0-9a-f]{40}", revision) is None:
        raise ValueError("revision must be a full lowercase SHA")
    if not release.is_absolute() or not metadata.is_absolute():
        raise ValueError("release and metadata paths must be absolute")
    for path in (release, metadata):
        if path == QNAP or QNAP in path.parents:
            raise ValueError("publication path must not be beneath QNAP")
    if release.is_symlink() or not release.is_dir():
        raise ValueError("release must be a real directory")
    if metadata.is_symlink() or not metadata.is_file():
        raise ValueError("metadata must be a regular non-symlink file")
    metadata_root = release.parents[1] / "release-metadata"
    expected_metadata = metadata_root / f"{revision}.txt"
    if allow_incomplete:
        if metadata.parent != metadata_root or not (
            metadata.name.startswith(f".{revision}.") and metadata.name.endswith(".tmp")
        ):
            raise ValueError("prepublication metadata temp path is not invocation-scoped")
    elif metadata != expected_metadata:
        raise ValueError("metadata path is not the canonical external publication marker")
    failed_marker = release / ".leo-release-validation-failed"
    incomplete_marker = release / ".leo-release-incomplete"
    if failed_marker.is_symlink():
        raise ValueError("release validation-failed marker must not be a symlink")
    if failed_marker.exists():
        raise ValueError("release has a validation-failed marker")
    if incomplete_marker.is_symlink():
        raise ValueError("release incomplete marker must not be a symlink")
    if incomplete_marker.exists() and not allow_incomplete:
        raise ValueError("release still has its incomplete marker")

    expected_group = grp.getgrnam("leo").gr_gid if expected_gid is None else expected_gid
    metadata_stat = metadata.stat()
    if metadata_stat.st_uid != expected_uid or metadata_stat.st_gid != expected_group:
        raise ValueError("metadata must be owned by root:leo")
    if stat.S_IMODE(metadata_stat.st_mode) != 0o440:
        raise ValueError("metadata mode must be 0440")

    lines = metadata.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0] != f"revision={revision}":
        raise ValueError("metadata revision is absent or mismatched")
    expected_paths = (
        release.parents[1] / "tooling/uv",
        release / "uv.lock",
        release / "web/package-lock.json",
    )
    if len(lines) != 1 + len(expected_paths):
        raise ValueError("metadata digest inventory has unexpected cardinality")
    for line, expected_path in zip(lines[1:], expected_paths, strict=True):
        match = re.fullmatch(r"([0-9a-f]{64})  (/.+)", line)
        if match is None or Path(match.group(2)) != expected_path:
            raise ValueError("metadata digest inventory path is unexpected")
        if not expected_path.is_file() or _sha256(expected_path) != match.group(1):
            raise ValueError(f"metadata digest does not verify: {expected_path}")

    for path in (release, *release.rglob("*")):
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            if info.st_uid != expected_uid or info.st_gid != expected_group:
                raise ValueError(f"release symlink is not owned by root:leo: {path}")
            target_text = os.readlink(path)
            if target_text.startswith("/"):
                target = Path(posixpath.normpath(target_text))
            else:
                target = Path(posixpath.normpath(str(path.parent / target_text)))
            if target == QNAP or QNAP in target.parents:
                raise ValueError(f"release symlink resolves beneath QNAP: {path}")
            allowed_external = (Path("/usr"), Path("/lib"), Path("/lib64"), Path("/bin"))
            if release not in target.parents and not any(
                target == root or root in target.parents for root in allowed_external
            ):
                raise ValueError(f"release symlink has an unapproved target: {path} -> {target}")
            continue
        if info.st_uid != expected_uid or info.st_gid != expected_group:
            raise ValueError(f"release entry is not owned by root:leo: {path}")
        if stat.S_IMODE(info.st_mode) & 0o022:
            raise ValueError(f"release entry is group/other writable: {path}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("release", type=Path)
    parser.add_argument("metadata", type=Path)
    parser.add_argument("revision")
    parser.add_argument("--allow-incomplete", action="store_true")
    options = parser.parse_args()
    try:
        validate(
            options.release,
            options.metadata,
            options.revision,
            allow_incomplete=options.allow_incomplete,
        )
    except (KeyError, OSError, UnicodeError, ValueError) as error:
        print(f"RELEASE METADATA INVALID: {error}", file=sys.stderr)
        return 1
    print(f"validated release publication metadata: {options.metadata}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
