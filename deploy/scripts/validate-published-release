#!/usr/bin/env python3
"""Validate entrypoints and imports from a release already at its final path."""

from __future__ import annotations

import argparse
import grp
import hashlib
import importlib.metadata
import json
import os
import stat
import struct
import subprocess
import sys
import tomllib
from pathlib import Path

QNAP = Path("/mnt/qnap01")
PRODUCTION_METADATA_ABI = 3
SCANNER_IIOD_RELATIVE_PATH = Path("runtime/scanner-iiod/iiod")
SCANNER_IIOD_PROVENANCE_RELATIVE_PATH = Path("runtime/scanner-iiod/provenance.json")
SCANNER_IIOD_SHA256 = "5d7ca0a04e93341bdcd28f1967f583f14389456ff4375362e394b7cc71af32ea"
SCANNER_IIOD_SIZE_BYTES = 230_980
SCANNER_IIOD_LIBIIO_REVISION = "c752ab684a4c9924ee362ccfb02a7ac65f7992f9"


def _safe_absolute(path: Path, label: str) -> Path:
    if not path.is_absolute():
        raise ValueError(f"{label} must be absolute")
    if path == QNAP or QNAP in path.parents:
        raise ValueError(f"{label} must not be beneath QNAP")
    current = Path(path.anchor)
    for component in path.parts[1:]:
        current /= component
        if current.is_symlink():
            raise ValueError(f"{label} must not contain symlink components: {current}")
    if not path.exists():
        raise ValueError(f"{label} does not exist")
    return path


def _contains_bytes(path: Path, needle: bytes) -> bool:
    overlap = max(0, len(needle) - 1)
    tail = b""
    with path.open("rb") as stream:
        while block := stream.read(1024 * 1024):
            combined = tail + block
            if needle in combined:
                return True
            tail = combined[-overlap:] if overlap else b""
    return False


def find_forbidden_reference(root: Path, forbidden: str) -> Path | None:
    needle = forbidden.encode()
    for path in sorted(root.rglob("*")):
        if path.is_symlink() or not path.is_file():
            continue
        if _contains_bytes(path, needle):
            return path
    return None


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def validate_scanner_iiod_binary(
    release: Path,
    *,
    expected_uid: int = 0,
    expected_gid: int | None = None,
    expected_sha256: str = SCANNER_IIOD_SHA256,
    expected_size: int = SCANNER_IIOD_SIZE_BYTES,
) -> str:
    """Validate the sealed ARM userspace iiOD without ever executing it."""

    binary = release / SCANNER_IIOD_RELATIVE_PATH
    info = binary.lstat()
    group = grp.getgrnam("leo").gr_gid if expected_gid is None else expected_gid
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_nlink != 1
        or info.st_uid != expected_uid
        or info.st_gid != group
    ):
        raise ValueError("scanner iiOD must be a singly-linked root:leo regular file")
    if stat.S_IMODE(info.st_mode) != 0o550:
        raise ValueError("scanner iiOD mode must be 0550")
    if info.st_size != expected_size:
        raise ValueError("scanner iiOD size differs from the reviewed artifact")
    with binary.open("rb") as stream:
        header = stream.read(52)
    if (
        len(header) != 52
        or header[:7] != b"\x7fELF\x01\x01\x01"
        or header[7] not in (0, 3)
    ):
        raise ValueError("scanner iiOD is not an ELF32 little-endian System V/GNU artifact")
    elf_type, machine, version = struct.unpack_from("<HHI", header, 16)
    flags = struct.unpack_from("<I", header, 36)[0]
    if elf_type not in (2, 3) or machine != 40 or version != 1:
        raise ValueError("scanner iiOD is not an executable ARM ELF")
    if flags & 0xFF000000 != 0x05000000:
        raise ValueError("scanner iiOD is not ARM EABI5")
    observed_sha256 = _sha256(binary)
    if observed_sha256 != expected_sha256:
        raise ValueError("scanner iiOD digest differs from the reviewed artifact")
    return observed_sha256


def validate_scanner_iiod_provenance(release: Path) -> None:
    provenance = release / SCANNER_IIOD_PROVENANCE_RELATIVE_PATH
    info = provenance.lstat()
    if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o440:
        raise ValueError("scanner iiOD provenance must be a 0440 regular file")
    try:
        document = json.loads(provenance.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ValueError("scanner iiOD provenance is unreadable") from error
    if not isinstance(document, dict):
        raise ValueError("scanner iiOD provenance is not an object")
    artifact = document.get("artifact")
    source = document.get("source")
    runtime = document.get("runtime")
    if (
        document.get("schema") != "spf.iiod-build-provenance.v1"
        or document.get("hardware_accessed") is not False
        or not isinstance(artifact, dict)
        or artifact.get("sha256") != SCANNER_IIOD_SHA256
        or artifact.get("size_bytes") != SCANNER_IIOD_SIZE_BYTES
        or artifact.get("elf_machine") != "ARM"
        or artifact.get("libiio_linkage") != "static"
        or artifact.get("undefined_iio_symbol_count") != 0
        or not isinstance(source, dict)
        or source.get("head") != SCANNER_IIOD_LIBIIO_REVISION
        or source.get("origin_master") != SCANNER_IIOD_LIBIIO_REVISION
        or source.get("worktree_clean") is not True
        or not isinstance(runtime, dict)
        or runtime.get("recommended_release_relative_path")
        != SCANNER_IIOD_RELATIVE_PATH.as_posix()
        or runtime.get("interactive_flag_must_be_absent") is not True
    ):
        raise ValueError("scanner iiOD provenance does not identify the reviewed artifact")


def validate_release_uv(release: Path) -> str:
    uv = release / ".release-tools/uv"
    if uv.is_symlink() or not uv.is_file() or not os.access(uv, os.X_OK):
        raise ValueError(f"sealed release uv is absent or not executable: {uv}")
    result = subprocess.run(
        (str(uv), "--version"),
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=30,
        check=True,
    )
    if not result.stdout.strip():
        raise ValueError("sealed release uv returned an empty version")
    return result.stdout.strip()


def validate_metadata_runtime(python: Path) -> None:
    """Verify ABI 3 from a fresh process before any pyadi-capable entrypoint."""

    environment = dict(os.environ)
    for name in ("LD_LIBRARY_PATH", "PYTHONPATH", "PLUTO_LIBIIO_LIBRARY"):
        environment.pop(name, None)
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    program = (
        "from pluto_plus.hardware.preflight import verify_metadata_runtime; "
        f"result = verify_metadata_runtime(expected_abi={PRODUCTION_METADATA_ABI}); "
        f"assert result.metadata_abi == {PRODUCTION_METADATA_ABI}"
    )
    # Isolated mode ignores PYTHON* variables, so -B is the effective
    # no-bytecode boundary when this validator is invoked by root.
    subprocess.run(
        (str(python), "-I", "-B", "-c", program),
        env=environment,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        timeout=30,
        check=True,
    )


def validate_pluto_plus_utils_revision(release: Path) -> str:
    """Close the installed hardware adapter against the immutable uv authority."""

    with (release / "pyproject.toml").open("rb") as stream:
        project = tomllib.load(stream)
    expected = project["tool"]["uv"]["sources"]["pluto-plus-utils"]["rev"]
    if not isinstance(expected, str) or len(expected) != 40:
        raise ValueError("pluto-plus-utils uv authority is not one full revision")
    payload = importlib.metadata.distribution("pluto-plus-utils").read_text("direct_url.json")
    try:
        direct_url = json.loads(payload or "")
    except json.JSONDecodeError as error:
        raise ValueError("installed pluto-plus-utils lacks VCS provenance") from error
    vcs = direct_url.get("vcs_info") if isinstance(direct_url, dict) else None
    if not isinstance(vcs, dict) or vcs.get("vcs") != "git" or vcs.get("commit_id") != expected:
        raise ValueError("installed pluto-plus-utils revision differs from uv authority")
    return expected


def validate(release: Path, forbidden_path: str) -> None:
    release = _safe_absolute(release, "release")
    validate_scanner_iiod_binary(release)
    validate_scanner_iiod_provenance(release)
    validate_release_uv(release)
    venv = _safe_absolute(release / ".venv", "release venv")
    python = venv / "bin/python"
    validate_metadata_runtime(python)
    entrypoints = tuple(venv / "bin" / name for name in ("leo", "leo-api", "leo-release-qualify"))
    for entrypoint in entrypoints:
        if not entrypoint.is_file() or not os.access(entrypoint, os.X_OK):
            raise ValueError(f"release entrypoint is absent or not executable: {entrypoint}")
        expected = f"#!{python}\n".encode()
        with entrypoint.open("rb") as stream:
            if stream.readline() != expected:
                raise ValueError(f"release entrypoint has a non-final interpreter: {entrypoint}")

    commands = (
        (str(entrypoints[0]), "--help"),
        (str(entrypoints[1]), "--check"),
        (str(entrypoints[2]), "--help"),
    )
    runtime_environment = dict(os.environ)
    runtime_environment["PYTHONDONTWRITEBYTECODE"] = "1"
    for command in commands:
        subprocess.run(
            command,
            env=runtime_environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30,
            check=True,
        )

    # This validator is sometimes invoked by root before service startup.  A
    # validation read must never create root-owned bytecode in the immutable
    # release selected for the unprivileged service.
    sys.dont_write_bytecode = True
    import leo

    module_path = Path(leo.__file__).absolute()
    if module_path.is_symlink() or not module_path.is_file():
        raise ValueError(f"leo module is not a regular release file: {module_path}")
    site_root = venv
    if site_root not in module_path.parents:
        raise ValueError(f"leo imports outside the release venv: {module_path}")
    validate_pluto_plus_utils_revision(release)
    if forbidden_path:
        forbidden = str(Path(forbidden_path).absolute())
        if any(forbidden in item for item in sys.path):
            raise ValueError("forbidden staging path remains in Python sys.path")
        stale = find_forbidden_reference(venv, forbidden)
        if stale is not None:
            raise ValueError(f"forbidden staging path remains in release venv: {stale}")
    direct_url = importlib.metadata.distribution("leo-tracker").read_text("direct_url.json")
    if direct_url and '"editable":true' in direct_url.replace(" ", ""):
        raise ValueError("leo-tracker is still installed editable")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("release", type=Path)
    parser.add_argument("forbidden_path")
    options = parser.parse_args()
    try:
        validate(options.release, options.forbidden_path)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"PUBLISHED RELEASE INVALID: {error}", file=sys.stderr)
        return 1
    print(f"validated published release runtime: {options.release}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
