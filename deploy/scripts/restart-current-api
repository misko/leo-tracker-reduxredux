#!/usr/bin/env bash
# Restart only the API for an already-selected immutable release.
set -euo pipefail

if [[ $# -ne 0 ]]; then
  echo "usage: sudo $0" >&2
  exit 64
fi
if [[ $EUID -ne 0 ]]; then
  echo "restart-current-api must run as root" >&2
  exit 77
fi

current=/opt/leo-tracker/current
[[ -L "$current" ]] || { echo "current release selector is not a symlink" >&2; exit 65; }
target=$(/usr/bin/readlink -- "$current")
[[ "$target" =~ ^releases/([0-9a-f]{40})$ ]] || {
  echo "current release selector is not one exact relative release SHA" >&2
  exit 65
}
revision=${BASH_REMATCH[1]}
release=/opt/leo-tracker/releases/$revision
metadata=/opt/leo-tracker/release-metadata/$revision.txt

[[ -d "$release" && ! -L "$release" ]] || {
  echo "selected immutable release is unavailable" >&2
  exit 65
}
[[ -f "$metadata" && ! -L "$metadata" ]] || {
  echo "selected release has no sealed publication metadata" >&2
  exit 65
}
[[ $(/usr/bin/stat -c '%U:%G:%a' -- "$metadata") == root:leo:440 ]] || {
  echo "selected release metadata ownership or mode is invalid" >&2
  exit 65
}
[[ -x "$release/.venv/bin/leo-api" ]] || {
  echo "selected release has no executable API entrypoint" >&2
  exit 65
}

started_ms=$(/usr/bin/date +%s%3N)
/usr/bin/systemctl restart leo-api.service
for ((attempt = 0; attempt < 300; attempt += 1)); do
  if /usr/bin/curl --fail --silent --show-error --max-time 1 \
    http://127.0.0.1:8090/api/v1/status >/dev/null 2>&1; then
    finished_ms=$(/usr/bin/date +%s%3N)
    echo "API READY release=$revision elapsed_ms=$((finished_ms - started_ms))"
    exit 0
  fi
  /usr/bin/sleep 0.1
done

echo "API restart did not become healthy within 30 seconds" >&2
/usr/bin/systemctl status leo-api.service --no-pager >&2 || true
/usr/bin/journalctl -u leo-api.service --since '1 minute ago' --no-pager -n 80 >&2 || true
exit 1
