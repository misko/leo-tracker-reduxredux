#!/usr/bin/env bash
set -euo pipefail

report_root=${LEO_SCANNER_REPORT_ROOT:-/srv/bulk/leo/scanner-reports}
scanner_host=${LEO_SCANNER_HOST:-192.168.1.20}
scanner_dwell_ms=${LEO_SCANNER_DWELL_MS:-80}

[[ "$report_root" = /* ]] || {
  echo "LEO_SCANNER_REPORT_ROOT must be absolute" >&2
  exit 64
}
case "$report_root/" in
  /mnt/qnap01/*) echo "scanner reports cannot be written beneath QNAP" >&2; exit 65 ;;
esac
[[ -d "$report_root" && ! -L "$report_root" ]] || {
  echo "scanner report root must be an existing real directory: $report_root" >&2
  exit 66
}
[[ "$scanner_dwell_ms" =~ ^[0-9]+$ ]] || {
  echo "LEO_SCANNER_DWELL_MS must be an integer" >&2
  exit 64
}

stamp=$(date -u +%Y%m%dT%H%M%SZ)
output="$report_root/starlink-scan-$stamp.json"

exec /opt/leo-tracker/current/.venv/bin/leo scan starlink \
  --host "$scanner_host" \
  --dwell-ms "$scanner_dwell_ms" \
  --output "$output" \
  --json
