{
  "schema": "org.leo.research.presence-dwell-controls/v1",
  "scope": "Synthetic development controls, not RF specificity or untouched holdout",
  "rates_hz": [2500000, 5000000],
  "edges": ["lower", "upper"],
  "seeds": [1901, 1902, 1903, 1904],
  "negative_kinds": ["white_noise", "colored_noise", "tone", "two_tones", "pulsed_tone"],
  "positive_kinds": ["pilot", "pilot_plus_tone"],
  "positive_windows": [0, 1, 2, 3, 4, 5],
  "receiver": 1,
  "dwell_ms": 120,
  "screen_bins": 512,
  "mode": "blind",
  "research_margin": 0.025,
  "policies": [1, 2, 3, 6],
  "maximum_confirmations": 6,
  "live_rf_authorized": false
}
