    "current_semantics": {
      "anchor_measurement": "IioMetadataCaptureSession.open captures eight host-monotonic intervals around ADC_SAMPLE_COUNTER_LOW_REG register reads after the MetadataBuffer constructor returns, spaced 5 ms apart, then captures a host realtime mapping.",
      "first_sample_mapping": "first_sample_clock_bracket extends those low-32 counter anchors near the ABI header first_sample_counter, fits host monotonic time versus counter under a rate tolerance, adds fit plus realtime-map uncertainty, and maps interval endpoints to realtime.",
      "host_adapter": "iio_host_adaptive_hop.py only subclasses IioPersistentHopBackend; it contains no independent start_clock_bracket implementation.",
      "not_a_receive_timestamp": "The current path does not use an IQ receive timestamp or a direct first-buffer-begin timestamp. It is an inferred first-counter time from post-OPEN FPGA register counter reads and the sequence-zero metadata header counter.",
      "open_then_refine": "IioPersistentHopBackend first stores capture.open_clock_bracket after metadata OPEN, then on ABI-3 block sequence zero replaces it with capture.first_sample_clock_bracket(evidence.block_first_counter, sample_rate_hz)."
    },
