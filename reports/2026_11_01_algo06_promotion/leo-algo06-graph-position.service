[Unit]
Description=ALGO06 causal new-family recovery preserving completed ALGO05 positions
After=local-fs.target leo-algo05-graph-position.service
RequiresMountsFor=/srv/bulk/leo

[Service]
Type=simple
User=leo
Group=leo
WorkingDirectory=/opt/leo-fast-graph/cf16ac5bd6a8f1ac65f626eba57326f2a2d2e6b5
Environment=PYTHONPATH=/opt/leo-fast-graph/cf16ac5bd6a8f1ac65f626eba57326f2a2d2e6b5/src:/opt/leo-fast-graph/cf16ac5bd6a8f1ac65f626eba57326f2a2d2e6b5/tools
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=MPLCONFIGDIR=/srv/bulk/leo/presentation-cache/matplotlib
ExecStartPre=+/usr/bin/install -d -o leo -g leo -m 0750 /srv/bulk/leo/fast-scan-graph-position-v5
ExecStart=/opt/leo-fast-graph/cf16ac5bd6a8f1ac65f626eba57326f2a2d2e6b5/venv/bin/python -B -m leo.cli.fast_graph_position_v5 --bulk-root /srv/bulk/leo --minimum-completed-utc-ns 1793547403554291164 --maximum-seconds 1200
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
UMask=0027
Nice=10
CPUWeight=100
IOWeight=50
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/bulk/leo
InaccessiblePaths=/mnt/qnap01

[Install]
WantedBy=multi-user.target
