#!/opt/leo-algo08/bdb869682a2ea63af4b198a920b763a4c6a78c4c/venv/bin/python -IB
"""Run the ALGO08v3 full-member prefetch and orbit-support research successor."""
import argparse
import json
import os
import runpy
import sys
from contextlib import ExitStack, contextmanager
from hashlib import sha256
from importlib import import_module
from importlib.util import module_from_spec, spec_from_file_location
from pathlib import Path
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[3]
BASELINE = Path("/opt/leo-algo08/algo08v3/run")
BASELINE_SHA256 = "fae032526227f55ca2419a0b29c69afc7fc97fa04508f33d0403802934f13448"
FROZEN_SPEC = "6cdbac1e8496bfeaf8f3eefb90c936c65829629cc42d04b4a9bab7c6e97cf50f"
EXPERIMENTAL = "tools.pipeline_eval.variants.experimental"
PREFETCH = f"{EXPERIMENTAL}.receiver_member_prefetch"
INGRESS = f"{EXPERIMENTAL}.receiver_ingress"
LOOKAHEAD = f"{EXPERIMENTAL}.receiver_member_lookahead"
ORBIT_GUARD = "tools.pipeline_eval.variants.v5_orbit_domain"
SOURCE_PINS = {
    PREFETCH: "05b3b619429e1e35c9e9f811b3a68e68df6a6f6b37e7c05338dccd91fb0db8cc",
    INGRESS: "c58f76ae56022aca3893b04bfe4732f24185e9b98294c543a31abf752c264fa8",
    LOOKAHEAD: "3e89683eeea48443d6a6c9cf81c843189ccfa4638206e7f57e182489c905791e",
    ORBIT_GUARD: "14be68cd3af6906dbe0df64841e6a756e93caf234ad11b553bd1d8937fc2e18f",
}


def checked_bytes(path, expected):
    data = path.read_bytes()
    if sha256(data).hexdigest() != expected:
        raise ValueError(f"Research build source changed: {path}")
    return data


def source_path(name):
    return Path(name.replace(".", "/") + ".py")


def checked_build():
    checked_bytes(BASELINE, BASELINE_SHA256)
    installed = runpy.run_path(str(BASELINE))
    payload = BASELINE.parent / "payload"
    spec = installed["checked_spec"](payload, FROZEN_SPEC)
    if spec["member_lookahead"] is not True or spec["startup"] != "lazy-exports":
        raise ValueError("Expected the frozen ALGO08v3 lookahead and startup")
    sources = {
        name: checked_bytes(ROOT / source_path(name), pin) for name, pin in SOURCE_PINS.items()
    }
    identity = dict(
        version="ALGO08v3 successor research", frozen_specification="sha256:" + FROZEN_SPEC,
        baseline_launcher_sha256=BASELINE_SHA256, detector_sha256=spec["detector_sha256"],
        runtime=str(installed["RELEASE"]),
        research_sources={str(source_path(name)): pin for name, pin in SOURCE_PINS.items()},
        successor_launcher_sha256=sha256(Path(__file__).read_bytes()).hexdigest(),
    )
    return payload, spec, sources, identity


def research_module(name, source):
    # Resolve the existing relative imports from the installed payload. Execute
    # the already checked bytes and give the overlay its own module identity.
    module_name = name + "_research"
    path = ROOT / source_path(name)
    module = module_from_spec(spec_from_file_location(module_name, path))
    sys.modules[module_name] = module
    exec(compile(source, str(path), "exec"), vars(module))
    return module


def install_payload(payload, identity):
    release = Path(identity["runtime"])
    imports = [str(payload), str(release / "src"), str(release)]
    sys.path[:0] = imports
    os.environ["PYTHONPATH"] = os.pathsep.join(imports)
    for name in ("OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "OMP_NUM_THREADS", "BLIS_NUM_THREADS"):
        os.environ[name] = "1"

    from tools.pipeline_eval.qualification import experimental_publication as publication

    if Path(publication.__file__).resolve() != payload / source_path(publication.__name__):
        raise ValueError("Expected the installed ALGO08v3 publication entry point")
    return publication


def research_overlays(sources):
    # The installed modules predate these two helpers. Let the prefetch module
    # capture the research functions without replacing the frozen adapters.
    ingress = research_module(INGRESS, sources[INGRESS])
    lookahead = research_module(LOOKAHEAD, sources[LOOKAHEAD])
    with (
        patch.object(import_module(INGRESS), "read_regular_descriptor",
                     ingress.read_regular_descriptor, create=True),
        patch.object(import_module(LOOKAHEAD), "following_members",
                     lookahead.following_members, create=True),
    ):
        prefetch = research_module(PREFETCH, sources[PREFETCH]).compressed_member_prefetch
    guard = research_module(ORBIT_GUARD, sources[ORBIT_GUARD]).corner_support
    return prefetch, guard


def verify_imports(publication, spec, sources):
    from tools.pipeline_eval.variants.experimental import lean_startup

    lean_startup.install()
    import_module("tools.algo08_scan")
    publication._checked_member_lookahead(spec)
    research_overlays(sources)


def publish(args, publication, spec, sources, identity):
    check_lookahead = publication._checked_member_lookahead
    support_stats = {}

    def research_lookahead(specification):
        check_lookahead(specification)
        from tools import algo08_position

        prefetch, guard = research_overlays(sources)

        @contextmanager
        def measured_guard():
            with guard() as stats:
                support_stats.update(stats=stats)
                yield

        stack.enter_context(patch.object(algo08_position, "corner_support", measured_guard))
        return prefetch

    with ExitStack() as stack:
        stack.enter_context(
            patch.object(publication, "_checked_member_lookahead", research_lookahead)
        )
        result = publication.run(args, spec)
    result["member_prefetch"] = result.pop("member_lookahead")
    result["orbit_support_guard"] = dict(
        entered=bool(support_stats), **support_stats.get("stats", {}),
    )
    marker = dict(identity, session_id=result["session_id"], decision=result["decision"])
    with (args.bulk_root / "algo08v3-successor.json").open("x") as stream:
        json.dump(marker, stream)
        stream.write("\n")
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--verify", action="store_true")
    for name in ("recording", "archive", "region", "bulk-root"):
        parser.add_argument("--" + name, type=Path)
    args = parser.parse_args()
    if not args.verify and not all((args.recording, args.archive, args.region, args.bulk_root)):
        parser.error("supply --recording, --archive, --region and a new empty --bulk-root")
    payload, spec, sources, identity = checked_build()
    publication = install_payload(payload, identity)
    if args.verify:
        verify_imports(publication, spec, sources)
        print(json.dumps(identity))
    else:
        print(json.dumps(publish(args, publication, spec, sources, identity)))


if __name__ == "__main__":
    main()
