--- /dev/null
+++ b/tools/pipeline_eval/qualification/direct_clock_worker.py
@@ -0,0 +1,34 @@
+"""Read authenticated GLRT files through the normal bounded native worker."""
+
+import json
+import sys
+from resource import RLIMIT_AS, setrlimit
+from unittest.mock import patch
+
+from ..variants import native_lean as native
+
+
+def main():
+    started = native._now()
+    limit = native.AS_LIMIT_MIB * 1024**2
+    setrlimit(RLIMIT_AS, (limit, limit))
+    request = json.load(sys.stdin)
+    imported = native._now()
+    from ..variants import direct_clock, robust_orbit_fit
+
+    elapsed = native._elapsed(imported)
+    method = request.pop("method")
+
+    def infer(document, offer, catalogue):
+        return direct_clock.infer(document, offer, catalogue, method)
+
+    with patch.object(robust_orbit_fit, "infer", infer):
+        report = native.worker(request)
+    report["result"]["boundary"] = direct_clock.BOUNDARY
+    report["stages"]["backend_import"] = elapsed
+    report["worker"] = native._elapsed(started)
+    json.dump(report, sys.stdout, sort_keys=True, allow_nan=False)
+
+
+if __name__ == "__main__":
+    main()
