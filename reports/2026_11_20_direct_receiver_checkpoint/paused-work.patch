new file mode 100644
index 000000000..c35e06990
--- /dev/null
+++ b/tools/pipeline_eval/qualification/direct_clock_trial.py
@@ -0,0 +1,173 @@
+"""Freeze and replay disjoint development and held stored-GLRT cohorts."""
+
+import argparse
+import gzip
+import json
+import os
+import subprocess
+import sys
+from concurrent.futures import ThreadPoolExecutor
+from hashlib import sha256
+from pathlib import Path
+from time import perf_counter
+
+import numpy as np
+
+from leo.sky.frames import ecef_to_enu_matrix, geodetic_to_ecef_km
+
+from ..__main__ import ROOT, encoded, local_output, save_json, write
+from ..scoring import ARMS, validate_result
+from ..variants.projected_fit import Region
+from . import track_quadrature_trial as prior
+from .fresh_scenes import _read, _sha
+
+REPORT = ROOT / "reports/2026_11_19_receiver_screening/direct-receiver/joint-clock"
+SEED = "direct-clock-20261120-v1:"
+CPUS = (12, 13)
+CAP_S = 90
+METHODS = ("split_lattice", "free_offset", "native_joint", "shifted_orbit")
+POSITIONS = "positions.jsonl.gz"
+WORKER = "tools.pipeline_eval.qualification.direct_clock_worker"
+
+
+def source_files():
+    paths = [
+        Path(__file__),
+        ROOT / "tools/pipeline_eval/qualification/direct_clock_worker.py",
+        ROOT / "tools/pipeline_eval/variants/direct_clock.py",
+        REPORT / "PROTOCOL.md",
+    ]
+    return prior.source_files() | {str(p.relative_to(ROOT)): _sha(p) for p in paths}
+
+
+def east_offer(offer):
+    center = tuple(offer["center"])
+    origin = geodetic_to_ecef_km(*center, 0.0)
+    frame = ecef_to_enu_matrix(*center)
+    region = Region("source", center, origin, frame)
+    far = region.site(np.array((50.0, 0.0)))[1]
+    return dict(offer, id="east-50-km", center=far)
+
+
+def jobs_for(cohort, inputs, counts):
+    ids = []
+    for dataset in ("DS26", "DS29"):
+        ranked = sorted(
+            (i for i in counts if i.startswith(dataset + "-")),
+            key=lambda i: sha256((SEED + inputs[i]["native"]["sha256"]).encode()).digest(),
+        )
+        ids.extend(ranked[:2] if cohort == "development" else ranked[2:5])
+    methods = METHODS[:2] if cohort == "development" else METHODS
+    jobs = [
+        dict(
+            id=ident, recording=ident, offer_type="ordinary",
+            packet=prior.packet(inputs[ident]),
+            cpu=CPUS[i % 2], order=methods[i % len(methods):] + methods[:i % len(methods)],
+            **counts[ident],
+        )
+        for i, ident in enumerate(ids)
+    ]
+    if cohort == "held":
+        base = jobs[0]
+        packet = dict(base["packet"], offer=east_offer(base["packet"]["offer"]))
+        jobs.append(dict(
+            base, id=base["id"] + "-east-50-km", offer_type="omitted",
+            packet=packet, order=("native_joint", "free_offset", "split_lattice"),
+        ))
+    return jobs
+
+
+def freeze(work, cohort):
+    work.mkdir(parents=True, exist_ok=False)
+    inputs = prior.frozen_inputs()
+    counts = prior.inventory(inputs)
+    save_json(
+        work / "source-lock.json",
+        dict(
+            cohort=cohort, seed=SEED, source=source_files(),
+            jobs=jobs_for(cohort, inputs, counts), census_size=len(counts),
+            timeout_s=CAP_S, address_space_mib=512, numerical_threads=1,
+        ),
+    )
+
+
+def attempt(job, method):
+    request = job["packet"]
+    started = perf_counter()
+    try:
+        process = subprocess.run(
+            ("taskset", "-c", str(job["cpu"]), sys.executable, "-m", WORKER),
+            cwd=ROOT, input=encoded(dict(request, method=method)),
+            capture_output=True, check=True, timeout=CAP_S, env=os.environ | prior.ENV,
+        )
+        out = json.loads(process.stdout)
+        if out["observation_sha256"] != job["observation_sha256"]:
+            raise ValueError("authenticated stored GLRT reconstructed a different track projection")
+    except (OSError, subprocess.SubprocessError, ValueError) as err:
+        reason = (getattr(err, "stderr", None) or b"").decode(errors="replace")[-1800:] or str(err)
+        out = dict(result=dict(
+            status="timed_out" if isinstance(err, subprocess.TimeoutExpired) else "failed",
+            reason=reason,
+            boundary="Stored GLRT to split-confirmed Doppler positioning",
+            metrics={},
+            arms={arm: dict(latlon=None) for arm in ARMS},
+        ))
+    validate_result(out["result"])
+    out.update(
+        id=job["id"], recording=job["recording"], offer_type=job["offer_type"], method=method,
+        cpu=job["cpu"], tile=request["offer"], input_sha256=sha256(encoded(request)).hexdigest(),
+        native_sha256=request["native"]["sha256"], catalog_sha256=request["catalogue"]["sha256"],
+        worker_wall_s=perf_counter() - started,
+    )
+    print(job["id"], method, out["result"]["status"], round(out["worker_wall_s"], 3), flush=True)
+    return out
+
+
+def predict(work, output):
+    manifest = work / "source-lock.json"
+    lock = _read(manifest)
+    if lock["source"] != source_files() or not set(CPUS) <= os.sched_getaffinity(0):
+        raise ValueError("locked source or designated CPUs unavailable")
+    journal = work / "predictions"
+    journal.mkdir()
+    output.mkdir(parents=True, exist_ok=True)
+    if (output / "prediction-lock.json").exists():
+        raise FileExistsError("predictions already sealed")
+
+    def lane(cpu):
+        for job in lock["jobs"]:
+            if job["cpu"] == cpu:
+                for method in job["order"]:
+                    save_json(journal / f"{job['id']}-{method}.json", attempt(job, method))
+
+    with ThreadPoolExecutor(len(CPUS)) as pool:
+        list(pool.map(lane, CPUS))
+    if lock["source"] != source_files():
+        raise ValueError("locked source changed during prediction")
+    rows = [
+        _read(journal / f"{job['id']}-{method}.json")
+        for job in lock["jobs"] for method in job["order"]
+    ]
+    write(output / POSITIONS, gzip.compress(b"".join(encoded(row) + b"\n" for row in rows), mtime=0))
+    write(output / manifest.name, manifest.read_bytes())
+    save_json(output / "prediction-lock.json", dict(
+        cases=[job["id"] for job in lock["jobs"]],
+        files={name: _sha(output / name) for name in (POSITIONS, manifest.name)},
+    ))
+
+
+def main():
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument("action", choices=("lock", "predict"))
+    cli.add_argument("work", type=local_output)
+    cli.add_argument("--output", type=local_output, default=REPORT)
+    cli.add_argument("--cohort", choices=("development", "held"), default="held")
+    args = cli.parse_args()
+    if args.action == "lock":
+        freeze(args.work, args.cohort)
+    else:
+        predict(args.work, args.output)
+
+
+if __name__ == "__main__":
+    main()
