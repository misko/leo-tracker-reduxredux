--- /dev/null
+++ b/tools/pipeline_eval/direct_kernels.py
@@ -0,0 +1,63 @@
+"""Build the shared Qin and compact CI16 detector for the portable field ABI."""
+
+import hashlib
+import os
+import platform
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+VARIANTS = ROOT / "tools/pipeline_eval/variants"
+KERNEL = ROOT / "native/adaptive/detector/kernel/private"
+SOURCES = (
+    VARIANTS / "portable_field.c",
+    VARIANTS / "portable_coarse.c",
+    VARIANTS / "portable_verifier.c",
+    VARIANTS / "portable_fine.c",
+    VARIANTS / "fine_search.c",
+    VARIANTS / "conditioned_cfo_bank.c",
+    VARIANTS / "refine_bank.c",
+    KERNEL / "fft_full.c",
+)
+HEADERS = (
+    *(VARIANTS / name for name in (
+        "portable_coarse.h", "portable_coarse_qin.h", "portable_fine.h", "portable_verifier.h",
+        "c_coarse_tiles.h", "c_fine_memory.h", "c_fine_memory_fft.inc",
+        "c_fine_memory_fractional.inc", "c_fine_memory_held.inc",
+    )),
+    KERNEL / "native_presence/fft.h",
+)
+FLAGS = (
+    "-std=c11", "-O3", "-Wall", "-Wextra", "-Werror", "-ffp-contract=off",
+    "-fopenmp-simd", "-DLEO_PRESENCE_ITERATIVE_FFT=1", "-fno-math-errno",
+    "-DLEO_DIRECT_KERNEL=1", "-shared", "-fPIC",
+)
+HOST_ARCH = {
+    "x86_64": ("-march=x86-64-v3",),
+    "aarch64": ("-march=armv8-a",),
+    "armv7l": ("-mcpu=cortex-a9", "-mfpu=neon", "-mfloat-abi=hard"),
+}
+
+
+def _digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def build(out, *, cc="cc", arch=None):
+    """Compile with the host defaults or explicit compiler and target flags."""
+    out = Path(out).resolve()
+    if arch is None:
+        arch = HOST_ARCH.get(platform.machine(), ())
+    binary = out / "portable-field.so"
+    command = [
+        str(cc), *FLAGS, *arch, "-I", str(KERNEL / "native_presence"),
+        *map(str, SOURCES), "-lm", "-o", str(binary),
+    ]
+    subprocess.run(command, check=True, cwd=out, env=os.environ | {"TMPDIR": str(out)}, timeout=45)
+    binary.chmod(0o444)
+    return dict(
+        command=command,
+        tool=subprocess.check_output([cc, "--version"], text=True).splitlines()[0],
+        binary=dict(path=str(binary), sha256=_digest(binary), bytes=binary.stat().st_size),
+        sources={str(path): _digest(path) for path in (*SOURCES, *HEADERS)},
+    )
