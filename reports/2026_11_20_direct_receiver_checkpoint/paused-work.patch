diff --git a/tools/pipeline_eval/variants/direct_clock.py b/tools/pipeline_eval/variants/direct_clock.py
new file mode 100644
index 000000000..1866808ff
--- /dev/null
+++ b/tools/pipeline_eval/variants/direct_clock.py
@@ -0,0 +1,353 @@
+"""Fit anonymous Doppler with a shared fractional clock and a tested alias level."""
+
+from collections import Counter
+from dataclasses import dataclass
+from hashlib import sha256
+from time import perf_counter, process_time
+
+import numpy as np
+from scipy.linalg import cholesky, solve_triangular
+from scipy.optimize import lsq_linear
+
+from . import robust_em as lean
+from . import robust_orbit_fit as exact
+from .track_quadrature import Trial as Screening, wraps_clock
+
+BOUNDARY = "Stored GLRT peaks and causal TLEs through split-confirmed Doppler positioning"
+LEVEL_SD_HZ = 350.0
+HALF_AGREEMENT_HZ = 750.0
+CEILINGS = (36.0, 16.0, 6.25)
+PHASE_CORRECTIONS = 2
+WRONG_TIME_S = 73
+
+
+@dataclass(frozen=True)
+class ArcLevel:
+    row: lean.Assignment
+    level_sd_hz: float
+
+
+def clock_design(track):
+    """Separate lane intercepts from two receiver-wide fractional-frequency trends."""
+    u = track.drift
+    scale = track.rf / 11.5e9
+    design = np.zeros((len(track.t), 11))
+    design[:, track.lane] = 1000.0
+    start = 4 + 3 * (track.lane // 2)
+    design[:, start:start + 3] = 1000 * scale * np.column_stack((u, u**2, u**3))
+    design[:, -1] = 1000 * (track.rf / 1e9 - 11.5)
+    return design
+
+
+def prior_radio(track, state):
+    return state.bias[track.lane] + state.drift[track.lane] * track.drift
+
+
+def stable_level(row, seed):
+    arc, j = row.arc, row.winner
+    raw = arc.residual[j] - arc.xy[j] @ seed.xy - arc.phase[j] * seed.phase[row.orbit]
+    raw -= prior_radio(arc.track, seed)
+    middle = len(raw) // 2
+    levels = np.array((np.median(raw[:middle]), np.median(raw[middle:])))
+    return bool(
+        np.all(np.rint(levels / lean.PERIOD) == row.alias)
+        and np.ptp(levels) <= HALF_AGREEMENT_HZ
+    )
+
+
+def profile(white, level_axis, sd):
+    """Whitened residual after analytically eliminating the track-level nuisance."""
+    norm2 = level_axis @ level_axis
+    attenuation = 0.0 if np.isinf(sd) else 1 / np.sqrt(1 + sd**2 * norm2)
+    return white - (1 - attenuation) * np.multiply.outer(level_axis, level_axis @ white) / norm2
+
+
+def posterior_level(white, level_axis, sd):
+    return float((white @ level_axis) / (level_axis @ level_axis + 1 / sd**2))
+
+
+@dataclass(frozen=True)
+class Estimate:
+    xy: np.ndarray
+    radio: np.ndarray
+    phase_s: np.ndarray
+    radius_km: float
+    score: float
+    rms_hz: float
+    raw_rms_hz: float
+    calibration_gain: float
+
+
+def project(tile, region, item, xy, phase):
+    row = item.row
+    track = row.arc.track
+    return exact.project(tile, row.orbit, track.t, region.site(xy)[0], phase, track.rf)
+
+
+def corrected(rows, tile, region, half, seed, fitted_c, counters):
+    """Solve position and shared clock with all integer decisions held fixed."""
+    orbit_ids = sorted({item.row.orbit for item in rows})
+    radio_columns = 10 + fitted_c
+    first_phase = 2 + radio_columns
+    by_orbit = {orbit: j + first_phase for j, orbit in enumerate(orbit_ids)}
+    width = first_phase + len(orbit_ids)
+    sigma = np.r_[
+        [1000.0] * 2,
+        [lean.PERIOD / np.sqrt(12) / 1000] * 4,
+        [1.5, .2, .2] * 2,
+        [200.0] * fitted_c,
+        [lean.PHASE_SD_S] * len(orbit_ids),
+    ]
+    limit = np.r_[
+        [half] * 2,
+        [lean.PERIOD / 1000] * 4,
+        [6.0, 1.5, 1.5] * 2,
+        [600.0] * fitted_c,
+        [lean.PHASE_BOUND_S] * len(orbit_ids),
+    ]
+    matrices, targets = [], []
+    xy, phases = (seed.xy, seed.phase) if isinstance(seed, lean.State) else (seed.xy, seed.phase_s)
+    tangent = exact._tangent(region, xy)
+    for item in rows:
+        row = item.row
+        track = row.arc.track
+        phase = phases[row.orbit]
+        base, d_site, d_phase = project(tile, region, item, xy, phase)
+        counters["projected_points"] += len(track.t)
+        dx = d_site @ tangent
+        design = np.zeros((len(track.t), width))
+        design[:, :2] = dx
+        design[:, 2:first_phase] = clock_design(track)[:, :radio_columns]
+        design[:, by_orbit[row.orbit]] = d_phase
+        target = track.hz - row.alias * lean.PERIOD - base + dx @ xy + d_phase * phase
+        axis = track.whiten.sum(axis=1)
+        weight = np.sqrt(min(1, 40 / len(target)) / (1 + row.loss / 4))
+        matrices.append(weight * profile(track.whiten @ design, axis, item.level_sd_hz))
+        targets.append(weight * profile(track.whiten @ target, axis, item.level_sd_hz))
+    if not matrices:
+        return None
+    matrix = np.vstack([*matrices, np.diag(1 / sigma)])
+    target = np.r_[np.concatenate(targets), np.zeros(width)]
+    counters["bounded_solves"] += 1
+    fit = lsq_linear(matrix, target, bounds=(-limit, limit), method="bvls", max_iter=30)
+    if not fit.success:
+        return None
+    information = matrix.T @ matrix
+    covariance = np.linalg.inv(information)
+    radius = float(np.sqrt(5.991 * np.linalg.eigvalsh(covariance[:2, :2])[-1]))
+    gain = 0.0
+    if fitted_c:
+        idx = first_phase - 1
+        gain = float(max(0, sigma[idx] ** 2 / covariance[idx, idx] - 1))
+    phase_s = np.zeros(len(tile.positions_km))
+    phase_s[orbit_ids] = fit.x[first_phase:]
+    radio = np.zeros(11)
+    radio[:radio_columns] = fit.x[2:first_phase]
+    radio[-1] = radio[-1] if gain > 1e-8 else 0.0
+    return Estimate(
+        fit.x[:2], radio, phase_s, radius, float(2 * fit.cost), 0, 0, gain,
+    )
+
+
+def locate(rows, tile, region, half, seed, fitted_c, counters):
+    for _ in range(PHASE_CORRECTIONS):
+        proposal = corrected(rows, tile, region, half, seed, fitted_c, counters)
+        if proposal is None:
+            return None
+        seed = proposal
+    squares = raw_squares = points = 0
+    for item in rows:
+        row = item.row
+        track = row.arc.track
+        prediction, _, _ = project(tile, region, item, seed.xy, seed.phase_s[row.orbit])
+        residual = track.hz - prediction - row.alias * lean.PERIOD - clock_design(track) @ seed.radio
+        level = posterior_level(
+            track.whiten @ residual, track.whiten.sum(axis=1), item.level_sd_hz,
+        )
+        raw_squares += residual @ residual
+        squares += (residual - level) @ (residual - level)
+        points += len(residual)
+        counters["projected_points"] += len(residual)
+    return Estimate(
+        seed.xy, seed.radio, seed.phase_s, seed.radius_km, seed.score,
+        float(np.sqrt(squares / points)), float(np.sqrt(raw_squares / points)), seed.calibration_gain,
+    )
+
+
+def nominate(arcs, n_orbits, half, counters):
+    """One common nominal track/alias roster without candidate-pair proposals."""
+    seed = lean.initial(arcs, n_orbits)
+    for ceiling in CEILINGS:
+        rows = [r for r in lean.assign(arcs, seed, update_phase=True) if r.loss <= ceiling]
+        counters["nomination_options"] += sum(len(arc.orbit) for arc in arcs)
+        counters["nomination_solves"] += 1
+        fit = lean.fit(rows, n_orbits, half, "c0")
+        if fit is None:
+            return None
+        seed = fit.state
+    return seed, rows
+
+
+def restrict(arc, subset):
+    """Build a marginal time block with its own covariance."""
+    t = arc.track.t[subset]
+    covariance = lean.CORRELATED_HZ**2 * np.exp(-abs(t[:, None] - t) / lean.CORRELATION_S)
+    covariance.flat[:: len(t) + 1] += lean.WHITE_HZ**2
+    whiten = solve_triangular(cholesky(covariance, lower=True), np.eye(len(t)), lower=True)
+    old = arc.track
+    tr = lean.Track(t, old.hz[subset], old.rf, old.lane, old.curved, old.drift[subset], whiten)
+    return lean.Arc(
+        tr, arc.orbit, arc.residual[:, subset], arc.xy[:, subset], arc.phase[:, subset],
+        arc.shape_loss, arc.phase_seed,
+    )
+
+
+def held_evidence(held, fit, tile, region, counters):
+    raw_squares = post_squares = points = 0
+    scores, good = [], set()
+    for early, late in held:
+        orbit = early.row.orbit
+        segments = []
+        for segment in (early, late):
+            track = segment.row.arc.track
+            base, _, _ = project(tile, region, segment, fit.xy, fit.phase_s[orbit])
+            residual = track.hz - base - segment.row.alias * lean.PERIOD
+            residual -= clock_design(track) @ fit.radio
+            segments.append((track.whiten, residual))
+            counters["projected_points"] += len(residual)
+        w, residual = segments[0]
+        level = posterior_level(w @ residual, w.sum(axis=1), early.level_sd_hz)
+        w, residual = segments[1]
+        error = residual - level
+        white = w @ error
+        loss = float(np.mean(white**2))
+        if loss <= CEILINGS[-1]:
+            good.add(orbit)
+        scores.append(1 / (1 + loss))
+        raw_squares += residual @ residual
+        post_squares += error @ error
+        points += len(error)
+    return dict(
+        held_score=float(np.mean(scores)),
+        held_orbits=len(good),
+        held_rf_rms_hz=float(np.sqrt(post_squares / points)),
+        held_raw_rf_rms_hz=float(np.sqrt(raw_squares / points)),
+        held_points=points,
+    )
+
+
+def train_and_predict(arcs, tile, region, half, method, trial):
+    counters = trial.work
+    n_orbits = len(tile.positions_km)
+    train = [arc for arc in arcs if int(arc.track.t.mean() // 12) % 5 != 2]
+    held = [arc for arc in arcs if int(arc.track.t.mean() // 12) % 5 == 2]
+    if len(train) < 5 or len(held) < 2:
+        return {}, {}, "insufficient_track_blocks"
+    nominal = nominate(train, n_orbits, half, counters)
+    if nominal is None:
+        return {}, {}, "no_training_assignment"
+    seed, training = nominal
+    pooled = [r for r in lean.assign(arcs, seed, update_phase=True) if r.loss <= CEILINGS[-1]]
+    counters["nomination_options"] += sum(len(arc.orbit) for arc in arcs)
+    if not pooled:
+        return {}, {}, "no_pooled_assignment"
+
+    def level(row):
+        return ArcLevel(row, LEVEL_SD_HZ if method != "free_offset" and stable_level(row, seed) else np.inf)
+
+    held_levels = []
+    for arc in held:
+        middle = len(arc.track.t) // 2
+        early, late = (restrict(arc, part) for part in (slice(None, middle), slice(middle, None)))
+        (row,) = lean.assign([early], seed, update_phase=False)
+        counters["nomination_options"] += len(early.orbit)
+        # The second half never chooses another orbit, alias, or nuisance value.
+        sd = LEVEL_SD_HZ if method != "free_offset" else np.inf
+        held_levels.append(
+            (ArcLevel(row, sd), ArcLevel(lean.Assignment(late, row.winner, row.alias, 0, 0), sd))
+        )
+    train_rows, rows = [level(r) for r in training], [level(r) for r in pooled]
+    ownership = [(r.orbit, r.alias, r.arc.track.lane, r.arc.track.t.tolist()) for r in pooled]
+    m = dict(
+        nomination_sha256=sha256(repr(ownership).encode()).hexdigest(),
+        fit_tracks=len(rows), anchored_tracks=sum(np.isfinite(r.level_sd_hz) for r in rows),
+        split_agree_tracks=sum(stable_level(r, seed) for r in pooled),
+        fit_points=sum(len(r.arc.track.t) for r in pooled),
+        anchor_aliases=sum(r.alias != 0 for r in pooled),
+        distinct_orbits=len({r.orbit for r in pooled}),
+        curved_orbits=len({r.orbit for r in pooled if r.arc.track.curved}),
+        separated_orbits=len({r.orbit for r in pooled if r.margin >= .25}),
+    )
+    fits, predictions = {}, {}
+    for arm in lean.ARMS:
+        fitted_c = arm == "fitted_c"
+        trained = trial.timed("fit", locate, train_rows, tile, region, half, seed, fitted_c, counters)
+        full = trial.timed("fit", locate, rows, tile, region, half, seed, fitted_c, counters)
+        if full is None or trained is None:
+            return {}, m, "no_paired_fit"
+        fits[arm] = full
+        predictions[arm] = trial.timed("held", held_evidence, held_levels, trained, tile, region, counters)
+        predictions[arm]["pooled_shift_km"] = float(np.linalg.norm(full.xy - trained.xy))
+    m["held_by_arm"] = predictions
+    reason = None
+    if m["curved_orbits"] < 4 or m["separated_orbits"] < 3 or len({r.arc.track.lane for r in pooled}) < 2:
+        reason = "insufficient_independent_orbit_support"
+    elif any(p["held_orbits"] < 2 or p["held_score"] < .28 for p in predictions.values()):
+        reason = "weak_held_track_support"
+    elif any(f.radius_km > 6 for f in fits.values()) or any(
+        p["pooled_shift_km"] > 4 for p in predictions.values()
+    ):
+        reason = "weak_position_geometry"
+    elif any(np.max(np.abs(f.xy)) >= half - .75 for f in fits.values()):
+        reason = "position_at_tile_boundary"
+    return fits, m, reason
+
+
+def infer(document, offer, catalogue, method):
+    if method == "native_joint":
+        return Screening("all_samples").infer(document, offer, catalogue)
+    if method not in ("split_lattice", "free_offset", "shifted_orbit"):
+        raise ValueError("unknown direct clock method")
+    trial = Screening("uniform_samples")
+    tracks, metrics = trial.timed("validate_pack", lean.observations, document)
+    half = float(offer.get("width_km", 25)) / 2
+    if not np.isfinite(half) or half <= 1:
+        raise ValueError("invalid offered width")
+    center = tuple(offer["center"])
+    fits, reason = {}, "insufficient_track_inventory"
+    if len(tracks) >= 7:
+        if method == "shifted_orbit":
+            document = dict(document, anchor_utc_ns=document["anchor_utc_ns"] + WRONG_TIME_S * 10**9)
+        sky = trial.timed("catalogue_init", exact.grid.prepare_sky, document, catalogue)
+        tile = trial.timed("regional_propagation", exact.grid.make_tile, sky, center)
+        arcs = [arc for track in tracks if (arc := trial.screen(tile, track)) is not None]
+        region = exact.Region(offer["id"], center, tile.ecef_center_km, tile.enu_frame)
+        fits, details, reason = trial.timed(
+            "solve", train_and_predict, arcs, tile, region, half, method, trial
+        )
+        metrics.update(sky.stats, **tile.stats, **details)
+    arms = {a: {"latlon": None, "forced_latlon": None} for a in lean.ARMS}
+    for arm, item in fits.items():
+        point = region.site(item.xy)[1]
+        arms[arm] = dict(
+            latlon=None if reason else point,
+            forced_latlon=point,
+            region_id=None if reason else offer["id"],
+            forced_region_id=offer["id"],
+            rf_rms_hz=item.rms_hz,
+            raw_rf_rms_hz=item.raw_rms_hz,
+            frequency_score=item.score,
+            c_hz_per_ghz=None if arm == "fitted_c" and item.calibration_gain <= 1e-8 else float(1000 * item.radio[-1]),
+            c_identifiable=arm == "c0" or item.calibration_gain > 1e-8,
+            c_data_precision_over_prior=item.calibration_gain,
+            radius_km=item.radius_km,
+            **metrics["held_by_arm"][arm],
+        )
+    metrics.update(stage_wall_s=dict(trial.wall), stage_cpu_s=dict(trial.cpu), work=dict(trial.work))
+    return dict(
+        status="withheld" if reason else "ok",
+        reason=reason,
+        boundary=BOUNDARY,
+        metrics=metrics,
+        arms=arms,
+    )
diff --git a/tools/pipeline_eval/variants/direct_fold_qin.h b/tools/pipeline_eval/variants/direct_fold_qin.h
new file mode 100644
index 000000000..3380ebb3f
--- /dev/null
+++ b/tools/pipeline_eval/variants/direct_fold_qin.h
@@ -0,0 +1,191 @@
+/* Included after the original Qin template and selector definitions. */
+enum { fold_phase = 256, fold_quarter = 16384, fold_score_bits = 22 };
+
+typedef struct { int32_t r, i; } FoldComplex;
+
+typedef struct {
+    FoldComplex carrier[fold_phase][tones/2], restore[fold_phase][tones];
+} FoldCarriers;
+
+typedef struct {
+    unsigned next, epoch, frame;
+    FoldComplex seam;
+    uint32_t inv_energy;
+} FoldAnchor;
+
+typedef struct {
+    FoldComplex samples[taps], value[taps][tones], sum[tones];
+    unsigned head;
+} FoldRing;
+
+static int32_t fold_round(int64_t value, unsigned bits) {
+    const int64_t half=INT64_C(1)<<(bits-1);
+    return (int32_t)((value+(value<0 ? -half : half))/(2*half));
+}
+
+static FoldComplex fold_mul(FoldComplex a, FoldComplex b, unsigned bits) {
+    return (FoldComplex){
+        fold_round((int64_t)a.r*b.r-(int64_t)a.i*b.i,bits),
+        fold_round((int64_t)a.r*b.i+(int64_t)a.i*b.r,bits)
+    };
+}
+
+static uint64_t fold_square(int32_t x) { return (uint64_t)((int64_t)x*x); }
+
+static uint64_t fold_sqrt(uint64_t x) {
+    if (!x) return 0;
+    unsigned bits=64u-(unsigned)__builtin_clzll((unsigned long long)x);
+    uint64_t n=UINT64_C(1)<<((bits+1)/2);
+    for (;;) {
+        const uint64_t next=(n+x/n)/2;
+        if (next>=n) return n;
+        n=next;
+    }
+}
+
+static int32_t fold_sine(const uint16_t *rom, unsigned phase) {
+    const unsigned quadrant=(phase>>14)&3, p=phase&(fold_quarter-1);
+    const int32_t value=rom[quadrant&1 ? fold_quarter-p : p];
+    return quadrant<2 ? value : -value;
+}
+
+static void fold_carriers(FoldCarriers *c) {
+    for (unsigned p=0; p<fold_phase; ++p) {
+        for (unsigned j=0; j<tones; ++j) {
+            const int bin=3*(2*(int)j-7);
+            const double phase=tau*((bin*(int)p)%fold_phase)/fold_phase;
+            const double adjusted=phase+tau*tone_hz(j)*prefix_time-tau/8;
+            if (j<tones/2)
+                c->carrier[p][j]=(FoldComplex){(int32_t)llround(32768*cos(phase)),
+                                               (int32_t)llround(32768*sin(phase))};
+            c->restore[p][j]=(FoldComplex){(int32_t)llround(131072*cos(adjusted)/sqrt(8.0)),
+                                          (int32_t)llround(131072*sin(adjusted)/sqrt(8.0))};
+        }
+    }
+}
+
+static void fold_load(PortableCoarse *w, const int16_t *iq, unsigned n, unsigned receiver) {
+    if (!w->fold_nco[fold_quarter])
+        for (unsigned j=0; j<=fold_quarter; ++j)
+            w->fold_nco[j]=(uint16_t)llround(32768*sin(tau*j/(4*fold_quarter)));
+    uint64_t energy=0;
+    for (unsigned k=0; k<n; ++k) {
+        const int16_t *incoming=iq+4*k+2*receiver;
+        energy+=fold_square(incoming[0])+fold_square(incoming[1]);
+        if (k>=taps) {
+            const int16_t *outgoing=incoming-4*taps;
+            energy-=fold_square(outgoing[0])+fold_square(outgoing[1]);
+        }
+        if (k+1>=taps) {
+            const uint64_t root=fold_sqrt(energy<<16);
+            w->fold_norm[k+1-taps]=root ? ((UINT64_C(1)<<40)-1)/root : 0;
+        }
+    }
+}
+
+static FoldComplex fold_push(FoldRing *ring, const FoldComplex sample, const FoldComplex *carrier) {
+    const unsigned p=ring->head;
+    FoldComplex *old=ring->value[p];
+    for (unsigned j=0; j<tones/2; ++j) {
+        const unsigned other=tones-1-j;
+        const int64_t rc=(int64_t)sample.r*carrier[j].r, rs=(int64_t)sample.r*carrier[j].i;
+        const int64_t ic=(int64_t)sample.i*carrier[j].r, is=(int64_t)sample.i*carrier[j].i;
+        const FoldComplex lo={fold_round(rc+is,15),fold_round(ic-rs,15)};
+        const FoldComplex hi={fold_round(rc-is,15),fold_round(ic+rs,15)};
+        ring->sum[j].r+=lo.r-old[j].r;
+        ring->sum[j].i+=lo.i-old[j].i;
+        ring->sum[other].r+=hi.r-old[other].r;
+        ring->sum[other].i+=hi.i-old[other].i;
+        old[j]=lo;
+        old[other]=hi;
+    }
+    ring->samples[p]=sample;
+    ring->head=(p+1)%taps;
+    return ring->samples[ring->head];
+}
+
+static uint32_t fold_pilot(const FoldComplex *tone, const uint8_t *state, FoldAnchor anchor,
+                           FoldComplex first, uint32_t norm) {
+    FoldComplex sum=fold_mul(first,anchor.seam,17);
+    for (unsigned j=0; j<tones; ++j) {
+        const unsigned phase=state[j];
+        const int32_t a=phase&1 ? tone[j].i : tone[j].r;
+        const int32_t b=phase&1 ? tone[j].r : tone[j].i;
+        sum.r+=phase<2 ? a : -a;
+        sum.i+=phase==0 || phase==3 ? b : -b;
+    }
+    const uint64_t magnitude=fold_sqrt(fold_square(sum.r)+fold_square(sum.i));
+    const uint64_t scaled=(magnitude*anchor.inv_energy+(UINT64_C(1)<<23))>>24;
+    const unsigned shift=8+32-fold_score_bits;
+    return (uint32_t)((scaled*norm+(UINT64_C(1)<<(shift-1)))>>shift);
+}
+
+static uint64_t fold_row(const PortableCoarse *w, const PilotAnchors *family, unsigned anchors_count,
+                         const FoldCarriers *tables, const int16_t *iq, unsigned n,
+                         unsigned receiver, double cfo, uint32_t scores[epochs]) {
+    FoldAnchor cursor[PORTABLE_COARSE_RETRY]={0};
+    for (unsigned j=0; j<anchors_count; ++j) {
+        cursor[j].next=family->start[j];
+        cursor[j].seam=(FoldComplex){(int32_t)llround(131072*family->seam_r[j]),
+                                     (int32_t)llround(131072*family->seam_i[j])};
+        cursor[j].inv_energy=(uint32_t)llround(16777216*family->inv_energy[j]);
+    }
+    FoldRing ring={0};
+    uint32_t phase=0;
+    const uint32_t step=(uint32_t)llround(-cfo/rate*4294967296.0);
+    uint64_t updates=0;
+    for (unsigned k=0; k<n; ++k) {
+        const unsigned index=(phase+32768u)>>16;
+        const FoldComplex osc={fold_sine(w->fold_nco,index+fold_quarter),
+                               fold_sine(w->fold_nco,index)};
+        phase+=step;
+        const int16_t *raw=iq+4*k+2*receiver;
+        const FoldComplex mixed=fold_mul((FoldComplex){raw[0],raw[1]},osc,7);
+        const FoldComplex first=fold_push(&ring,mixed,tables->carrier[k%fold_phase]);
+        if (k+1<taps+family->start[0]) continue;
+        const unsigned p=k+1-taps, restore_row=p%fold_phase;
+        const uint32_t norm=w->fold_norm[p];
+        FoldComplex tone[tones];
+        for (unsigned j=0; j<tones; ++j)
+            tone[j]=fold_mul(ring.sum[j],tables->restore[restore_row][j],17);
+        for (unsigned j=0; j<anchors_count; ++j) {
+            FoldAnchor *a=&cursor[j];
+            if (p!=a->next) continue;
+            if (norm) scores[a->epoch]+=fold_pilot(tone,family->states[j],*a,first,norm);
+            ++updates;
+            ++a->next;
+            if (++a->epoch==epochs) {
+                a->epoch=0;
+                a->next=++a->frame<max_frames ? family->start[j]+frame_offset(a->frame) : n;
+            }
+        }
+    }
+    return updates;
+}
+
+static void fold_grid(PortableCoarse *w, const PilotAnchors *family, const int16_t *iq,
+                      unsigned n, unsigned receiver, unsigned count, const double *residual,
+                      double center, unsigned rows) {
+    const unsigned limit=n-taps+1;
+    memset(w->support,0,sizeof(w->support));
+    for (unsigned s=0; s<count; ++s) {
+        for (unsigned f=0; f<max_frames; ++f) {
+            const unsigned origin=family->start[s]+frame_offset(f);
+            if (origin>=limit) break;
+            const unsigned end=limit-origin<epochs ? limit-origin : epochs;
+            for (unsigned e=0; e<end; ++e) ++w->support[e];
+        }
+    }
+    FoldCarriers tables;
+    fold_carriers(&tables);
+    for (unsigned f=0; f<rows; ++f) {
+        uint32_t scores[epochs]={0};
+        w->fold_updates+=fold_row(w,family,count,&tables,iq,n,receiver,center+residual[f],scores);
+        double *row=w->grid+f*epochs;
+        for (unsigned e=0; e<epochs; ++e)
+            row[e]=w->support[e] ? (double)scores[e]/((UINT32_C(1)<<fold_score_bits)*
+                                                     (double)w->support[e]) : 0;
+    }
+}
+
+uint64_t direct_fold_updates(const PortableCoarse *w) { return w->fold_updates; }
diff --git a/tools/pipeline_eval/variants/direct_geometry.c b/tools/pipeline_eval/variants/direct_geometry.c
new file mode 100644
index 000000000..5d586c705
--- /dev/null
+++ b/tools/pipeline_eval/variants/direct_geometry.c
@@ -0,0 +1,85 @@
+/* Project an ECEF state and its centered secant from one knot pair where possible. */
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+
+static void rotate(double a, double b, const double *trig, double out[3])
+{
+    out[0] = trig[0] * a - trig[1] * b;
+    out[1] = trig[1] * a + trig[0] * b;
+}
+
+static void project_state(const double *x, size_t start, size_t plus, size_t minus,
+                          double f0, double fp, double fm, const double *trig,
+                          const double *mean, const double *slope, double span,
+                          double out[3], double difference[3])
+{
+    const double *base = x + start;
+    double a = base[0] + f0 * (base[3] - base[0]);
+    double b = base[1] + f0 * (base[4] - base[1]);
+    rotate(a, b, trig, out);
+    out[2] = base[2] + f0 * (base[5] - base[2]);
+    if (plus == minus) {
+        const double *pair = x + plus;
+        double middle = (fp + fm) * 0.5;
+        double change = (fp - fm) / span;
+        double da = pair[3] - pair[0], db = pair[4] - pair[1];
+        double mid_a = pair[0] + middle * da, mid_b = pair[1] + middle * db;
+        rotate(change * da, change * db, mean, difference);
+        difference[0] += slope[0] * mid_a - slope[1] * mid_b;
+        difference[1] += slope[1] * mid_a + slope[0] * mid_b;
+        difference[2] = change * (pair[5] - pair[2]);
+        return;
+    }
+    const double *p = x + plus, *m = x + minus;
+    double upper[3], lower[3];
+    rotate(p[0] + fp * (p[3] - p[0]), p[1] + fp * (p[4] - p[1]), trig + 2, upper);
+    rotate(m[0] + fm * (m[3] - m[0]), m[1] + fm * (m[4] - m[1]), trig + 4, lower);
+    upper[2] = p[2] + fp * (p[5] - p[2]);
+    lower[2] = m[2] + fm * (m[5] - m[2]);
+    for (size_t j = 0; j < 3; ++j) difference[j] = (upper[j] - lower[j]) / span;
+}
+
+int project_orbit_grid(const double *pos, const double *vel, size_t satellites,
+                       size_t knots, size_t samples, size_t phase_rows,
+                       const int64_t *index, const double *fraction, const double *rotation,
+                       double step, const double *observer, const double *up, double rf,
+                       double *frequency, double *elevation_sine, double *derivative)
+{
+    double span = 2 * step;
+    for (size_t s = 0; s < satellites; ++s) {
+        const size_t group = phase_rows == 1 ? 0 : s;
+        const double *trig = rotation + group * 6;
+        const double mean[2] = {(trig[2] + trig[4]) * 0.5, (trig[3] + trig[5]) * 0.5};
+        const double slope[2] = {(trig[2] - trig[4]) / span, (trig[3] - trig[5]) / span};
+        const double *p_row = pos + 3 * s * knots, *v_row = vel + 3 * s * knots;
+        const int64_t *i0 = index + group * 3 * samples;
+        const double *f0 = fraction + group * 3 * samples;
+        for (size_t t = 0; t < samples; ++t) {
+            size_t i = (size_t)i0[t], p = (size_t)i0[t + samples], m = (size_t)i0[t + 2 * samples];
+            if (i >= knots - 1 || p >= knots - 1 || m >= knots - 1) return 2;
+            double xyz[3], v[3], dp[3], dv[3];
+            double fp = f0[t + samples], fm = f0[t + 2 * samples];
+            project_state(p_row, 3*i, 3*p, 3*m, f0[t], fp, fm, trig, mean, slope, span, xyz, dp);
+            project_state(v_row, 3*i, 3*p, 3*m, f0[t], fp, fm, trig, mean, slope, span, v, dv);
+            double squared_range = 0, radial = 0, vertical = 0;
+            double radial_change = 0, squared_range_half_change = 0;
+            for (size_t j = 0; j < 3; ++j) {
+                double delta = xyz[j] - observer[j];
+                squared_range += delta * delta;
+                radial += delta * v[j];
+                vertical += delta * up[j];
+                radial_change += dp[j] * v[j] + delta * dv[j];
+                squared_range_half_change += delta * dp[j];
+            }
+            double range = sqrt(squared_range);
+            if (!(range > 0) || !isfinite(range)) return 1;
+            size_t dest = s*samples + t;
+            frequency[dest] = -rf * (radial / range) / 299792.458;
+            elevation_sine[dest] = vertical / range;
+            derivative[dest] = -rf * (radial_change / range -
+                                      radial * squared_range_half_change / (range*squared_range)) / 299792.458;
+        }
+    }
+    return 0;
+}
diff --git a/tools/pipeline_eval/variants/direct_region_witness.py b/tools/pipeline_eval/variants/direct_region_witness.py
new file mode 100644
index 000000000..f6687f23c
--- /dev/null
+++ b/tools/pipeline_eval/variants/direct_region_witness.py
@@ -0,0 +1,298 @@
+"""Cross-predict receiver geography from disjoint measured Doppler arcs."""
+
+from dataclasses import dataclass, replace
+from itertools import product
+from math import dist
+
+import numpy as np
+
+from leo.sky.frames import ecef_to_enu_matrix, geodetic_to_ecef_km
+
+from ..reference import grid
+
+SCALE_HZ = 500.0
+CAP = 25.0
+LEAD = 0.0025
+SUPPORT_HZ = 750.0
+MIN_ARCS = 2
+MAX_ARCS = 16
+SHORTLIST = 12
+EDGE_KM = 0.75
+C_SHIFT = 100_000.0
+
+
+@dataclass(frozen=True)
+class Arc:
+    time: np.ndarray
+    frequency: np.ndarray
+    rf_hz: float
+    alias_hz: float
+
+    @property
+    def train(self):
+        return np.arange(len(self.time)) % 2 == 0
+
+
+@dataclass(frozen=True)
+class Frame:
+    ecef_center_km: np.ndarray
+    enu_frame: np.ndarray
+
+    @classmethod
+    def at(cls, point):
+        return cls(geodetic_to_ecef_km(*point, 0), ecef_to_enu_matrix(*point))
+
+    def project(self, xyz, up):
+        delta = xyz - self.ecef_center_km
+        vertical = (delta @ self.enu_frame[2]) / (up @ self.enu_frame[2])
+        return (delta - vertical[..., None] * up) @ self.enu_frame[:2].T
+
+
+@dataclass(frozen=True)
+class OrbitArc:
+    arc: Arc
+    train: np.ndarray
+    position: np.ndarray
+    velocity: np.ndarray
+    norad: np.ndarray
+
+    def rms(self, xyz, up):
+        delta = self.position[None] - xyz[:, None, None]
+        ray = delta / np.linalg.norm(delta, axis=-1, keepdims=True)
+        doppler = -self.arc.rf_hz / grid.LIGHT_SPEED_KM_S * np.sum(ray * self.velocity, axis=-1)
+        phase = 2 * np.pi / self.arc.alias_hz
+        residual = phase * (self.arc.frequency - doppler)
+        assignment = residual[..., self.train]
+        level = np.angle(np.mean(np.exp(1j * assignment), axis=-1))
+        residual = ((residual - level[..., None] + np.pi) % (2 * np.pi) - np.pi) / phase
+        visible = np.einsum("ijkl,il->ijk", ray, up) > 0
+        return tuple(
+            np.where(visible[..., mask].all(axis=-1), np.sqrt(np.mean(residual[..., mask] ** 2, axis=-1)), np.inf)
+            for mask in (self.train, ~self.train)
+        )
+
+
+def read_arcs(rows, duration):
+    arcs = []
+    for row in rows:
+        if set(row) != {"time", "frequency", "rf_hz", "alias_hz"}:
+            raise ValueError("an arc may contain only times, frequencies, RF and alias spacing")
+        t, f = np.asarray(row["time"], dtype=float), np.asarray(row["frequency"], dtype=float)
+        rf, alias = float(row["rf_hz"]), float(row["alias_hz"])
+        if (
+            t.ndim != 1 or f.shape != t.shape or not np.isfinite(t).all() or not np.isfinite(f).all()
+            or not np.isfinite([rf, alias]).all() or min(rf, alias) <= 0
+            or (t.size and (t[0] < 0 or t[-1] > duration)) or not np.all(np.diff(t) > 0)
+        ):
+            raise ValueError("invalid measured Doppler arc")
+        if len(t) >= 8 and np.ptp(t) >= 4:
+            arcs.append(Arc(t, f, rf, alias))
+    return sorted(arcs, key=lambda a: (a.time[0], a.time[-1], a.rf_hz, tuple(a.frequency)))
+
+
+def split(arcs):
+    """Use nonoverlapping time windows and purge every arc crossing the cut."""
+    cuts = sorted({a.time[0] for a in arcs} | {a.time[-1] for a in arcs})
+    best, key = ([], []), (0, 0)
+    for a, b in zip(cuts, cuts[1:]):
+        cut = (a + b) / 2
+        left = [arc for arc in arcs if arc.time[-1] < cut]
+        right = [arc for arc in arcs if arc.time[0] > cut]
+        grade = min(len(left), len(right)), len(left) + len(right)
+        if grade > key:
+            best, key = (left, right), grade
+    return tuple(sorted(group, key=lambda a: -np.ptp(a.time))[:MAX_ARCS] for group in best)
+
+
+def prepare(sky, arc, center, starts):
+    seconds = np.arange(sky.positions_km.shape[1]) * grid.COARSE_ORBIT_STEP_S - grid.PHASE_LIMIT_S
+    middle = min(np.searchsorted(seconds, np.median(arc.time)), len(seconds) - 1)
+    delta = sky.positions_km[:, middle] - center.ecef_center_km
+    candidates = (delta @ center.enu_frame[2]) > -0.22 * np.linalg.norm(delta, axis=-1)
+    sats = tuple(s for s, chosen in zip(sky.satellites, candidates, strict=True) if chosen)
+    valid, p, v = grid._valid_states(sats, sky.anchor_utc_ns, arc.time)
+    work = len(sats) * len(arc.time)
+    if not valid:
+        return None, work
+    bank = OrbitArc(arc, arc.train, p, v, np.array([s.satnum for s in valid]))
+    rms, _ = bank.rms(*starts)
+    keep = np.argsort(rms.min(axis=0), kind="stable")[:SHORTLIST]
+    return replace(bank, position=p[keep], velocity=v[keep], norad=bank.norad[keep]), work
+
+
+@dataclass(frozen=True)
+class Score:
+    train: np.ndarray
+    held: np.ndarray
+    norad: np.ndarray
+
+
+def loss(rms):
+    return np.minimum(CAP, (rms / SCALE_HZ) ** 2)
+
+
+def scores(bank, xyz, up):
+    train = np.full((len(xyz), len(bank)), np.inf)
+    held, norad = train.copy(), np.zeros(train.shape, dtype=int)
+    for i, sample in enumerate(bank):
+        if sample is None:
+            continue
+        fitted, checked = sample.rms(xyz, up)
+        selected = np.argmin(fitted, axis=1)
+        rows = np.arange(len(xyz))
+        train[:, i] = fitted[rows, selected]
+        held[:, i] = checked[rows, selected]
+        norad[:, i] = sample.norad[selected]
+    return [Score(a, b, c) for a, b, c in zip(train, held, norad, strict=True)]
+
+
+class Surface:
+    def __init__(self, frame, tiles, radius, bank):
+        self.frame, self.tiles, self.radius, self.bank = frame, tiles, radius, bank
+        self.cache = {}
+
+    def get(self, points):
+        unseen = list(dict.fromkeys(tuple(point) for point in points if tuple(point) not in self.cache))
+        for start in range(0, len(unseen), 24):
+            batch = unseen[start:start + 24]
+            xyz, up, coords = grid._sites(self.frame, np.asarray(batch))
+            margins = self.margins(xyz, up)
+            groups = np.where((margins >= 0).sum(axis=1) == 1, margins.argmax(axis=1), -1)
+            both = [scores(bank, xyz, up) for bank in self.bank]
+            for xy, point, group, a, b in zip(batch, coords, groups, *both, strict=True):
+                self.cache[xy] = (point.tolist(), int(group), (a, b))
+
+    def margins(self, xyz, up):
+        return np.column_stack([grid.HALF_WIDTH_KM - np.abs(tile.project(xyz, up)).max(axis=1) for tile in self.tiles])
+
+    def nominate(self, points, fold, group=None):
+        self.get(points)
+        chosen = [tuple(xy) for xy in points if group is None or self.cache[tuple(xy)][1] == group]
+        return min(chosen, key=lambda xy: loss(self.cache[xy][2][fold].train).mean())
+
+    def refine(self, start, fold, group=None):
+        xy = start
+        for step in (4.0, 1.0, 0.20):
+            neighbors = [tuple(np.asarray(xy) + step * offset) for offset in OFFSETS]
+            allowed = [p for p in neighbors if max(map(abs, p)) <= self.radius]
+            xy = self.nominate([xy, *allowed], fold, group)
+        return xy
+
+
+OFFSETS = np.asarray(list(product(range(-2, 3), repeat=2)))
+
+
+def compare(winner, rival, excluded):
+    a, b = loss(winner.held), loss(rival.held)
+    good = (winner.train <= SUPPORT_HZ) & (winner.held <= SUPPORT_HZ)
+    supported = {int(n) for n in winner.norad[good & (b - a > LEAD)]} - excluded
+    return dict(gain=float(np.mean(b - a)), votes=len(supported))
+
+
+def evaluate(surface, nominees, offer_ids):
+    witnesses = [n["free"] for n in nominees]
+    records = [surface.cache[xy] for xy in witnesses]
+    span = dist(*witnesses)
+    best = [min(range(4), key=lambda k: loss(surface.cache[n[k]][2][1 - i].held).mean())
+            for i, n in enumerate(nominees)]
+    held = [np.mean([loss(surface.cache[n[k]][2][1 - i].held).mean()
+                     for i, n in enumerate(nominees)]) for k in range(4)]
+    order = np.argsort(held, kind="stable")
+    top = int(order[0])
+    forced = min((n[top] for n in nominees),
+                 key=lambda p: sum(loss(s.held).mean() for s in surface.cache[p][2]))
+    result = dict(
+        decision="withheld", reason="split_geography_disagrees", region=None, point=None,
+        forced_region=offer_ids[top] if held[order[1]] - held[top] > 1e-12 else None,
+        forced_point=surface.cache[forced][0], split_span_km=span,
+        best_held_offers=[offer_ids[k] for k in best], held_offer_loss=dict(zip(offer_ids, map(float, held), strict=True)),
+        witness_points=[r[0] for r in records],
+        witness_regions=[offer_ids[r[1]] if r[1] >= 0 else "outside" for r in records],
+    )
+    group = records[0][1]
+    held_scores = [r[2][1 - i] for i, r in enumerate(records)]
+    supported = [set(map(int, s.norad[(s.held <= SUPPORT_HZ) & (s.train <= SUPPORT_HZ)])) for s in held_scores]
+    usable = np.concatenate([s.held[np.isfinite(s.held)] for s in held_scores])
+    result["held_rms_hz"] = float(np.sqrt(np.mean(usable ** 2))) if len(usable) else None
+    result["held_orbits"] = [len(s - supported[1 - i]) for i, s in enumerate(supported)]
+    if records[1][1] != group:
+        return result
+    if any(max(map(abs, xy)) > surface.radius - EDGE_KM for xy in witnesses):
+        return dict(result, reason="terrain_edge")
+    xyz, up, _ = grid._sites(surface.frame, np.asarray(witnesses))
+    margins = surface.margins(xyz, up)
+    clearance = float((-margins.max(axis=1)).min() if group == -1 else margins[:, group].min())
+    result["clearance_km"] = clearance
+    if clearance <= max(EDGE_KM, span / 2):
+        return dict(result, reason="uncertain_region_edge")
+    checks = []
+    for i, n in enumerate(nominees):
+        competitors = [k for k in range(-1, 4) if k != group]
+        checks.append([compare(held_scores[i], surface.cache[n[k]][2][1 - i], supported[1 - i])
+                       for k in competitors])
+    result["held_checks"] = checks
+    if any(c["gain"] <= LEAD or c["votes"] < MIN_ARCS for fold in checks for c in fold):
+        return dict(result, reason="weak_independent_advantage")
+    if group == -1:
+        return dict(result, decision="none", reason="outside_witness_replicates")
+    point = None
+    if span <= EDGE_KM and clearance > 1.0 and min(result["held_orbits"]) >= 3:
+        if result["held_rms_hz"] <= 250:
+            point = grid._sites(surface.frame, np.mean(witnesses, axis=0)[None])[2][0].tolist()
+    return dict(result, decision="region", region=offer_ids[group], reason="inside_witness_replicates", point=point)
+
+
+def solve(observation, catalogue, offers, *, coefficient=0.0, permutation=None):
+    if set(observation) != {"clock", "arcs"} or set(observation["clock"]) != {
+        "anchor_utc_ns", "cutoff_utc_ns", "catalog_timestamp_ns", "duration_s"
+    }:
+        raise ValueError("expected only anonymous arcs and a causal recording clock")
+    if len(offers) != 4 or any(set(o) != {"id", "center"} for o in offers):
+        raise ValueError("expected exactly four opaque offers")
+    if len({o["id"] for o in offers}) != 4 or len({tuple(o["center"]) for o in offers}) != 4:
+        raise ValueError("offer IDs and centers must be unique")
+    offers = sorted(offers, key=lambda o: tuple(o["center"]))
+    centers = np.asarray([o["center"] for o in offers])
+    arcs = read_arcs(observation["arcs"], observation["clock"]["duration_s"])
+    groups = split(arcs)
+    summary = dict(arcs=len(arcs), group_sizes=list(map(len, groups)), sample_count=sum(len(a.time) for a in arcs))
+    if min(map(len, groups)) < MIN_ARCS:
+        return dict(summary, decision="withheld", reason="too_few_disjoint_arcs")
+    sky = grid.prepare_sky(observation["clock"], catalogue)
+    units = np.array([ecef_to_enu_matrix(*p)[2] for p in centers])
+    x, y, z = units.mean(axis=0)
+    frame = Frame.at(np.rad2deg([np.arctan2(z, np.hypot(x, y)), np.arctan2(y, x)]))
+    tiles = [Frame.at(center) for center in centers]
+    centers_xy = frame.project(np.asarray([tile.ecef_center_km for tile in tiles]), units)
+    radius = float(np.max(np.abs(centers_xy)) + 55.0)
+    starts = grid._sites(frame, np.vstack((np.zeros((1, 2)), centers_xy)))[:2]
+    bank, work = [], 0
+    for group in groups:
+        models = []
+        for arc in group:
+            f = arc.frequency + coefficient * (arc.rf_hz / 1e9 - 11.5)
+            if permutation is not None:
+                f = permutation.permutation(f)
+            model, calls = prepare(sky, replace(arc, frequency=f), frame, starts)
+            models.append(model)
+            work += calls
+        bank.append(models)
+    surface = Surface(frame, tiles, radius, bank)
+    atlas = list(product(np.linspace(-radius, radius, 17), repeat=2))
+    for tile in tiles:
+        xy = np.asarray(list(product(np.linspace(-12.499, 12.499, 7), repeat=2)))
+        p, up, _ = grid._sites(tile, xy)
+        atlas.extend(map(tuple, frame.project(p, up)))
+    surface.get(atlas)
+    nominees = []
+    for fold in range(2):
+        local = {}
+        for group in range(-1, 4):
+            local[group] = surface.refine(surface.nominate(atlas, fold, group), fold, group)
+        training_best = min(local.values(), key=lambda xy: loss(surface.cache[xy][2][fold].train).mean())
+        local["free"] = surface.refine(training_best, fold)
+        nominees.append(local)
+    return summary | evaluate(surface, nominees, [o["id"] for o in offers]) | dict(
+        sgp4_exact_states=work, sgp4_coarse_states=sky.stats["coarse_state_evaluations"],
+        sites_evaluated=len(surface.cache), radius_km=radius,
+    )
