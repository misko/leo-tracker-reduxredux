+import json
+import os
+import sys
+from collections import Counter
+from contextlib import ExitStack
+from dataclasses import dataclass
+from hashlib import file_digest, sha256
+from pathlib import Path
+from time import perf_counter, process_time
+
+import numpy as np
+import scipy
+from scipy.fft import fft, ifft
+from scipy.signal import fftconvolve, find_peaks, firwin, resample_poly
+
+from leo.analysis.starlink import native_short_window as native
+from leo.analysis.starlink import templates
+
+SOURCE_RATE = 480_000_000
+RATE = 10_000_000
+PERIOD = RATE / 750
+ALIAS = 1 / 4.4e-6
+DECIMATE = SOURCE_RATE // RATE
+LOOK = 37_500
+DWELL = RATE // 50
+CENTERS = {"lower": -115_312_500, "upper": 115_312_500}
+OPPOSITE = {"lower": "upper", "upper": "lower"}
+PLANT_CFO = {"lower": 137_125, "upper": -179_375}
+DIGITAL_SHIFT = 171_875
+MARGIN_GATE = 0.025
+PHASE_GATE = 10
+CFO_GATE = 1000
+PSS_GATE = 0.12
+HELD_RATIO = 4.0
+SEED = 41821
+LIBRARY = Path("/srv/bulk/leo-dev/20261119-wide-regional/wide/libleo-adaptive-detector.so")
+LIBRARY_SHA = "db80b772cf9f52941cc0073067816e571308cb43c3096516b77f73ed54986c66"
+LOOKS = ("discovery", "held")
+MODES = ("measured", "cfo_shift", "wrong_edge", "permuted", "phase_null", "interior", "plant")
+
+
+@dataclass(frozen=True)
+class Endpoint:
+    phase_samples: float
+    tracked_hz: float
+    margin: float
+
+
+def digest(path: Path) -> str:
+    with path.open("rb") as stream:
+        return file_digest(stream, "sha256").hexdigest()
+
+
+def write_json(path: Path, value) -> None:
+    with path.open("x") as stream:
+        stream.write(json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n")
+
+
+def validate_seal(directory: Path, seal: dict[str, str]) -> None:
+    for name, expected in seal.items():
+        if digest(directory / name) != expected:
+            raise ValueError(f"changed sealed file: {name}")
+
+
+def load_iq(path: Path, count: int, expected_digest: str) -> np.ndarray:
+    if digest(path) != expected_digest:
+        raise ValueError("unexpected range digest")
+    with path.open("rb") as stream:
+        if stream.readline().rstrip(b"\r\n") != b"I_data,Q_data":
+            raise ValueError("expected primary I_data,Q_data CSV layout")
+        raw = np.loadtxt(stream, delimiter=",", dtype=np.float32, max_rows=count)
+    if raw.shape != (count, 2) or not np.isfinite(raw).all():
+        raise ValueError("missing or nonfinite source IQ pairs")
+    return np.ascontiguousarray(raw).view(np.complex64).ravel()
+
+
+def taps() -> np.ndarray:
+    return firwin(1537, 4e6, fs=SOURCE_RATE, window=("kaiser", 8.6)).astype(np.float32)
+
+
+def mix(iq: np.ndarray, frequency_hz: float, rate: int) -> np.ndarray:
+    return iq * np.exp((2j * np.pi * frequency_hz / rate) * np.arange(len(iq))).astype(np.complex64)
+
+
+def edge_lane(iq: np.ndarray, mixer_hz: float, filter_taps: np.ndarray) -> np.ndarray:
+    if len(iq) % DECIMATE or abs(mixer_hz) + RATE / 2 >= SOURCE_RATE / 2:
+        raise ValueError("unaligned input or incomplete lane span")
+    return resample_poly(mix(iq, -mixer_hz, SOURCE_RATE), 1, DECIMATE, window=filter_taps)
+
+
+def quantize(iq: np.ndarray, gain: float) -> tuple[np.ndarray, int]:
+    components = np.ascontiguousarray(iq, dtype="<c8").view("<f4").reshape(-1, 2)
+    rounded = np.rint(components * gain)
+    clipped = int(np.count_nonzero((rounded < -32768) | (rounded > 32767)))
+    ci16 = np.zeros((DWELL, 1, 2), dtype="<i2")
+    ci16[: len(iq), 0] = np.clip(rounded, -32768, 32767).astype("<i2")
+    return ci16, clipped
+
+
+def template_bank(edge: str) -> dict[str, tuple[np.ndarray, np.ndarray]]:
+    exact = templates.qin_edge_pilot_frame(RATE, edge).astype("<c16")
+    rolled = templates.qin_edge_pilot_frame(
+        RATE, edge, symbol_roll=templates.CONTROL_SYMBOL_ROLL
+    ).astype("<c16")
+    rng = np.random.default_rng(SEED)
+    active = exact[88:13288].reshape(300, 44)
+    shuffled = np.tile(exact, (2, 1))
+    for candidate in shuffled:
+        candidate[88:13288] = active[rng.permutation(len(active))].ravel()
+    return {"exact": (exact, rolled), "permuted": tuple(shuffled)}
+
+
+def plant_phase_s(look: str) -> float:
+    return {"discovery": 0.00018735, "held": 0.00033172}[look]
+
+
+def plant(look: str, edge: str, rng: np.random.Generator) -> np.ndarray:
+    count = LOOK * DECIMATE
+    components = rng.standard_normal((count, 2), dtype=np.float32) * 0.3
+    data = np.ascontiguousarray(components).view(np.complex64).ravel()
+    waveform = templates.qin_edge_pilot_frame(SOURCE_RATE, edge)
+    burst = mix(waveform, CENTERS[edge] + PLANT_CFO[edge], SOURCE_RATE)
+    for tick in range(3):
+        start = round((plant_phase_s(look) + tick / 750) * SOURCE_RATE)
+        span = min(len(burst), count - start)
+        data[start : start + span] += burst[:span] * np.exp(2j * np.pi * rng.random())
+    return data
+
+
+def phase_null(iq: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    return ifft(np.abs(fft(iq)) * np.exp(2j * np.pi * rng.random(len(iq)))).astype(np.complex64)
+
+
+def circular(delta: float, period: float) -> float:
+    return (delta + period / 2) % period - period / 2
+
+
+def choose_endpoint(result: dict) -> Endpoint | None:
+    valid = [
+        c for c in result["rows"][0]["candidates"] if c["fractional_epoch"]["status"] == "complete"
+    ]
+    if not valid:
+        return None
+    winner = max(valid, key=lambda c: c["fractional_epoch"]["margin"])
+    detail = winner["fractional_epoch"]
+    return Endpoint(
+        winner["epoch"] + detail["offset_samples"], detail["tracking_cfo_hz"], detail["margin"]
+    )
+
+
+def score_frame(iq: np.ndarray, template: np.ndarray, epoch: float, cfo_hz: float) -> float:
+    data_slots = np.arange(88, 13288)
+    base = int(np.floor(epoch))
+    fraction = epoch - base
+    first, last = base + data_slots[0], base + data_slots[-1] + 2
+    if first < 0 or last > len(iq):
+        raise ValueError("complete scoring interval required")
+    z = (1 - fraction) * iq[first : last - 1] + fraction * iq[first + 1 : last]
+    code = template[88:13288]
+    denom = float(np.vdot(code, code).real * np.vdot(z, z).real)
+    return float(abs(np.vdot(mix(code, cfo_hz, RATE), z)) ** 2 / denom) if denom else 0.0
+
+
+def discovery_offer(iq: np.ndarray, exact: np.ndarray, endpoint: Endpoint | None) -> dict:
+    if endpoint is None or endpoint.margin < MARGIN_GATE:
+        return {"status": "native_gate_failed"}
+    phase = endpoint.phase_samples % PERIOD
+    canonical = circular(endpoint.tracked_hz, ALIAS)
+    branches = [
+        {"cfo_hz": f, "coherence": score_frame(iq, exact, phase, f)}
+        for f in (canonical + k * ALIAS for k in range(-3, 4))
+    ]
+    selected = max(branches, key=lambda branch: branch["coherence"])
+    return {
+        "status": "offered",
+        "phase_samples": phase,
+        "cfo_hz": selected["cfo_hz"],
+        "branches": branches,
+    }
+
+
+def published_pss() -> np.ndarray:
+    bits = int("C1B5D191024D3DC3F8EC52FAA16F3958", 16)
+    increments = np.array([2 * ((bits >> i) & 1) - 1 for i in range(128)])
+    k = np.arange(-32, 1024)
+    phase = (k < 128) - 0.25 - np.cumsum(increments)[k % 128] / 2
+    native_rate = np.exp(np.pi * 1j * phase).astype(np.complex64)
+    return resample_poly(native_rate, 2, 1)
+
+
+def pss_markers(iq: np.ndarray) -> list[dict]:
+    pss = published_pss()
+    numerator = np.abs(fftconvolve(iq, pss[::-1].conj(), mode="valid")) ** 2
+    cumulative = np.r_[0.0, np.cumsum(np.abs(iq) ** 2, dtype=np.float64)]
+    energy = cumulative[len(pss) :] - cumulative[: -len(pss)]
+    denominator = energy * float(np.vdot(pss, pss).real)
+    coherence = np.divide(numerator, denominator, out=np.zeros_like(numerator), where=denominator > 0)
+    peaks, _ = find_peaks(coherence, height=PSS_GATE, distance=int(SOURCE_RATE / 750 / 2))
+    return [{"index": int(ind), "coherence": float(coherence[ind])} for ind in peaks]
+
+
+def bound_source(source: Path, directory: Path) -> tuple[np.ndarray, dict]:
+    metadata = json.loads((directory / "source.json").read_text())
+    protocol = json.loads((directory / "protocol-lock.json").read_text())
+    if digest(directory / "PROTOCOL.md") != protocol["protocol_sha256"]:
+        raise ValueError("changed frozen protocol")
+    if source.stat().st_size != metadata["received_bytes"] or metadata["received_bytes"] != 125e6:
+        raise ValueError("unexpected source range size")
+    count = 2 * LOOK * DECIMATE
+    if count != protocol["first_source_samples"]:
+        raise ValueError("changed frozen source sample budget")
+    iq = load_iq(source, count, metadata["range_sha256"])
+    return iq, metadata
+
+
+def predict(source: Path, out: Path, library: Path) -> None:
+    if (out / "prediction-lock.json").exists():
+        raise FileExistsError("use a fresh prediction directory")
+    if digest(library) != LIBRARY_SHA:
+        raise ValueError("expected the qualified stock wide detector")
+    iq, _ = bound_source(source, out)
+    prepared = {edge: template_bank(edge) for edge in CENTERS}
+    filter_taps = taps()
+    config = {
+        "inputs": {name: digest(out / name) for name in ("PROTOCOL.md", "source.json", "protocol-lock.json")},
+        "harness_sha256": digest(Path(__file__)),
+        "native_python_sha256": digest(Path(native.__file__)),
+        "template_python_sha256": digest(Path(templates.__file__)),
+        "native_library_sha256": LIBRARY_SHA,
+        "input_iq_sha256": sha256(iq.tobytes()).hexdigest(),
+        "templates_sha256": {
+            edge: {name: [sha256(x.tobytes()).hexdigest() for x in pair] for name, pair in bank.items()}
+            for edge, bank in prepared.items()
+        },
+        "fir_sha256": sha256(filter_taps.tobytes()).hexdigest(),
+        "python": sys.version.split()[0],
+        "numpy": np.__version__,
+        "scipy": scipy.__version__,
+        "affinity": sorted(os.sched_getaffinity(0)),
+        "native_support_samples": DWELL,
+        "measured_support_samples": LOOK,
+        "looks": list(LOOKS),
+        "modes": list(MODES),
+    }
+    write_json(out / "input-lock.json", config)
+    results, offers, transforms = [], {}, []
+    with ExitStack() as stack:
+        detectors = {
+            (edge, mode): stack.enter_context(
+                native.NativeShortWindow(
+                    str(library), *pair, sample_rate_hz=RATE, receiver_count=1, fractional_epoch=True
+                )
+            )
+            for edge, bank in prepared.items()
+            for mode, pair in bank.items()
+        }
+        for index, (look, raw) in enumerate(zip(LOOKS, np.split(iq, 2), strict=True)):
+            for side, (edge, center) in enumerate(CENTERS.items()):
+                rng = np.random.default_rng(SEED + 2 * index + side)
+                wall, cpu = perf_counter(), process_time()
+                main = edge_lane(raw, center, filter_taps)
+                gain = 4096 / float(np.sqrt(np.mean(np.abs(main) ** 2)))
+                signals = {
+                    "measured": (main, edge, "exact"),
+                    "cfo_shift": (mix(main, DIGITAL_SHIFT, RATE), edge, "exact"),
+                    "wrong_edge": (main, OPPOSITE[edge], "exact"),
+                    "permuted": (main, edge, "permuted"),
+                    "phase_null": (phase_null(main, rng), edge, "exact"),
+                    "interior": (edge_lane(raw, center - np.sign(center) * 10e6, filter_taps), edge, "exact"),
+                    "plant": (edge_lane(plant(look, edge, rng), center, filter_taps), edge, "exact"),
+                }
+                transforms.append({"look": look, "edge": edge, "wall_s": perf_counter() - wall, "cpu_s": process_time() - cpu})
+                for mode, (values, code_edge, code_mode) in signals.items():
+                    ci16, clip_count = quantize(values, gain)
+                    wall, cpu = perf_counter(), process_time()
+                    result = detectors[(code_edge, code_mode)].analyze(ci16, include_timings=True)
+                    results.append({
+                        "look": look,
+                        "edge": edge,
+                        "mode": mode,
+                        "gain": gain,
+                        "clipped_components": clip_count,
+                        "iq_sha256": sha256(ci16.tobytes()).hexdigest(),
+                        "wall_s": perf_counter() - wall,
+                        "cpu_s": process_time() - cpu,
+                        "native": result,
+                    })
+                    if look == "discovery" and mode == "measured":
+                        offers[edge] = discovery_offer(main, prepared[edge]["exact"][0], choose_endpoint(result))
+            if look == "discovery":
+                write_json(out / "discovery-offers.json", offers)
+    payload = "".join(json.dumps(row, sort_keys=True, allow_nan=False) + "\n" for row in results)
+    (out / "native.jsonl.gz").write_bytes(gzip.compress(payload.encode(), mtime=0))
+    write_json(out / "transform-timings.json", transforms)
+    names = ("input-lock.json", "discovery-offers.json", "native.jsonl.gz", "transform-timings.json")
+    write_json(out / "prediction-lock.json", {"files": {name: digest(out / name) for name in names}, "calls": len(results)})
+
+
+def matched_holdout(iq: np.ndarray, bank: dict, edge: str, offer: dict) -> list[dict]:
+    if offer["status"] != "offered":
+        return []
+    exact = bank[edge]["exact"][0]
+    frequency = offer["cfo_hz"]
+    phase = (offer["phase_samples"] - LOOK) % PERIOD
+    endpoint_cases = (
+        ("exact", 0, 0, exact),
+        ("time_sham", 1387, 0, exact),
+        ("cfo_sham", 0, 12345, exact),
+        ("wrong_edge", 0, 0, bank[OPPOSITE[edge]]["exact"][0]),
+        ("permuted", 0, 0, bank[edge]["permuted"][0]),
+    )
+    points = []
+    for epoch in np.arange(phase, len(iq), PERIOD):
+        if epoch + 1387 + 13288 + 1 > len(iq):
+            continue
+        for name, lag, shift, template in endpoint_cases:
+            points.append({
+                "edge": edge,
+                "epoch_samples": float(epoch),
+                "mode": name,
+                "coherence": score_frame(iq, template, epoch + lag, frequency + shift),
+            })
+    return points
+
+
+def score(source: Path, out: Path) -> None:
+    if (out / "score-lock.json").exists():
+        raise FileExistsError("use a fresh scoring directory")
+    prediction = json.loads((out / "prediction-lock.json").read_text())
+    validate_seal(out, prediction["files"])
+    inputs = json.loads((out / "input-lock.json").read_text())
+    validate_seal(out, inputs["inputs"])
+    if digest(Path(__file__)) != inputs["harness_sha256"]:
+        raise ValueError("scoring harness has changed since the native prediction seal")
+    iq, _ = bound_source(source, out)
+    if sha256(iq.tobytes()).hexdigest() != inputs["input_iq_sha256"]:
+        raise ValueError("decoded source_samples have changed")
+    offers = json.loads((out / "discovery-offers.json").read_text())
+    rows = [json.loads(line) for line in gzip.decompress((out / "native.jsonl.gz").read_bytes()).splitlines()]
+    if len(rows) != prediction["calls"]:
+        raise ValueError("prediction rows changed")
+    all_cases = {(row["look"], row["edge"], row["mode"]) for row in rows}
+    if all_cases != {(look, edge, mode) for look in LOOKS for edge in CENTERS for mode in MODES}:
+        raise ValueError("native cases are incomplete")
+    endpoints = {key: choose_endpoint(row["native"]) for key, row in zip(
+        [(r["look"], r["edge"], r["mode"]) for r in rows], rows, strict=True
+    )}
+    split = dict(zip(LOOKS, np.split(iq, 2), strict=True))
+    markers = {look: pss_markers(raw) for look, raw in split.items()}
+    packed = []
+    for row in rows:
+        look, edge, mode = row["look"], row["edge"], row["mode"]
+        winner = endpoints[(look, edge, mode)]
+        origin = endpoints[(look, edge, "measured")]
+        plant_truth = round(plant_phase_s(look) * SOURCE_RATE) / DECIMATE
+        guard = {
+            "look": look,
+            "edge": edge,
+            "mode": mode,
+            "native_candidates": row["native"]["rows"][0]["candidate_count"],
+            "native_glrt_calls": row["native"]["rows"][0]["actual_executed_glrt_calls"],
+            "native_main_cpu_ms": row["native"]["detector_cpu_ms"],
+            "wall_s": row["wall_s"],
+            "cpu_s": row["cpu_s"],
+            "clipped_components": row["clipped_components"],
+            "native_margin": winner.margin if winner else None,
+            "phase_samples": winner.phase_samples if winner else None,
+            "tracking_cfo_hz": winner.tracked_hz if winner else None,
+            "gate": bool(winner and winner.margin >= MARGIN_GATE),
+        }
+        if winner is not None:
+            pss_phase = markers[look][0]["index"] / DECIMATE if markers[look] else None
+            target_phase = plant_truth if mode == "plant" else pss_phase
+            if target_phase is not None:
+                guard["phase_error_samples"] = circular(winner.phase_samples - target_phase, PERIOD)
+            if mode == "plant":
+                guard["cfo_error_hz"] = circular(winner.tracked_hz - PLANT_CFO[edge], ALIAS)
+            if mode == "cfo_shift" and origin and origin.margin >= MARGIN_GATE:
+                guard["cfo_error_hz"] = circular(winner.tracked_hz - origin.tracked_hz - DIGITAL_SHIFT, ALIAS)
+        packed.append(guard)
+    bank = {edge: template_bank(edge) for edge in CENTERS}
+    held = []
+    for edge, center in CENTERS.items():
+        lane = edge_lane(split["held"], center, taps())
+        held.extend(matched_holdout(lane, bank, edge, offers[edge]))
+    medians = []
+    for (edge, mode), count in Counter((r["edge"], r["mode"]) for r in held).items():
+        values = [r["coherence"] for r in held if r["edge"] == edge and r["mode"] == mode]
+        medians.append({"edge": edge, "mode": mode, "coherence": float(np.median(values)), "count": count})
+    anticipation = {edge: offers[edge]["status"] for edge in CENTERS}
+    for edge in CENTERS:
+        values = {r["mode"]: r["coherence"] for r in medians if r["edge"] == edge}
+        if values:
+            highest = max(v for name, v in values.items() if name != "exact")
+            anticipation[edge] = "held_gate_passed" if values["exact"] >= HELD_RATIO * highest else "held_gate_failed"
+    result = {"native": packed, "pss": markers, "held": held, "held_medians": medians, "held_gates": anticipation}
+    write_json(out / "scores.json", result)
+    write_json(out / "score-lock.json", {name: digest(out / name) for name in ("prediction-lock.json", "scores.json")})
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=["predict", "score"])
+    parser.add_argument("source", type=Path)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--library", type=Path, default=LIBRARY)
+    arguments = parser.parse_args()
+    if arguments.action == "predict":
+        predict(arguments.source, arguments.out, arguments.library)
+    else:
+        score(arguments.source, arguments.out)
+
+
+if __name__ == "__main__":
+    main()
