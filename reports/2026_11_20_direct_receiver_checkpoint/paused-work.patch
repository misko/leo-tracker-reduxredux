@@ -0,0 +1,313 @@
+"""Compare the portable field ABI on sealed, resident stereo CI16 inputs."""
+
+import argparse
+import ctypes as ct
+import gzip
+import json
+import math
+import os
+import statistics
+import subprocess
+import sys
+from collections import Counter
+from hashlib import sha256
+from pathlib import Path
+from time import perf_counter_ns, process_time_ns
+from types import SimpleNamespace
+
+from .. import direct_kernels
+from ..variants import portable_field
+
+ROOT = direct_kernels.ROOT
+HELD = ROOT / "reports/2026_11_19_receiver_screening/original-schedule/verifier-integration"
+HELD_SHA = "c20332eac653646adef761d6e9c6d150e623a0e8fad5fc22de7261476fdc1f53"
+PROTOCOL = ROOT / "reports/2026_11_19_receiver_screening/direct-receiver/kernel/PROTOCOL.md"
+CPU = (8, 9)
+EXACT = ("epoch", "coarse_epoch", "seed_index", "flags")
+BOUNDS = {
+    "coarse_cfo": 1.0,
+    "coarse_score": 1e-5,
+    "acquired_cfo": 1.0,
+    "acquisition_score": 1e-5,
+    "integer_exact": 1e-5,
+    "integer_control": 1e-5,
+    "integer_residual": 1.0,
+    "fractional_offset": 2e-9,
+    "fractional_exact": 1e-5,
+    "fractional_control": 1e-5,
+    "fractional_residual": 1.0,
+}
+FLAGS = (
+    "integer_pass", "fractional_pass", "fractional_complete", "fine_guard",
+    "conditioned_tie", "glrt_bin_tie", "gate_guard", "equivalent_tie",
+)
+
+
+def checked(path, expected):
+    data = path.read_bytes()
+    if sha256(data).hexdigest() != expected.removeprefix("sha256:"):
+        raise ValueError(f"Input hash changed for {path}")
+    return data
+
+
+def write(path, obj):
+    path.write_text(json.dumps(obj, indent=2, sort_keys=True, allow_nan=False) + "\n")
+
+
+def freeze(work):
+    manifest = json.loads(checked(HELD / "manifest.json", HELD_SHA))["files"]
+    roster = json.loads(checked(HELD / "input-lock.json", manifest["input-lock.json"]))
+    items = []
+    for case, cfg in roster["cases"].items():
+        name = f"{case}/resident-lock.json"
+        resident = json.loads(checked(HELD / name, manifest[name]))
+        staged = {item["visit"]: item for item in resident["staged"]}
+        for choice in cfg["rows"]:
+            visit = choice["visit"]
+            item = staged[visit]
+            name = f"{case}/capture/{visit}.ci16.gz"
+            raw = gzip.decompress(checked(HELD / name, manifest[name]))
+            if len(raw) != 200_000 * 8 or sha256(raw).hexdigest() != item["iq_sha256"][7:]:
+                raise ValueError(f"Held CI16 bytes changed for {case}/{visit}")
+            dest = f"{case}-{visit}.ci16"
+            (work / dest).write_bytes(raw)
+            items.append(item | dict(
+                case=case, filename=dest, purpose=choice["kind"], producer=cfg["root"],
+            ))
+    lock = dict(protocol_sha256=sha256(PROTOCOL.read_bytes()).hexdigest(), input_sha256=HELD_SHA,
+                trials=items)
+    write(work / "inputs.json", lock)
+    return lock
+
+
+def load_library(path, edge):
+    return portable_field.Detector(path, edge)
+
+
+def groups_for(detector):
+    groups = [
+        dict(
+            lane=group.lane, anchors=group.anchors, count=group.count,
+            candidates=[
+                {
+                    name: getattr(c, name)
+                    if not name.startswith("fractional_") or c.flags & 4 else None
+                    for name in (*EXACT, *BOUNDS)
+                }
+                for c in group.candidates[:group.count]
+            ],
+        )
+        for group in detector.groups[:len(detector.attempts)]
+    ]
+    return groups
+
+
+def worker(work, binary, arm, output):
+    import numpy as np
+
+    start_wall, start_cpu = perf_counter_ns(), process_time_ns()
+    source = json.loads((work / "inputs.json").read_text())
+    rows = []
+    detectors = {}
+    try:
+        for item in source["trials"]:
+            raw = checked(work / item["filename"], item["iq_sha256"])
+            window = SimpleNamespace(
+                target=item["target"], acquisition=item["acquisition"],
+                sample_rate_hz=item["sample_rate_hz"],
+                samples=np.frombuffer(raw, dtype="<i2").reshape(200_000, 2, 2),
+            )
+            edge = item["target"]["edge"]
+            if edge not in detectors:
+                detectors[edge] = load_library(binary, edge)
+            detector = detectors[edge]
+            wall, cpu = perf_counter_ns(), process_time_ns()
+            output_packets = detector(window, (0, 1))
+            elapsed, used = perf_counter_ns() - wall, process_time_ns() - cpu
+            groups = groups_for(detector)
+            center = (
+                item["target"]["rf_center_hz"] - item["target"]["lnb_lo_hz"]
+                - item["acquisition"]["actual_if_center_hz"]
+            )
+            rows.append(dict(
+                case=item["case"], visit=item["visit"], purpose=item["purpose"],
+                iq_sha256=item["iq_sha256"], edge=edge, center_hz=center,
+                width_hz=min(800000, center + detector.minimum + 5e6,
+                             5e6 - center - detector.maximum),
+                wall_ns=elapsed, cpu_ns=used, groups=groups,
+                published=[attempt["published"] for attempt in detector.attempts],
+                lanes=[row.receiver_id for row in output_packets],
+                coarse_cpu_ns=sum(x["coarse_cpu_ns"] for x in detector.attempts),
+                verify_cpu_ns=sum(x["verify_cpu_ns"] for x in detector.attempts),
+                coarse_wall_ns=sum(x["coarse_wall_ns"] for x in detector.attempts),
+                verify_wall_ns=sum(x["verify_wall_ns"] for x in detector.attempts),
+            ))
+        quiet = np.zeros((200_000, 2, 2), dtype="<i2")
+        controls = {}
+        for edge, detector in detectors.items():
+            lib, groups = detector.library, detector.groups
+            controls[edge] = [
+                lib.portable_field_detect(detector.context, quiet.ctypes.data, 0, 800000, groups),
+                [[g.lane, g.anchors, g.count] for g in groups],
+                lib.portable_field_detect(detector.context, None, 0, 800000, groups),
+                lib.portable_field_detect(detector.context, quiet.ctypes.data, math.nan, 800000, groups),
+                lib.portable_field_detect(detector.context, quiet.ctypes.data, 0, 0, groups),
+            ]
+            if controls[edge] != [2, [[0, 12, 0], [1, 12, 0], [0, 0, 0]], -1, -1, -1]:
+                raise ValueError(f"Null or invalid stereo control failed for {edge}")
+        workspace = {edge: detector.workspace_bytes for edge, detector in detectors.items()}
+    finally:
+        for detector in detectors.values():
+            detector.__exit__()
+    peak = next(line for line in Path("/proc/self/status").read_text().splitlines()
+                if line.startswith("VmHWM:"))
+    write(output, dict(
+        arm=arm, cpu=os.sched_getaffinity(0).pop(), rows=rows, controls=controls,
+        abi_group_bytes=ct.sizeof(portable_field.Group), workspace_bytes=workspace,
+        process_cpu_ns=process_time_ns() - start_cpu, elapsed_ns=perf_counter_ns() - start_wall,
+        vm_hwm_kib=int(peak.split()[1]),
+    ))
+
+
+def compare(before, after, *, exact=False):
+    if (before["controls"], before["abi_group_bytes"]) != (
+        after["controls"], after["abi_group_bytes"]
+    ):
+        raise ValueError("Null/invalid controls or field ABI changed")
+    counts, max_abs, by_case = Counter(), Counter(), {}
+    for a, b in zip(before["rows"], after["rows"], strict=True):
+        keys = ("case", "visit", "iq_sha256", "edge", "center_hz", "width_hz", "published", "lanes")
+        if any(a[k] != b[k] for k in keys):
+            raise ValueError(f"Case/visit/publication inventory changed for {a['case']}/{a['visit']}")
+        case = by_case.setdefault(a["case"], Counter())
+        case["visits"] += 1
+        case["peer_retries"] += len(a["groups"]) == 3
+        if a["lanes"] != [0, 1]:
+            raise ValueError("The wrapper changed physical lane order")
+        for x, y in zip(a["groups"], b["groups"], strict=True):
+            if any(x[key] != y[key] for key in ("lane", "anchors", "count")):
+                raise ValueError(f"Lane/anchor/count changed for {a['case']}/{a['visit']}")
+            case["groups"] += 1
+            for rank, (p, q) in enumerate(zip(x["candidates"], y["candidates"], strict=True)):
+                detail = f"{a['case']}/{a['visit']}/lane{x['lane']}/rank{rank}"
+                if any(p[k] != q[k] for k in EXACT):
+                    raise ValueError(f"Candidate epoch/rank/gate/tie changed at {detail}: {p} / {q}")
+                counts["candidates"] += 1
+                counts["different_numeric_records"] += p != q
+                case["candidates"] += 1
+                for bit, label in enumerate(FLAGS):
+                    counts[label] += bool(p["flags"] & (1 << bit))
+                    case[label] += bool(p["flags"] & (1 << bit))
+                counts["unbracketed"] += p["fractional_exact"] is None
+                for field, bound in BOUNDS.items():
+                    if p[field] is None and q[field] is None:
+                        continue
+                    if p[field] is None or q[field] is None:
+                        raise ValueError(f"Candidate null changed at {detail}/{field}")
+                    delta = abs(p[field] - q[field])
+                    if not math.isfinite(delta) or delta > (0 if exact else bound):
+                        raise ValueError(f"Field value changed at {detail}/{field}: {delta}")
+                    max_abs[field] = max(max_abs[field], delta)
+    return dict(total=dict(counts), maxima=dict(max_abs), by_case=by_case)
+
+
+def launch(work, binary, arm, cpu, output, scratch):
+    subprocess.run(
+        ["taskset", "-c", str(cpu), sys.executable, "-m", __spec__.name, str(work),
+         "--worker", str(binary), "--arm", arm, "--child-output", str(output)],
+        env=os.environ | {"TMPDIR": str(scratch), "OPENBLAS_NUM_THREADS": "1",
+                          "OMP_NUM_THREADS": "1", "MKL_NUM_THREADS": "1"},
+        check=True, timeout=60,
+    )
+    return json.loads(output.read_text())
+
+
+def binary_info(path):
+    sections = {}
+    for line in subprocess.check_output(["size", "-A", path], text=True).splitlines():
+        words = line.split()
+        if len(words) == 3 and words[0] in {".text", ".rodata", ".data", ".bss"}:
+            sections[words[0]] = int(words[1])
+    dynamic = subprocess.check_output(["readelf", "-d", path], text=True).splitlines()
+    return dict(
+        sections=sections, dynamic_dependencies=[x.split("[")[1].split("]")[0] for x in dynamic
+                                                 if "(NEEDED)" in x],
+    )
+
+
+def measure(work, stock, repeats, rebuilt=None):
+    scratch = work / "tmp"
+    scratch.mkdir()
+    (work / "direct").mkdir()
+    lock = freeze(work)
+    stock_receipt = json.loads(stock.read_text())
+    stock_binary = Path(stock_receipt["binary"]["path"])
+    checked(stock_binary, stock_receipt["binary"]["sha256"])
+    direct_receipt = direct_kernels.build(work / "direct")
+    direct_binary = Path(direct_receipt["binary"]["path"])
+    if direct_receipt["tool"] != stock_receipt["tool"]:
+        raise ValueError("The frozen control and direct detector require the same compiler")
+    timings, initial = [], {}
+    load_start = Path("/proc/loadavg").read_text().strip()
+    for repeat in range(repeats):
+        pair = {}
+        cpu = CPU[repeat % 2]
+        order = ("stock", "direct") if (repeat // 2 + repeat % 2) % 2 == 0 else ("direct", "stock")
+        for index, arm in enumerate(order):
+            binary = stock_binary if arm == "stock" else direct_binary
+            result = launch(work, binary, arm, cpu, work / f"{repeat}-{arm}.json", scratch)
+            pair[arm] = result
+            if arm in initial:
+                compare(initial[arm], result, exact=True)
+            else:
+                initial[arm] = result
+            clocks = {k: v for k, v in result.items() if k not in {"rows", "controls"}}
+            for field in ("cpu_ns", "wall_ns", "coarse_cpu_ns", "verify_cpu_ns"):
+                clocks[field] = sum(row[field] for row in result["rows"])
+            timings.append(clocks | dict(repeat=repeat, order=index))
+        parity = compare(pair["stock"], pair["direct"])
+        print(f"Pair {repeat + 1}/{repeats}, CPU {cpu}: {parity['total']['candidates']} candidates",
+              flush=True)
+    default_parity = None
+    if rebuilt:
+        result = launch(work, rebuilt, "rebuilt", CPU[0], work / "rebuilt.json", scratch)
+        default_parity = compare(initial["stock"], result, exact=True)
+    paired = {}
+    for field in ("cpu_ns", "wall_ns", "coarse_cpu_ns", "verify_cpu_ns",
+                  "process_cpu_ns", "elapsed_ns", "vm_hwm_kib"):
+        arms = {arm: [row[field] for row in timings if row["arm"] == arm]
+                for arm in ("stock", "direct")}
+        ratio = [b / a for a, b in zip(arms["stock"], arms["direct"], strict=True)]
+        paired[field] = dict(
+            median_ratio=statistics.median(ratio), range_ratio=[min(ratio), max(ratio)],
+            arm_medians={arm: statistics.median(vals) for arm, vals in arms.items()},
+        )
+    return dict(
+        inputs=lock, stock=stock_receipt | binary_info(stock_binary),
+        direct=direct_receipt | binary_info(direct_binary), parity=parity, timings=timings,
+        paired=paired, default_rebuild_parity=default_parity, cpu_roster=CPU,
+        load_start=load_start, load_end=Path("/proc/loadavg").read_text().strip(),
+        programs={str(path.relative_to(ROOT)): sha256(path.read_bytes()).hexdigest()
+                  for path in (Path(__file__), Path(direct_kernels.__file__),
+                               Path(portable_field.__file__), PROTOCOL)},
+    )
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("work", type=Path)
+    parser.add_argument("--control", type=Path)
+    parser.add_argument("--rebuilt", type=Path)
+    parser.add_argument("--repeats", type=int, default=6)
+    parser.add_argument("--worker", type=Path)
+    parser.add_argument("--arm")
+    parser.add_argument("--child-output", type=Path)
+    args = parser.parse_args()
+    work = args.work.resolve()
+    if args.worker:
+        worker(work, args.worker, args.arm, args.child_output)
+    else:
+        if args.control is None or args.repeats < 1:
+            parser.error("Provide a frozen control build receipt and one or more pairs")
+        work.mkdir(parents=True)
+        write(work / "qualification.json", measure(work, args.control, args.repeats, args.rebuilt))
