+        or terminal["exit_code"] != 0
+        or terminal["log_sha256"] != _sha(directory / "service.log")
+        or plan["source_lock_sha256"] != seal["files"]["source-lock.json"]
+        or plan["receiver"] != lock["receiver"]
+    ):
+        raise ValueError("archived compact fit does not bind the full signed original factors")
+    return (
+        read(native),
+        pred | {"method": controls.ARCHIVE, "archived_native_sha256": asset["sha256"]},
+        dict(
+            receiver=lock["receiver"],
+            receiver_files=lock["receiver_files"],
+            terminal=terminal,
+            plan=plan,
+            raw=raw,
+            end=read(directory / "end.json"),
+            position_sha256=_sha(directory / "position.json"),
+        ),
+    )
+
+
+def verify_plan(lock, summary, roster, expected, backend):
+    if (
+        lock["case"] != roster["case"]
+        or lock["recording"] != roster["case"]["recording"]
+        or lock["id"] != roster["case"]["id"]
+        or lock["smoke"]
+        or lock["capture"] != roster["capture"]
+        or lock["producer"] != roster["producer"]
+        or lock["workers"] != roster["workers"]
+        or lock["cpus"] != CPUS
+        or (lock["raw_limit_s"], lock["position_limit_s"]) != (600, 180)
+        or lock["receiver"] != expected["receiver"]
+        or lock["receiver_files"] != expected["receiver_files"]
+        or lock["detector"]["backend"] != backend
+        or (summary["id"], summary["mode"]) != (roster["case"]["id"], "full")
+    ):
+        raise ValueError("run differs from the prespecified full receiver protocol")
+
+
+def matched_changes(probes, controls, changes):
+    fresh, reference = ({native_parity.key(p): p for p in rows} for rows in (probes, controls))
+    first, substantive = None, None
+    for row in changes:
+        key = tuple(row["probe"])
+        left, right = fresh[key], reference[key]
+        x, y = (list(r["candidates"]) for r in (left, right))
+        gates = [tuple(c["passed_fractional_margin_gate"] for c in side) for side in (x, y)]
+        decision = (
+            gates[0] != gates[1]
+            or len(row["matched_physical_indices"]) != len(x)
+            or len(x) != len(y)
+            or row["moved_rank_count"] != 0
+            or row["reordered_pairs"] != 0
+            or bool(row["physical_fields"])
+        )
+        audit = dict(change=row, measured=left, reference=right, gate_sequence_changed=gates[0] != gates[1])
+        if first is None:
+            first = audit
+        if decision:
+            substantive = audit
+            break
+    return dict(first_changed=first, first_support_rank_or_gate_change=substantive)
+
+
+def comparison(native, visits, other, reference_visits=()):
+    proof, differences, ambiguous = portable_field_parity.compare(native, visits, other)
+    audit = matched_changes(
+        [p for v in visits for p in v["probes"]], other["source"]["probes"], differences
+    )
+    visits_by_id = [{r["visit"]: r for r in rows} for rows in (visits, reference_visits)]
+    for row in audit.values():
+        if row is not None:
+            visit, lane, *_ = row["change"]["probe"]
+            row["portable_groups_by_side"] = [
+                [g for g in rows.get(visit, {}).get("portable_groups", ()) if g["lane"] == lane]
+                for rows in visits_by_id
+            ]
+    return dict(parity=proof, audit=audit), differences, ambiguous
+
+
+def run_evidence(work, mode, roster, archive_fit, request):
+    paths = {
+        name: work.parent / f"{mode}{suffix}"
+        for name, suffix in (
+            ("time", ".time"), ("exit", ".exit"), ("stdout", ".stdout"), ("stderr", ".stderr"),
+            ("host-before.txt", "-host-before.txt"), ("host-after.txt", "-host-after.txt"),
+            ("argv.txt", "-argv.txt"),
+        )
+    }
+    evidence = dict(paths={key: _sha(path) for key, path in paths.items()})
+    seal = work / "run-seal.json"
+    if not seal.exists():
+        status = int(paths["exit"].read_text())
+        if status == 0:
+            raise ValueError("successful command did not leave a sealed result")
+        result = checks.unavailable("public command failed before producing a terminal seal", "failed")
+        return result, evidence | dict(stage="unsealed", exit_code=status), {}, None, [], []
+    files = read(seal)["files"]
+    checks.checked_files(work, files, checks.RUN_KEYS)
+    lock, summary = (read(work / name) for name in checks.RUN_KEYS)
+    verify_plan(lock, summary, roster, archive_fit, MODES[mode])
+    receiver.configure(work)
+    if receiver.receiver_assets(Path(lock["receiver"])) != lock["receiver_files"]:
+        raise ValueError("compact position receiver differs from its launch")
+    evidence.update(
+        stage=summary["stage"], run_seal_sha256=_sha(seal),
+        command=portable_command.clock(paths["time"], summary["command_wall_s"]),
+        detector=lock["detector"], source_lock_sha256=files["source-lock.json"],
+    )
+    if evidence["command"]["exit_code"] != int(paths["exit"].read_text()):
+        raise ValueError("external and shell terminal receipts disagree")
+    raw, visits, samples = checks.raw_state(work, lock, summary, files)
+    native = None
+    native_sha = summary.get("native_sha256")
+    if native_sha is not None:
+        if not raw["complete"] or files.get("native.json") != native_sha.removeprefix("sha256:"):
+            raise ValueError("native handoff requires a complete authenticated recording")
+        native = read(work / "native.json")
+        if native["provenance"]["detector_sha256"] != receiver.recording.digest(lock["detector"]):
+            raise ValueError("fresh factors do not bind the executed detector")
+    result, fit = checks.position_record(work, lock, summary, files, request, native_sha, raw["complete"])
+    _, attempts = checks.collect_attempts(visits)
+    evidence.update(raw=raw, fit=fit, native_sha256=native_sha, attempts=attempts, summary_status=summary["status"])
+    return result, evidence, paths, native, visits, samples
+
+
+def seal(scratch, output):
+    protocol = whole_iq.checked(output / "PROTOCOL.md", PROTOCOL_SHA)
+    if (output / "prediction-lock.json").exists():
+        raise FileExistsError("the prediction comparison is already sealed")
+    if (scratch / "protocol.sha256").read_text().split()[0] != PROTOCOL_SHA:
+        raise ValueError("run protocol differs from its prelaunch binding")
+    case = _load_case(CASE)
+    capture = capture_release.read_capture(case)
+    producer = capture_release.producer(case, capture)
+    request, causal = checks.causal_authority(case)
+    signed_chunks = receiver.chunks(case)
+    if (capture["edge"], case["recording"]["window_count"], len(signed_chunks)) != ("upper", 6772, 106):
+        raise ValueError("the signed case differs from the prespecified capture")
+    capture["case"] = {key: case[key] for key in ("id", "session_id", "run_id")}
+    roster = dict(case=case, capture=capture, producer=str(producer.root), workers=[
+        [cpu, count, list(map(list, chunks))]
+        for cpu, count, chunks in checks.capture.trial.partition(signed_chunks, frozenset(), CPUS)
+    ])
+    archived, archive_pred, archive_fit = archive(case, request)
+    evidence = dict(cpus=CPUS, causal=causal, archive=archive_fit, signed_case=case,
+                    recorded_delivery_span_s=(archived["delivery_clocks"][-1]["monotonic_ns"]
+                    - archived["delivery_clocks"][0]["monotonic_ns"]) / 1e9)
+    rows, runs, proofs, native_by_mode, visits_by_mode = [], {}, {}, {}, {}
+    paths = [protocol.name]
+    for mode in MODES:
+        work = scratch / mode
+        result, runs[mode], external, native, visits, samples = run_evidence(
+            work, mode, roster, archive_fit, request
+        )
+        rows.append(archive_pred | dict(method=mode, result=result, native_sha256=runs[mode].get("native_sha256")))
+        native_by_mode[mode], visits_by_mode[mode] = native, visits
+        proofs[mode], differences, ambiguous = comparison(native, visits, archived)
+        for label, values in (("differences", differences), ("ambiguous", ambiguous)):
+            name = f"{mode}-archive-{label}.jsonl.gz"
+            pack(output, name, values)
+            paths.append(name)
+        name = f"{mode}-visits.csv"
+        if samples:
+            csv_file(output / name, samples)
+            paths.append(name)
+        for name in (*checks.RUN_KEYS, "run-seal.json"):
+            if (work / name).is_file():
+                external[name] = work / name
+        for name, source in external.items():
+            target = f"{mode}-{name}"
+            write(output / target, source.read_bytes())
+            paths.append(target)
+    if native_by_mode["incumbent"] is not None:
+        proofs["paired"], differences, ambiguous = comparison(
+            native_by_mode["compact"], visits_by_mode["compact"], native_by_mode["incumbent"],
+            visits_by_mode["incumbent"],
+        )
+        for label, values in (("differences", differences), ("ambiguous", ambiguous)):
+            name = f"paired-{label}.jsonl.gz"
+            pack(output, name, values)
+            paths.append(name)
+    rows.append(archive_pred)
+    evidence.update(runs=runs, archive_position_comparison=controls.compare_positions(rows))
+    save_json(output / "evidence.json", evidence)
+    save_json(output / "native-parity.json", proofs)
+    pack(output, POSITION, rows)
+    paths += ["evidence.json", "native-parity.json", POSITION]
+    for name in ("incumbent-preflight.log", "protocol.sha256"):
+        write(output / name, (scratch / name).read_bytes())
+        paths.append(name)
+    save_json(output / "prediction-lock.json", dict(
+        cases=[CASE], files={name: _sha(output / name) for name in paths}, scratch=str(scratch),
+        archive_prediction_sha256=ARCHIVE_SEAL, original_v5_sources=portable_command.v5_sources(case),
+        scoring_sources={str(Path(m.__file__)): _sha(Path(m.__file__)) for m in (
+            checks, controls, native_parity, portable_command, portable_field_parity
+        )} | {str(Path(__file__)): _sha(Path(__file__))},
+    ))
+
+
+def score(output):
+    from . import direct_field_report as report
+
+    prediction = read(output / "prediction-lock.json")
+    checks.checked_files(output, prediction["files"], (POSITION, "evidence.json", "native-parity.json"))
+    if prediction["cases"] != [CASE] or prediction["files"].get("PROTOCOL.md") != PROTOCOL_SHA:
+        raise ValueError("prediction seal differs from its scoped protocol")
+    for group in ("scoring_sources", "original_v5_sources"):
+        for path, digest in prediction[group].items():
+            whole_iq.checked(Path(path), digest)
+    with gzip.open(output / POSITION, "rt") as stream:
+        positions = list(map(json.loads, stream))
+    if [row["method"] for row in positions] != list(METHODS):
+        raise ValueError("prediction seal must retain each scheduled receiver outcome")
+    _, (reference,) = held_references(None, [CASE])
+    case = _load_case(CASE)
+    with patch.object(controls, "V5_ARCHIVE", portable_command.v5_directory(case).parent):
+        v5, receipts = controls.original_v5_scores(case, reference)
+    rows = portable_command.position_scores(positions, reference["truth"]) + v5
+    quality = {}
+    for mode in MODES:
+        quality[mode] = checks.accuracy([
+            row | {"method": checks.PORTABLE if row["method"] == mode else row["method"]}
+            for row in rows if row["method"] in (mode, controls.ARCHIVE, *ROLES)
+        ])
+    for pos in positions:
+        arms = pos["result"]["arms"]
+        for quality_run in quality.values():
+            key = checks.PORTABLE if pos["method"] in MODES else pos["method"]
+            if pos["method"] in MODES and quality_run is not quality[pos["method"]]:
+                continue
+            quality_run["fitted_c_minus_c0"][key]["endpoint_separation_km"] = distance_km(
+                *(arms[arm]["latlon"] for arm in ARMS)
+            )
+    csv_file(output / "scores.csv", rows)
+    save_json(output / "scores.json", quality)
+    save_json(output / "original-v5-receipts.json", receipts)
+    names = report.publish(output, rows, quality)
+    save_json(output / "score-lock.json", dict(cases=[CASE], files=prediction["files"] | {
+        name: _sha(output / name) for name in (
+            "prediction-lock.json", "original-v5-receipts.json", "scores.csv", "scores.json", *names
+        )
+    }))
+    report.generate(output / "charts", evidence=output)
+    save_json(output / "report-seal.json", dict(files={
+        path.relative_to(output).as_posix(): _sha(path)
+        for path in sorted(output.rglob("*")) if path.is_file() and path.name != "report-seal.json"
+    }))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=local_output, default=OUT)
+    action = parser.add_subparsers(dest="action", required=True)
+    action.add_parser("seal").add_argument("--scratch", type=local_output, required=True)
+    action.add_parser("score")
+    args = parser.parse_args()
+    if args.action == "seal":
+        seal(args.scratch, args.out)
+    else:
+        score(args.out)
diff --git a/tools/pipeline_eval/qualification/direct_kernel_trial.py b/tools/pipeline_eval/qualification/direct_kernel_trial.py
