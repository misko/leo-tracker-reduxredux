    "unknown_data": "absent; these are pilot-only proposal controls, not full Starlink downlink simulations",
    "quantization": "round real and imaginary independently, clip to signed CI16"
  },
  "interpretation": {
    "truth_scope": "constructed proposal hypotheses only",
    "expected_proposal_present": "true/false/null is a construction category, not a required detector decision",
    "ambiguity": "single means one pilot hypothesis; either means either listed pilot is acceptable; invalid means no unique pilot identity is required",
